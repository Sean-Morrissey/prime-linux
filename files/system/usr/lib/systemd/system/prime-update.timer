[Unit]
Description=Prime — unattended system update cycle (every 3 days)
Documentation=file:/usr/share/doc/prime/UPDATES.md
# Nothing here needs a human, and nothing here may be skipped because the machine
# happened to be off when the timer last came due: Persistent=true means a missed
# run happens shortly after the next boot instead of being forgotten.
After=network-online.target prime-firstboot.service
Wants=network-online.target
ConditionPathExists=!/etc/prime/updates-disabled

[Timer]
OnBootSec=15min
OnUnitActiveSec=3d
Persistent=true
RandomizedDelaySec=20min
AccuracySec=1min

[Install]
WantedBy=timers.target
