#!/usr/bin/env bash
# prime-ai-setup — connect the assistant to a model (run by `prime-addon enable ai`).
#
# Works with anything that speaks the OpenAI chat API: llama-server or Ollama on
# this computer or another one on your network, OpenRouter, OpenAI, Groq… The
# key (if the service needs one) is stored in ~/.config/prime/ai.key, readable
# only by you, and is never put in a config file or sent anywhere else.
set -u
CONF="$HOME/.config/prime/ai.conf"; KEY="$HOME/.config/prime/ai.key"
HERE="$(dirname "$(readlink -f "$0")")"
mkdir -p "$(dirname "$CONF")"
B=$'\e[1m'; D=$'\e[2m'; R=$'\e[0m'

echo
echo "${B}Where should Prime's answers come from?${R}"
echo "  1) A model on this computer   (llama-server or Ollama — private, free)"
echo "  2) A model on another computer on my network"
echo "  3) OpenRouter                 (many models, needs an API key)"
echo "  4) OpenAI                     (needs an API key)"
echo "  5) Something else that speaks the OpenAI API"
read -rp "Pick 1-5: " choice
case "$choice" in
    1) url="http://localhost:8080/v1"
       curl -fs -m 2 http://localhost:11434/v1/models >/dev/null 2>&1 && url="http://localhost:11434/v1"
       read -rp "Address [$url]: " u; url="${u:-$url}"; needkey=0 ;;
    2) read -rp "Address (e.g. http://192.168.1.50:8080/v1): " url; needkey=0 ;;
    3) url="https://openrouter.ai/api/v1"; needkey=1 ;;
    4) url="https://api.openai.com/v1"; needkey=1 ;;
    5) read -rp "Base URL (ends in /v1): " url; read -rp "Does it need an API key? [y/N] " k; [ "${k,,}" = y ] && needkey=1 || needkey=0 ;;
    *) echo "Cancelled."; exit 1 ;;
esac
[ -n "$url" ] || { echo "No address given."; exit 1; }

if [ "$needkey" = 1 ]; then
    read -rsp "API key (hidden while you type): " key; echo
    [ -n "$key" ] || { echo "No key given."; exit 1; }
    ( umask 077; printf '%s' "$key" > "$KEY" )
else
    rm -f "$KEY"
fi

# offer the models the endpoint lists
auth=(); [ -f "$KEY" ] && auth=(-H "Authorization: Bearer $(cat "$KEY")")
models="$(curl -fs -m 8 "${auth[@]}" "${url%/}/models" 2>/dev/null | jq -r '.data[].id' 2>/dev/null | head -40)"
if [ -n "$models" ]; then
    echo; echo "${B}Models available there:${R}"; nl -w3 -s') ' <<<"$models"
    read -rp "Pick a number, or type a model name: " m
    if [[ "$m" =~ ^[0-9]+$ ]]; then model="$(sed -n "${m}p" <<<"$models")"; else model="$m"; fi
else
    echo "${D}(couldn't list models there — is it running?)${R}"
    read -rp "Model name: " model
fi

printf '# Prime assistant — change with: prime-addon enable ai\nBASE_URL=%s\nMODEL=%s\n' "$url" "$model" > "$CONF"
echo; printf 'Testing… '
if "$HERE/prime-ask" --test; then
    echo "${B}Ready.${R} Super+Shift+Space asks Prime; Spotlight and right-click menus can ask too."
else
    echo "Saved, but the test failed — make sure the model is running, then try: prime-ask --test"
fi
exit 0
