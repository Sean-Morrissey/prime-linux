{
  "sections": [
    {
      "id": "prime", "label": "Ask Prime", "icon": "󰚩",
      "items": [
        {"id": "ai.ask", "label": "Ask Prime anything…", "hint": "Super+Shift+Space", "kind": "run", "cmd": "exec ~/.local/share/prime-linux/layer/addons/ai/bin/prime-ask --box"},
        {"id": "ai.tutor", "label": "Prime Tutor — learn step by step", "hint": "teaches, doesn't do your homework", "kind": "run", "cmd": "exec ~/.local/share/prime-linux/layer/addons/ai/bin/prime-ask --tutor --box"},
        {"id": "ai.snip", "label": "Snip the screen and ask", "hint": "Super+Alt+A", "kind": "run", "cmd": "exec ~/.local/share/prime-linux/layer/bin/prime-snip area --action 'Ask Prime'"},
        {"id": "ai.last", "label": "Last answer", "kind": "run", "cmd": "exec ~/.local/share/prime-linux/layer/addons/ai/bin/prime-ask --last"},
        {"id": "ai.new", "label": "Start a new conversation", "kind": "run", "cmd": "rm -f ~/.cache/prime/conversation.json ~/.cache/prime/tutor.json && notify-send -a Prime 'New conversation'"},
        {"id": "ai.undo", "label": "Undo Prime's last change", "kind": "term", "cmd": "~/.local/share/prime-linux/layer/bin/prime-settings undo"},
        {"id": "ai.log", "label": "What Prime changed", "hint": "every change, in plain words", "kind": "term", "cmd": "~/.local/share/prime-linux/layer/bin/prime-settings log"},
        {"id": "ai.setup", "label": "Change the model", "hint": "local, network, OpenRouter, OpenAI…", "kind": "run", "cmd": "exec ~/.local/share/prime-linux/layer/addons/ai/bin/prime-ai-setup"}
      ]
    }
  ]
}
