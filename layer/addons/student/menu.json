{
  "sections": [
    {
      "id": "student", "label": "Study", "icon": "󰑴",
      "items": [
        {"id": "study.focus", "label": "Focus mode on/off", "hint": "Super+Alt+F · 25 min, notifications paused", "kind": "run", "cmd": "exec ~/.local/share/prime-linux/layer/addons/student/bin/prime-student focus toggle"},
        {"id": "study.notes", "label": "Notes", "hint": "Super+Alt+N · Obsidian, in ~/Study/Notes", "kind": "run", "cmd": "exec ~/.local/share/prime-linux/layer/bin/prime-addon open obsidian"},
        {"id": "study.tutor", "label": "Ask the tutor", "hint": "Super+Alt+T · explains step by step (AI add-on)", "kind": "run", "cmd": "exec ~/.local/share/prime-linux/layer/addons/student/bin/prime-student tutor"},
        {"id": "study.writer", "label": "Write a document", "hint": "LibreOffice Writer", "kind": "run", "cmd": "exec ~/.local/share/prime-linux/layer/bin/prime-addon open libreoffice --writer"},
        {"id": "study.pdf", "label": "Annotate a PDF or handwrite", "hint": "Xournal++ · File → Annotate PDF", "kind": "run", "cmd": "exec ~/.local/share/prime-linux/layer/bin/prime-addon open xournalpp"},
        {"id": "study.zotero", "label": "Citations", "hint": "Zotero — collect sources, cite in Writer", "kind": "run", "cmd": "exec ~/.local/share/prime-linux/layer/bin/prime-addon open 'zotero|org.zotero.Zotero'"},
        {"id": "study.pdfarrange", "label": "Merge or split PDFs", "hint": "PDF Arranger", "kind": "run", "cmd": "exec ~/.local/share/prime-linux/layer/bin/prime-addon open pdfarranger"},
        {"id": "study.folder", "label": "Study folder", "kind": "run", "cmd": "exec nemo ~/Study"},
        {"id": "study.check", "label": "Check my study setup", "kind": "term", "cmd": "~/.local/share/prime-linux/layer/bin/prime-addon check student"}
      ]
    }
  ]
}
