#!/usr/bin/python3
# prime:summary=hardware, display, gaming and performance control centre
"""prime-control — hardware & performance control centre for Prime Linux.

A dark GTK3 settings window (macOS-style sidebar + cards) that shows live
CPU / GPU / RAM / storage / display / gaming state and lets you apply the
changes that are safe to apply through the system's own tools
(powerprofilesctl, cpupower via pkexec, lact / lactd, nwg-displays).
Every external command is wrapped in a timeout + try/except, and every
optional tool degrades to a labelled read-only row when it is missing.

Nothing here writes to sysfs directly, and nothing is written globally.
"""
import json
import os
import platform
import re
import subprocess
import sys
import threading
import time

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, Gio, GLib, Gtk, Pango  # noqa: E402

