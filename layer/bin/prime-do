#!/usr/bin/python3
"""prime-do — say what you want in plain words; Prime does it. No AI involved.

"wifi off", "louder", "mute", "do not disturb", "bigger text", "accent blue",
"mouse settings", "take a screenshot", "something's wrong", "get a file back"…
A fixed list of things Prime knows how to do, matched by their words, run at
once. It is what Prime Search's "Do it" rows and the Ask box use first, so the
everyday requests work the same with or without the AI pack, offline, instantly,
and always the same way. Anything it doesn't know goes to the assistant (if you
have it) or the web.

  prime-do "wifi off"              do it (prints the one-line result)
  prime-do --match "wifi off"      what it would do, best first: id<TAB>title<TAB>score
  prime-do --id wifi-off           do one by its id (what Prime Search runs)
  prime-do --list                  everything it knows, one per line
  PRIME_DO_DRY=1                   print the command instead of running it (tests)

A score of 1.0 means every word you typed was understood; Prime Search makes that
the Top Hit and the Ask box runs it without asking the model. Things that can't
be undone with one click (restart, shut down) only ever open the power menu.
"""
from __future__ import annotations

import os
import re
import shutil
import subprocess
import sys

BIN = os.path.dirname(os.path.realpath(__file__))
LAYER = os.path.realpath(os.path.join(BIN, ".."))
HOME = os.path.expanduser("~")

# words that carry no meaning in a request ("could you please turn the wifi off")
FILLER = set("""please pls can could would you will i i'd id want wanna to the my a an me it this that
    turn switch set make put go get be is are now just for of up down some bit little lot more
    hey prime ok okay thanks thank and with on off take last mode something something's somethings
    there's theres what's whats seems seem""".split()) - {"up", "down", "on", "off", "more"}
# words that only say "the settings for…": understood, but never enough on their own
SOFT = {"settings", "setting", "preferences", "options", "open", "change", "show", "info", "speed",
        "sensitivity", "size", "page"}

ON = {"on", "enable", "start", "activate", "allow"}
OFF = {"off", "disable", "stop", "deactivate", "block", "kill"}
UP = {"up", "louder", "higher", "increase", "raise", "more", "brighter"}
DOWN = {"down", "quieter", "lower", "decrease", "reduce", "less", "dimmer", "softer"}

ACCENT_WORDS = {"red": "f87171", "rose": "f87171", "pink": "f87171", "orange": "fb923c", "ember": "fb923c",
                "yellow": "fbbf24", "amber": "fbbf24", "gold": "fbbf24", "green": "34d399", "emerald": "34d399",
                "teal": "2dd4bf", "cyan": "2dd4bf", "turquoise": "2dd4bf", "blue": "60a5fa", "sapphire": "60a5fa",
                "purple": "c084fc", "violet": "c084fc", "amethyst": "c084fc", "lilac": "c084fc",
                "grey": "d4d4d8", "gray": "d4d4d8", "silver": "d4d4d8", "white": "d4d4d8"}


def B(name: str) -> str:
    return os.path.join(BIN, name)


def tb(setting: str, value) -> list:
    import json
    return [B("prime-settings"), "run", "change_setting", json.dumps({"setting": setting, "value": value})]


