for pid, words in PAGE_WORDS.items():
    INTENTS.append((f"page-{pid}", f"Settings → {PAGE_TITLES[pid]}", [words],
                    set(), [B("prime-system-settings"), "--page", pid], ""))

BY_ID = {i[0]: i for i in INTENTS}

# "remind me to call mum at 5pm", "remind me at 5 to call mum", "remind me in 20 minutes to …":
# the words are kept, so the action's id carries them (remind:<what>|<when>)
WHEN_START = r"(?:in|at|on|by|tomorrow|today|tonight|monday|tuesday|wednesday|thursday|friday|saturday|sunday|mon|tue|tues|wed|thu|thurs|fri|sat|sun|\d)"
REMIND = [re.compile(r"^\s*(?:please\s+)?remind me\s+(?:to\s+|about\s+)?(?P<what>.+?)\s+(?P<when>" + WHEN_START + r"\b.*)$", re.I),
          re.compile(r"^\s*(?:please\s+)?remind me\s+(?P<when>" + WHEN_START + r"\b.*?)\s+(?:to|about)\s+(?P<what>.+)$", re.I)]


def _timetable():
    import importlib.machinery
    import importlib.util
    loader = importlib.machinery.SourceFileLoader("prime_timetable", os.path.join(BIN, "prime-timetable"))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("prime_timetable", loader))
    loader.exec_module(mod)
    return mod


def reminder(query: str):
    """(what, when words, when) for a "remind me …" request whose time can be read, else None."""
    if not query.lower().lstrip().startswith(("remind me", "please remind me")):
        return None
    tt = _timetable()
    for rx in REMIND:
        m = rx.match(query)
        if m:
            what, when_w = m.group("what").strip(" .!"), m.group("when").strip(" .!")
            when = tt.parse_when(when_w)
            if what and when:
                return what, when_w, when
    return None


def words_of(text: str) -> tuple:
    t = text.lower().replace("wi-fi", "wifi").replace("’", "'")
    t = re.sub(r"[^a-z0-9' ]+", " ", t)
    return t, [w for w in t.split() if w]


def _hit(group: set, text: str, toks: list) -> set:
    """The words of the query this group accounts for (empty: not present)."""
    used = set()
    for syn in group:
        if " " in syn:
            if re.search(rf"\b{re.escape(syn)}\b", text):
                used |= set(syn.split())
        elif syn in toks:
            used.add(syn)
    return used


def match(query: str, limit: int = 5) -> list:
    """[(score, id, title)] best first. Score 1.0: every meaningful word understood."""
    r = reminder(query)
    if r:
        what, when_w, when = r
        return [(1.0, f"remind:{what}|{when_w}", f"Remind me: {what} — {_timetable().when_words_out(when)}")]
    text, toks = words_of(query)
    meaningful = [w for w in toks if w not in FILLER and w not in SOFT] or [w for w in toks if w not in FILLER]
    if not meaningful:
        return []
    out = []
    for iid, title, groups, avoid, _cmd, _done in INTENTS:
        used = set()
        ok_ = True
        for g in groups:
            u = _hit(g, text, toks)
            if not u:
                ok_ = False
                break
            used |= u
        if not ok_ or _hit(avoid, text, toks):
            continue
        covered = sum(1 for w in meaningful if w in used)
        score = round(covered / len(meaningful), 2)
        if score >= 0.5:
            out.append((score, -len(groups), iid, title))
    out.sort(key=lambda r: (-r[0], r[1]))
    return [(s, iid, title) for s, _g, iid, title in out[:limit]]


def available(iid: str) -> bool:
    cmd = BY_ID[iid][4]
    c = cmd[0]
    if c == "sh":       # a small chain: its first real tool must be there
        c = cmd[2].split()[0]
    return os.access(c, os.X_OK) if os.path.isabs(c) else shutil.which(c) is not None


def run_reminder(iid: str) -> int:
    what, _, when_w = iid[len("remind:"):].partition("|")
    cmd = [B("prime-timetable"), "--remind", what, when_w]
    if os.environ.get("PRIME_DO_DRY"):
        print("DO", " ".join(cmd))
        return 0
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=20)
    msg = (r.stdout or r.stderr).strip() or "Reminder added"
    print(msg)
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "-a", "Prime", "-t", "3500", msg], stderr=subprocess.DEVNULL)
    return r.returncode


def run(iid: str) -> int:
    if iid.startswith("remind:"):
        return run_reminder(iid)
    _id, title, _g, _a, cmd, done = BY_ID[iid]
    if os.environ.get("PRIME_DO_DRY"):
        print("DO", " ".join(cmd))
        print(done or title)
        return 0
    if not available(iid):
        print(f"{title}: this computer doesn't have what that needs.")
        return 1
    if not done:           # opens a window of its own: detach and return at once
        subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        print(title)
        return 0
    try:
        ok_ = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        ok_ = False
    msg = done if ok_ else f"{title}: that didn't work — Check and fix the computer (Super+H) can help."
    print(msg)
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "-a", "Prime", "-t", "2500", msg], stderr=subprocess.DEVNULL)
    return 0 if ok_ else 1


def main(argv: list) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if argv else 2
    if argv[0] == "--list":
        for iid, title, *_ in INTENTS:
            print(f"{iid}\t{title}")
        return 0
    if argv[0] == "--match":
        for s, iid, title in match(" ".join(argv[1:])):
            print(f"{iid}\t{title}\t{s}")
        return 0
    if argv[0] == "--id":
        if len(argv) < 2 or (argv[1] not in BY_ID and not argv[1].startswith("remind:")):
            print("no such action", file=sys.stderr)
            return 2
        return run(argv[1])
    hits = match(" ".join(argv))
    if not hits or hits[0][0] < 1.0:
        print("I don't know how to do that yet." + (f" Did you mean: {hits[0][2]}?" if hits else ""))
        return 3
    return run(hits[0][1])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
