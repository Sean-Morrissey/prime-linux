#!/usr/bin/env bash
# prime-idle — the idle timer: dim, lock, screens off and sleep after the minutes
# chosen in Settings → Lock & Sleep (lock_after, screen_off_after, sleep_after in
# ~/.config/prime/settings.json; 0 = never). Defaults: lock at 10, screens off at 20,
# never sleep. Keep awake (Settings → Power) still pauses all of it.
#
#   prime-idle             start hypridle with those timers (what login runs)
#   prime-idle --write     only write ~/.config/prime/hypridle.conf
#   prime-idle --restart   write it and restart the running hypridle
set -u
BIN="$(dirname "$(readlink -f "$0")")"
OUT="$HOME/.config/prime/hypridle.conf"
setting() { jq -r --arg k "$1" '.settings[$k] // empty' "$HOME/.config/prime/settings.json" 2>/dev/null; }
minutes() { local v; v="$(setting "$1")"; case "$v" in ''|*[!0-9]*) echo "$2" ;; *) echo "$v" ;; esac; }

write() {
    local lock off sleep
    lock="$(minutes lock_after 10)"; off="$(minutes screen_off_after 20)"; sleep="$(minutes sleep_after 0)"
    mkdir -p "$(dirname "$OUT")"
    {
        echo "# Written by prime-idle from Settings → Lock & Sleep — change it there, not here."
        echo "general {"
        echo "    lock_cmd = pidof hyprlock || $BIN/prime-lock"
        echo "    # going to sleep: straight to the password screen (no screen saver to wake into)"
        echo "    before_sleep_cmd = $BIN/prime-lock --now"
        echo "    after_sleep_cmd = hyprctl dispatch dpms on"
        echo "    ignore_dbus_inhibit = false"
        echo "}"
        echo "# away after 5 minutes: nightly updates can tell 'away' from 'watching a video'"
        echo "listener {"
        echo "    timeout = 300"
        echo "    on-timeout = loginctl set-idle-hint true"
        echo "    on-resume  = loginctl set-idle-hint false"
        echo "}"
        if [ "$lock" -gt 0 ]; then
            echo "# dim a minute before locking, then lock (the screen saver shows first)"
            echo "listener {"
            echo "    timeout = $(( lock * 60 > 60 ? lock * 60 - 60 : 30 ))"
            echo "    on-timeout = brightnessctl -s set 30%"
            echo "    on-resume  = brightnessctl -r"
            echo "}"
            echo "listener {"
            echo "    timeout = $(( lock * 60 ))"
            echo "    on-timeout = loginctl lock-session"
            echo "}"
        fi
        if [ "$off" -gt 0 ]; then
            echo "listener {"
            echo "    timeout = $(( off * 60 ))"
            echo "    on-timeout = $BIN/prime-screensaver --stop; sleep 1; hyprctl dispatch dpms off"
            echo "    on-resume  = hyprctl dispatch dpms on && brightnessctl -r"
            echo "}"
        fi
        if [ "$sleep" -gt 0 ]; then
            echo "listener {"
            echo "    timeout = $(( sleep * 60 ))"
            echo "    on-timeout = systemctl suspend"
            echo "}"
        fi
    } > "$OUT.tmp" && mv "$OUT.tmp" "$OUT"
}

case "${1:-}" in
    --write)   write ;;
    --restart) write; pkill -x hypridle; sleep 0.3
               setsid hypridle -c "$OUT" >/dev/null 2>&1 < /dev/null & ;;
    "")        write; exec hypridle -c "$OUT" ;;
    *)         sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
