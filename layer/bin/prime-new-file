#!/usr/bin/env bash
# prime:summary="New text file here" (Windows' New → Text Document)
# prime-new-file <dir> — "New text file here" (Windows' New → Text Document).
set -u
dir="${1:-$HOME/Desktop}"
[ -d "$dir" ] || dir="$HOME"
f="$dir/untitled.txt"; n=2
while [ -e "$f" ]; do f="$dir/untitled $n.txt"; n=$((n + 1)); done
: >"$f" || exit 1
"$(dirname "$(readlink -f "$0")")/prime-notify" -T 4000 -t "New file" -b "$(basename "$f")" -a "xdg-open $(printf '%q' "$f")"
