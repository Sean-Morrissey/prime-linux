#!/usr/bin/env bash
# prime:summary=notifications that go somewhere when you click them
# prime-notify — notifications that go somewhere when you click them.
#
#   prime-notify -t "Title" -b "Body" [-i icon] [-u low|normal|critical]
#                [-T timeout-ms] [-s replace-tag] [-a Command] [-k Command]
#
# Without an action a click does nothing, which is the thing people notice: the
# notification says "update failed" and refuses to show you the update. With -a
# the body click (or its "Open" button) runs the command, and a "Dismiss" button
# closes it (-k gives Dismiss a command of its own). -s replaces the previous
# notification with the same tag instead of stacking a new one.
#
# notify-send -A blocks while the notification is on screen, so this always runs
# it in the background and acts on the printed action id in a watcher process:
# the caller never waits.
set -u

TITLE="Prime"; BODY=""; ICON=""; ON_OPEN=""; ON_DISMISS=""; TIMEOUT=8000; URGENCY=""; TAG=""

while [ $# -gt 0 ]; do
  case "$1" in
    -t|--title)   TITLE="${2:-Prime}"; shift 2 ;;
    -b|--body)    BODY="${2:-}"; shift 2 ;;
    -i|--icon)    ICON="${2:-}"; shift 2 ;;
    -u|--urgency) URGENCY="${2:-normal}"; shift 2 ;;
    -a|--action)  ON_OPEN="${2:-}"; shift 2 ;;
    -k|--dismiss) ON_DISMISS="${2:-}"; shift 2 ;;
    -T|--timeout) TIMEOUT="${2:-8000}"; shift 2 ;;
    -s|--replace) TAG="${2:-}"; shift 2 ;;
    -h|--help)    sed -n '3,16p' "$0"; exit 0 ;;
    *) BODY="$*"; break ;;
  esac
done

command -v notify-send >/dev/null 2>&1 || exit 0

ARGS=(-a Prime -t "$TIMEOUT")
[ -n "$TAG" ]     && ARGS+=(-h "string:x-canonical-private-synchronous:$TAG")
[ -n "$ICON" ]    && ARGS+=(-i "$ICON")
[ -n "$URGENCY" ] && ARGS+=(-u "$URGENCY")

if [ -n "$ON_OPEN" ] || [ -n "$ON_DISMISS" ]; then
  # "default" is the id a click on the notification body sends
  [ -n "$ON_OPEN" ] && ARGS+=(-A "default=Open")
  ARGS+=(-A "dismiss=Dismiss")
  (
    answer="$(notify-send "${ARGS[@]}" "$TITLE" "$BODY" 2>/dev/null)"
    case "$answer" in
      default) [ -n "$ON_OPEN" ]    && setsid nohup bash -lc "$ON_OPEN"    >/dev/null 2>&1 & ;;
      dismiss) [ -n "$ON_DISMISS" ] && setsid nohup bash -lc "$ON_DISMISS" >/dev/null 2>&1 & ;;
    esac
  ) </dev/null >/dev/null 2>&1 &
  disown 2>/dev/null || true
else
  notify-send "${ARGS[@]}" "$TITLE" "$BODY" >/dev/null 2>&1 || true
fi
exit 0
