#!/usr/bin/env bash
# prime-notify-pill — the bar's notification bell. Passes the notification
# centre's live state through, adding a tooltip that says it in words
# ("2 new notifications · Do not disturb is on"), so the state never rests on
# the bell's colour alone.
command -v swaync-client >/dev/null || { echo '{"text":"","tooltip":"Notifications: not running"}'; exit 0; }
swaync-client -swb | jq --unbuffered -c '
    (.text | tonumber? // 0) as $n
  | (.alt // "") as $alt
  | .tooltip = ("Notifications: "
        + (if $n == 0 then "none new" elif $n == 1 then "1 new" else "\($n) new" end)
        + (if ($alt | startswith("dnd")) then " · Do not disturb is on" else "" end)
        + "\nclick to open · Super+K")'
