#!/usr/bin/env bash
# prime-release-verify — is this update really a Prime release?
#
#   prime-release-verify <repo> <commit>   exit 0: it may be installed
#                                          exit 3: it must NOT be installed (said why)
#
# The trust model (docs/RELEASE.md → "Signing"):
#   * Prime's release keys are listed in layer/system/release/allowed_signers,
#     in ssh-keygen's allowed-signers format. The copy that decides is the one
#     ALREADY INSTALLED on this computer — read before the update is applied —
#     so a new key can only arrive inside an update the old key signed.
#   * On the `stable` channel every update must be a commit carrying a
#     v* tag signed by one of those keys. An unsigned, wrongly-signed or
#     untagged commit is refused, whoever managed to push it.
#   * Other channels (main, edge, a feature branch) are for testers and
#     follow the branch unsigned — set PRIME_REQUIRE_SIGNED=1 to check those too.
#   * Until the first key is published the list is empty and there is nothing
#     to check against: updates are allowed, and this says so.
set -u
repo="${1:?repo}"; commit="${2:?commit}"
keys="${PRIME_RELEASE_KEYS:-$repo/layer/system/release/allowed_signers}"
channel="$(git -C "$repo" symbolic-ref --short -q HEAD 2>/dev/null || echo detached)"

if [ "$channel" != stable ] && [ "${PRIME_REQUIRE_SIGNED:-0}" != 1 ]; then
    echo "not checked: the $channel channel follows the branch (only stable must be signed)"
    exit 0
fi
if ! grep -qvE '^\s*(#|$)' "$keys" 2>/dev/null; then
    echo "not checked: no release key is published yet (layer/system/release/allowed_signers is empty)"
    exit 0
fi

command -v ssh-keygen >/dev/null || { echo "refused: can't check signatures here (ssh-keygen is missing — it comes with the openssh package)" >&2; exit 3; }
target="$(git -C "$repo" rev-parse --verify -q "$commit^{commit}")" || { echo "no such commit: $commit" >&2; exit 3; }
# the keys file is copied aside: verify-tag must not read a file the update could swap
pinned="$(mktemp)"; trap 'rm -f "$pinned"' EXIT
cp -- "$keys" "$pinned"
tags="$(git -C "$repo" tag --points-at "$target" --list 'v*')"
[ -n "$tags" ] || { echo "refused: this update ($(git -C "$repo" rev-parse --short "$target")) isn't a tagged Prime release" >&2; exit 3; }
while read -r t; do
    [ -n "$t" ] || continue
    if git -C "$repo" -c gpg.format=ssh -c gpg.ssh.allowedSignersFile="$pinned" verify-tag "$t" >/dev/null 2>&1; then
        echo "verified: $t is signed by a Prime release key"
        exit 0
    fi
done <<<"$tags"
echo "refused: $(tr '\n' ' ' <<<"$tags")isn't signed by a Prime release key this computer trusts" >&2
exit 3
