#!/usr/bin/env python3
"""prime-settings — Prime's toolbox: the fixed list of things the assistant (and
the Welcome app) may change on this computer. There is no "run any command"
tool. Every change is checked against your permission file, asked about when
needed, preceded by a desktop backup, written to the audit log, and undoable.

  prime-settings list                         the tools, and what each may do now
  prime-settings run <tool> ['{"arg": …}']    do one thing yourself (no permission check)
  prime-settings undo                         undo the last change
  prime-settings log [N]                      what was changed, in plain words
  prime-settings autonomy [LEVEL]             show / set how much Prime may do on its own:
                                                suggest (ask me first) · auto-user · auto-all
  prime-settings status                       current settings as JSON

How the assistant calls it (prime-ask does this — you don't need to):
  prime-settings run <tool> '<json>' --actor ai [--confirm tty|gui|deny] [--untrusted WHAT]

Output of `run` is one JSON object: {"ok", "status", "message", …}.
Files: ~/.config/prime/capabilities.yaml (permissions — only you change it),
~/.config/prime/audit.jsonl (the log), ~/.config/prime/settings.json (the
settings Prime manages; written into a marked block of ~/.config/hypr/hyprland.conf).
"""
from __future__ import annotations

import datetime as _dt
import glob
import json
import os
import pwd
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
import uuid

HOME = os.path.expanduser("~")
BIN = os.path.dirname(os.path.realpath(__file__))
LAYER = os.path.realpath(os.path.join(BIN, ".."))
REPO = os.path.realpath(os.path.join(LAYER, ".."))
