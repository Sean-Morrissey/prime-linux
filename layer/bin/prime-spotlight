#!/usr/bin/python3
"""Prime Spotlight — the one box that finds anything (Super+Space).

Type and results appear as you go, grouped: the Top Hit, Applications, Files,
Calculator, and a last row that searches the web — or, with the AI add-on
enabled, asks the assistant. Enter opens the highlighted row; the mouse works
too (hover to highlight, click to open). Esc closes.

Things Prime can simply do ("wifi off", "louder", "bigger text", "mouse settings")
come first, under "Do it" — no AI involved (prime-do). Plain sums are answered in place (2+2, 15% of nothing, just arithmetic);
Enter copies the result. Prefixes, for when the guess is wrong:
    = <expr>     arithmetic only
    > <text>     applications only
    / <text>     search the web

  prime-spotlight                    run it (what the keybind does)
  prime-spotlight --selftest         every source + the router + the window, map nothing
  prime-spotlight --query "notes"    what the list would show, headless
  prime-spotlight --screenshot F --query Q   render the window to a PNG (needs a display)
  prime-spotlight --prefill "text"   open with the text already typed (the start menu's hand-off)
"""
from __future__ import annotations

import argparse
import ast
import operator
import os
import re
import subprocess
import sys
import threading
import time
import urllib.parse
import xml.etree.ElementTree as ET

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, Gio, GLib, Gtk, Pango  # noqa: E402

try:
    gi.require_version("GtkLayerShell", "0.1")
    from gi.repository import GtkLayerShell
    HAVE_LAYER = True
except (ValueError, ImportError):
    GtkLayerShell = None
    HAVE_LAYER = False

HOME = os.path.expanduser("~")
LAYER = os.path.realpath(os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
WEB_SEARCH = os.environ.get("PRIME_WEB_SEARCH", "https://duckduckgo.com/?q={}")


def _load_do():
    """prime-do's phrase list (the things Prime does without AI), or None."""
    try:
        import importlib.machinery
        import importlib.util
        path = os.path.join(LAYER, "bin", "prime-do")
        loader = importlib.machinery.SourceFileLoader("prime_do", path)
        spec = importlib.util.spec_from_loader("prime_do", loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        return mod
    except (OSError, SyntaxError, ImportError):
        return None


PRIME_DO = _load_do()


def find_asker() -> str:
    """The first enabled add-on that can answer questions (bin/prime-ask), or ""."""
    try:
        names = [l.strip() for l in open(os.path.join(HOME, ".config/prime/addons"))
                 if l.strip() and not l.startswith("#")]
    except OSError:
        return ""
    for n in names:
        p = os.path.join(LAYER, "addons", n, "bin", "prime-ask")
        if os.access(p, os.X_OK):
            return p
    return ""


ASKER = find_asker()


def theme_accent() -> str:
    try:
        for line in open(os.path.join(HOME, ".config/prime/theme.conf")):
            if line.startswith("ACCENT="):
                v = line.split("=", 1)[1].strip().strip("'\"").lstrip("#")
                if re.fullmatch(r"[0-9a-fA-F]{6}", v):
                    return "#" + v.lower()
    except OSError:
        pass
    return "#60a5fa"


XDG_DATA_DIRS = os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
APP_DIRS = [os.path.join(HOME, ".local/share/applications")] + \
    [os.path.join(d, "applications") for d in XDG_DATA_DIRS] + [
    "/var/lib/flatpak/exports/share/applications",
    os.path.join(HOME, ".local/share/flatpak/exports/share/applications"),
]
SKIP_DIRS = {".git", "node_modules", ".cache", ".venv", "venv", "__pycache__",
             ".npm", ".cargo", ".rustup", ".local/share/Trash"}
MAX_ROWS = 9
APP_ICONS: dict = {}          # desktop id -> Icon= value (filled by load_apps)

SECTION = {"do": "Do it", "app": "Applications", "setting": "Settings", "path": "Files", "recent": "Recent",
           "math": "Calculator", "ask": "Ask Prime" if ASKER else "Web", "hint": ""}

