def css_bytes() -> bytes:
    return CSS.replace("@ACCENT@", theme_accent()).encode()


# ── sources ────────────────────────────────────────────────────────────────────

def _desktop_field(text: str, key: str) -> str:
    """A key from the [Desktop Entry] group only (not from Actions)."""
    head = text.split("\n[", 1)[0] if text.lstrip().startswith("[Desktop Entry]") else text
    m = re.search(rf"^{key}=(.*)$", head, re.M)
    return (m.group(1) if m else "").strip()


def load_apps() -> list:
    """[(name, exec, desktop_id, comment)] from every XDG applications dir."""
    out, seen = [], set()
    for d in APP_DIRS:
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for fn in names:
            if not fn.endswith(".desktop") or fn in seen:
                continue
            seen.add(fn)
            path = os.path.join(d, fn)
            try:
                with open(path, encoding="utf-8", errors="replace") as fh:
                    text = fh.read()
            except OSError:
                continue
            if _desktop_field(text, "NoDisplay").lower() == "true":
                continue
            if _desktop_field(text, "Hidden").lower() == "true":
                continue
            if _desktop_field(text, "Type") not in ("", "Application"):
                continue
            name = _desktop_field(text, "Name")
            exe = _desktop_field(text, "Exec")
            if not name or not exe:
                continue
            did = fn[:-len(".desktop")]
            APP_ICONS[did] = _desktop_field(text, "Icon")
            out.append((name, exe, did, _desktop_field(text, "Comment")))
    return out


def wanted_recent(path: str) -> bool:
    """A recent file worth showing: not scratch space (/tmp, /var/tmp) and not inside
    a hidden folder (~/.cache, ~/.claude/worktrees …) — those are tools' files, not his."""
    p = os.path.normpath(path)
    if p == "/tmp" or p.startswith(("/tmp/", "/var/tmp/")) or p == "/var/tmp":
        return False
    folders = [c for c in os.path.dirname(p).split(os.sep) if c]
    return not any(c.startswith(".") for c in folders)


def load_recent(limit: int = 12) -> list:
    """Recently opened files from the GTK bookmark file, newest first (tidied by
    wanted_recent)."""
    xbel = os.path.join(HOME, ".local/share/recently-used.xbel")
    try:
        root = ET.parse(xbel).getroot()
    except (OSError, ET.ParseError):
        return []
    rows = []
    for bm in root.iter("bookmark"):
        href = bm.get("href", "")
        if not href.startswith("file://"):
            continue
        path = urllib.parse.unquote(href[len("file://"):])
        if not wanted_recent(path) or not os.path.exists(path):
            continue
        rows.append((bm.get("visited") or bm.get("modified") or "", path))
    rows.sort(reverse=True)
    out, seen = [], set()
    for _, path in rows:
        if path in seen:
            continue
        seen.add(path)
        out.append(path)
        if len(out) >= limit:
            break
    return out


def find_paths(query: str, limit: int = 24, timeout: int = 4) -> list:
    """Files and folders under ~ matching `query`, best-first (fd, then plocate)."""
    q = query.strip()
    if not q:
        return []
    args = ["fd", "--absolute-path", "--max-results", str(limit), "--fixed-strings",
            "--type", "f", "--type", "d", "--color", "never"]
    for d in SKIP_DIRS:
        args += ["--exclude", d]
    args += ["--", q, HOME]
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        hits = [ln for ln in r.stdout.splitlines() if ln.strip()]
    except (OSError, subprocess.TimeoutExpired):
        hits = []
    if not hits:                      # plocate covers the rest of the disk, instantly
        try:
            r = subprocess.run(["plocate", "-i", "-l", str(limit * 8), "--", q],
                               capture_output=True, text=True, timeout=timeout)
            # people's files only: home, other disks, USB sticks — not /etc or /usr
            mine = (HOME + "/", "/mnt/", "/media/", "/run/media/")
            hits = [ln for ln in r.stdout.splitlines()
                    if ln.strip() and ln.startswith(mine)][:limit]
        except (OSError, subprocess.TimeoutExpired):
            hits = []
    return hits


# ── local arithmetic ───────────────────────────────────────────────────────────

_OPS = {ast.Add: operator.add, ast.Sub: operator.sub, ast.Mult: operator.mul,
        ast.Div: operator.truediv, ast.FloorDiv: operator.floordiv,
        ast.Mod: operator.mod, ast.Pow: operator.pow, ast.USub: operator.neg,
        ast.UAdd: operator.pos}


def _eval_node(node):
    if isinstance(node, ast.Expression):
        return _eval_node(node.body)
    if isinstance(node, ast.Constant) and isinstance(node.value, (int, float)):
        return node.value
    if isinstance(node, ast.BinOp) and type(node.op) in _OPS:
        if isinstance(node.op, ast.Pow):
            exp = _eval_node(node.right)
            if abs(exp) > 1000:
                raise ValueError("too big")
            return operator.pow(_eval_node(node.left), exp)
        return _OPS[type(node.op)](_eval_node(node.left), _eval_node(node.right))
    if isinstance(node, ast.UnaryOp) and type(node.op) in _OPS:
        return _OPS[type(node.op)](_eval_node(node.operand))
    raise ValueError("not arithmetic")


def calc(expr: str) -> str:
    """Safe arithmetic. Empty string when it is not a sum we should answer."""
    expr = expr.strip().lstrip("=").strip().replace("^", "**").replace("×", "*") \
        .replace("÷", "/").replace(",", "")
    if not expr or not re.fullmatch(r"[0-9 .+\-*/%()]+", expr):
        return ""
    try:
        value = _eval_node(ast.parse(expr, mode="eval"))
    except (SyntaxError, ValueError, TypeError, ZeroDivisionError, OverflowError):
        return ""
    if isinstance(value, float):
        if value.is_integer():
            value = int(value)
        else:
            value = round(value, 6)
    return str(value)


def looks_like_sum(q: str) -> bool:
    """2+2, (3*4)/2, 2^8 — digits with at least one operator between them."""
    return bool(re.fullmatch(r"[\d\s.,()]*\d[\d\s.,()]*([+\-*/×÷^%][\d\s.,()]+)+", q.strip()))


# ── ranking + routing (pure, so the self-test can assert them) ─────────────────

SETTING_HINTS: dict = {}      # menu row id -> its hint (filled by load_settings)


def load_settings() -> list:
    """[(label, id)] for every row of the Prime menu except the app list: Wi-Fi,
    Bluetooth, wallpaper, updates, power… so typing "wifi" finds the setting, not
    only apps and files. Reads the menu prime-menu last built (with add-ons and
    your own rows), else Prime's own."""
    import json
    rt = os.environ.get("XDG_RUNTIME_DIR", "")
    for path in (os.path.join(rt, "prime-menu.json") if rt else "",
                 os.path.join(LAYER, "default", "menu.json")):
        try:
            data = json.load(open(path))
        except (OSError, ValueError):
            continue
        out = []
        for sec in data.get("sections", []):
            for it in sec.get("items", []):
                if it.get("kind") in ("run", "panel", "term") and it.get("id") and it.get("label"):
                    SETTING_HINTS[it["id"]] = it.get("hint") or sec.get("label", "")
                    out.append((it["label"], it["id"]))
        return out
    return []


def _norm(t: str) -> str:
    return re.sub(r"[^a-z0-9]", "", t.lower())


def rank_settings(query: str, settings: list, limit: int = 3) -> list:
    """Menu rows whose name starts with, or contains, what was typed (punctuation
    ignored: "wifi" finds "Wi-Fi & network"); the hint counts too."""
    q = _norm(query)
    if len(q) < 3:
        return []
    scored, seen = [], set()
    for label, sid in settings:
        n, h = _norm(label), _norm(SETTING_HINTS.get(sid, ""))
        words = [_norm(w) for w in re.split(r"[\s/·—,&()-]+", label)]
        if n.startswith(q) or any(w.startswith(q) for w in words if w):
            score = 0
        elif q in n:
            score = 1
        elif q in h:
            score = 2
        else:
            continue
        if n in seen:
            continue
        seen.add(n)
        scored.append((score, len(label), label, sid))
    scored.sort()
    return [("setting", s[2], s[3], "") for s in scored[:limit]]


def rank_do(query: str, limit: int = 2) -> list:
    """Things Prime can do for these words: ("do", title, id, "sure"|"maybe")."""
    if PRIME_DO is None or len(query.strip()) < 3:
        return []
    return [("do", title, iid, "sure" if score >= 1.0 else "maybe")
            for score, iid, title in PRIME_DO.match(query, limit) if score >= 0.67]


def rank_apps(query: str, apps: list, limit: int = 6) -> list:
    q = query.lower().strip()
    scored = []
    for name, exe, did, comment in apps:
        n, d = name.lower(), did.lower()
        if not q:
            continue
        if n.startswith(q):
            score = 0
        elif any(w.startswith(q) for w in re.split(r"[\s\-_.]+", n)):
            score = 1
        elif q in n:
            score = 2
        elif q in d or q in exe.lower() or (len(q) > 2 and q in comment.lower()):
            score = 3
        else:
            continue
        scored.append((score, len(name), name, exe, did, comment))
    scored.sort()
    return [("app", s[2], s[4], s[5]) for s in scored[:limit]]


def rank_paths(query: str, paths: list, existing: set, limit: int = 6) -> list:
    """Existing files first, then shortest path, then name-prefix matches."""
    q = query.lower().strip()
    rows = []
    for p in paths:
        name = os.path.basename(p.rstrip("/")) or p
        base = name.lower()
        if not q and p not in existing:
            continue
        if q and q not in base and q not in p.lower():
            # keep weak hits only if the basename at least starts with the query
            if not base.startswith(q[:3]):
                continue
        rows.append((0 if p in existing else 1,
                     0 if base.startswith(q) else 1,
                     len(p), p, name))
    rows.sort()
    return [("path", r[4], r[3], "") for r in rows[:limit]]


def route(kind: str, main: str, sub: str, query: str) -> tuple:
    """What Enter does. Pure decision, so it can be tested without a keyboard."""
    if kind == "app":
        return ("launch_app", sub)                     # gtk-launch <desktop id>
    if kind == "path":
        return ("open_path", sub)
    if kind == "setting":
        return ("run_setting", sub)                    # prime-menu --run <row id>
    if kind == "math":
        return ("copy", main.lstrip("= ").strip())
    if kind == "do":
        return ("do", sub)                             # prime-do --id <id>
    if query.startswith("/") or not ASKER:
        return ("web", query.lstrip("/").strip())
    return ("ask", query)


def results_for(query: str, apps: list, recents: list, timeout: int = 4, settings: list = ()) -> list:
    """The whole list for a query: [(kind, main, sub, right)] + the always-ask row."""
    q = query.strip()
    rows = []
    if not q:
        rows = [("path", os.path.basename(p.rstrip("/")) or p, p, "recent")
                for p in recents[:6]]
        return rows or [("hint", "Start typing to search",
                         "apps · files · 2+2 · or anything else to " +
                         ("ask Prime" if ASKER else "search the web"), "")]

    asked_only_apps = q.startswith(">")
    asked_only_web = q.startswith("/")
    body = q.lstrip(">/").strip() if (asked_only_apps or asked_only_web) else q
    is_sum = q.startswith("=") or looks_like_sum(q)

    if is_sum:
        value = calc(q)
        if value:
            rows.append(("math", f"= {value}", q.lstrip("=").strip(), "copy"))
    if not asked_only_apps and not asked_only_web and not is_sum:
        rows += rank_do(body)
    if not asked_only_web and not q.startswith("="):
        rows += rank_apps(body, apps, 5 if not asked_only_apps else MAX_ROWS)
    if not asked_only_apps and not asked_only_web and not is_sum:
        rows += rank_settings(body, settings)
        hits = find_paths(body, timeout=timeout)
        rows += rank_paths(body, hits, set(recents), 5)
    if ASKER and not asked_only_web:
        rows.append(("ask", f"Ask Prime “{body}”", "the assistant answers in a window", "enter"))
    else:
        rows.append(("ask", f"Search the web for “{body}”", "opens in your browser", "enter"))
    return rows[:MAX_ROWS + 1]


def top_hit(rows: list, query: str):
    """The best single answer: a sum, an app named like the query, a file named
    like it, then any app, any file — the web/ask row only when nothing else."""
    q = query.strip().lstrip(">/=").strip().lower()
    def named(r):
        return bool(q) and any(w.startswith(q) for w in [r[1].lower()] + re.split(r"[\s\-_.]+", r[1].lower()))
    tests = [lambda r: r[0] == "math",
             lambda r: r[0] == "do" and r[3] == "sure",                 # "wifi off" → do it
             lambda r: r[0] == "setting" and _norm(r[1]) == _norm(q),   # "bluetooth" → Bluetooth
             lambda r: r[0] == "app" and named(r),
             lambda r: r[0] == "setting" and named(r),
             lambda r: r[0] == "path" and named(r),
             lambda r: r[0] == "app",
             lambda r: r[0] == "path"]
    for t in tests:
        for r in rows:
            if t(r):
                return r
    return rows[0]


def grouped(rows: list, query: str = "") -> list:
    """[(section, row)] in display order: the Top Hit, then each kind in turn."""
    if not rows:
        return []
    if rows[0][0] == "hint":
        return [("", rows[0])]
    if rows[0][3] == "recent":
        return [("Recent", r) for r in rows]
    order = ["math", "do", "app", "setting", "path", "ask"]
    top = top_hit(rows, query)
    out = [("Top Hit", top)]
    for k in order:
        for r in rows:
            if r is not top and r[0] == k:
                out.append((SECTION[k], r))
    return out


# ── icons ──────────────────────────────────────────────────────────────────────

def icon_for(kind: str, sub: str):
    """A Gio.Icon for a row (resolved lazily by the icon theme)."""
    theme = Gtk.IconTheme.get_default()

    def themed(*names):
        for n in names:
            if theme is None or theme.has_icon(n):
                return Gio.ThemedIcon.new(n)
        return Gio.ThemedIcon.new(names[-1])

    if kind == "app":
        val = APP_ICONS.get(sub, "")
        if val.startswith("/") and os.path.exists(val):
            return Gio.FileIcon.new(Gio.File.new_for_path(val))
        if val:
            return themed(val, "application-x-executable")
        return themed("application-x-executable")
    if kind == "path":
        if os.path.isdir(sub):
            return themed("folder")
        ctype, _ = Gio.content_type_guess(sub, None)
        return Gio.content_type_get_icon(ctype) if ctype else themed("text-x-generic")
    if kind == "math":
        return themed("accessories-calculator", "accessories-calculator-symbolic")
    if kind == "do":
        return themed("prime-linux", "system-run", "emblem-ok-symbolic")
    if kind == "setting":
        return themed("preferences-system", "emblem-system", "preferences-system-symbolic")
    if kind == "ask":
        return themed("prime-linux", "dialog-question") if ASKER else \
            themed("web-browser", "applications-internet", "system-search")
    return themed("system-search-symbolic")


def pretty_path(p: str) -> str:
    """Where a file is, in words: "Home", "Downloads", "Projects/notes" — or the full
    folder outside the home folder."""
    d = os.path.dirname(p.rstrip("/"))
    if d == HOME:
        return "Home"
    return d[len(HOME) + 1:] if d.startswith(HOME + "/") else d


# Plumbing that comes with the system but nobody opens from an app list (network
# browsers for Avahi, webcam test tools, the hardware map, another desktop's About
# box…). Lists of apps (Start → All apps, Prime menu → Apps) leave them out;
# searching for one by name still finds it.
LIST_HIDDEN = {
    "avahi-discover", "bssh", "bvnc", "qv4l2", "qvidcap", "lstopo", "xfce4-about",
    "rofi", "rofi-theme-selector", "nemo-autorun-software", "vim", "nvim", "gvim",
    "uxterm", "xterm", "cmake-gui", "electron", "org.freedesktop.Xwayland",
    "assistant", "designer", "linguist", "qdbusviewer", "jconsole", "jshell",
}


def listed(desktop_id: str) -> bool:
    """True when an app belongs in an app list (see LIST_HIDDEN)."""
    return desktop_id not in LIST_HIDDEN and not re.fullmatch(r"(electron|qt[56]?-?)[\d.-]*", desktop_id)


# ── window ─────────────────────────────────────────────────────────────────────

class Spotlight(Gtk.Window):
    WIDTH = 720

    def __init__(self, show: bool = True, offscreen: bool = False):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.apps = load_apps()
        self.settings = load_settings()
        self.recents = load_recent()
        self.rows: list = []
        self.seq = 0                       # guards against out-of-order searches
        self.mapped_at = 0.0

        self.set_name("prime-spotlight")
        self.set_title("Spotlight")
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_resizable(False)
        self.set_app_paintable(True)
        screen = self.get_screen()
        if screen is not None and screen.get_rgba_visual() is not None:
            self.set_visual(screen.get_rgba_visual())
        self.set_default_size(self.WIDTH, -1)

        self.card = card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        card.set_name("card")
        card.set_size_request(self.WIDTH - 56, -1)
        self.add(card)

        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        bar.set_name("searchbar")
        icon = Gtk.Image.new_from_icon_name("system-search-symbolic", Gtk.IconSize.LARGE_TOOLBAR)
        icon.set_pixel_size(22)
        icon.set_name("searchicon")
        bar.pack_start(icon, False, False, 0)
        self.entry = Gtk.Entry()
        self.entry.set_name("search")
        self.entry.set_has_frame(False)
        self.entry.set_placeholder_text("Search apps, files, or ask…")
        named(self.entry, "Spotlight search")
        self.entry.connect("changed", self.on_changed)
        self.entry.connect("activate", lambda *_: self.run_selected())
        self.entry.connect("key-press-event", self.on_key)
        bar.pack_start(self.entry, True, True, 0)
        card.pack_start(bar, False, False, 0)

        self.divider = Gtk.Box()
        self.divider.set_name("divider")
        card.pack_start(self.divider, False, False, 0)

        self.listbox = Gtk.ListBox()
        self.listbox.set_name("results")
        self.listbox.set_selection_mode(Gtk.SelectionMode.BROWSE)
        self.listbox.set_activate_on_single_click(True)
        self.listbox.set_can_focus(False)
        self.listbox.set_header_func(self._header)
        named(self.listbox, "Results")
        self.listbox.connect("row-activated", lambda _l, row: self.run_row(row.idx))
        self.listbox.add_events(Gdk.EventMask.POINTER_MOTION_MASK)
        self.listbox.connect("motion-notify-event", self.on_motion)
        card.pack_start(self.listbox, False, False, 0)

        foot = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        foot.set_name("footer")
        foot.pack_start(keycaps([("↑↓", "move"), ("↵", "open"), ("esc", "close")]), False, False, 0)
        foot.pack_end(keycaps([(">", "apps only"), ("/", "web"), ("=", "maths")]), False, False, 0)
        card.pack_start(foot, False, False, 0)

        if not offscreen:
            self.setup_layer()
        self.connect("map", lambda *_: setattr(self, "mapped_at", time.monotonic()))
        if not offscreen:
            self.connect("focus-out-event", lambda *_: self.hide_now())
        self.render(results_for("", self.apps, self.recents, timeout=1))
        if show:
            self.show_all()
            self.entry.grab_focus()

    def setup_layer(self):
        if not HAVE_LAYER or not GtkLayerShell.is_supported():
            self.set_position(Gtk.WindowPosition.CENTER)
            return
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_namespace(self, "prime-spotlight")
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.TOP, True)
        mon_h = 1080
        try:
            disp = Gdk.Display.get_default()
            mon = disp.get_monitor_at_point(0, 0) if disp else None
            if mon is not None:
                mon_h = mon.get_geometry().height
        except Exception:                    # noqa: BLE001
            pass
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, max(80, int(mon_h * 0.18)))
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.EXCLUSIVE)

    # ── results ──────────────────────────────────────────────────────────────
    def on_changed(self, _entry):
        self.seq += 1
        seq = self.seq
        GLib.timeout_add(60, self._search, seq)

    def _search(self, seq: int) -> bool:
        if seq != self.seq:
            return False
        query = self.entry.get_text()
        threading.Thread(target=self._search_worker, args=(seq, query), daemon=True).start()
        return False

    def _search_worker(self, seq: int, query: str):
        try:
            rows = results_for(query, self.apps, self.recents, settings=self.settings)
        except Exception:                       # noqa: BLE001 - a launcher never crashes
            rows = []
        GLib.idle_add(self._apply, seq, rows)

    def _apply(self, seq: int, rows: list) -> bool:
        if seq != self.seq or rows is None:
            return False
        self.render(rows)
        return False

    def render(self, rows: list):
        self.rows = grouped(rows, self.entry.get_text())
        for child in self.listbox.get_children():
            self.listbox.remove(child)
        for i, (section, row) in enumerate(self.rows):
            self.listbox.add(self.make_row(i, section, *row))
        self.listbox.show_all()
        first = self.listbox.get_row_at_index(0)
        if first is not None and self.rows and self.rows[0][1][0] != "hint":
            self.listbox.select_row(first)
        self.card.queue_resize()
        self.resize(self.WIDTH, 1)             # shrink back when the list gets shorter

    def _header(self, row, before):
        if before is not None and before.section == row.section:
            row.set_header(None)
            return
        if not row.section:
            row.set_header(None)
            return
        lab = Gtk.Label(label=row.section.upper())       # small, tracked, upper-case
        lab.set_xalign(0.0)
        lab.get_style_context().add_class("section")
        row.set_header(lab)

    def make_row(self, idx, section, kind, main, sub, right) -> Gtk.ListBoxRow:
        row = Gtk.ListBoxRow()
        row.idx, row.section = idx, section
        row.set_can_focus(False)
        ctx = row.get_style_context()
        ctx.add_class("hit")
        top = section == "Top Hit"
        if top:
            ctx.add_class("top")
        if kind == "hint":
            ctx.add_class("hintrow")
            row.set_selectable(False)
            row.set_activatable(False)

        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        img = Gtk.Image.new_from_gicon(icon_for(kind, sub), Gtk.IconSize.DND)
        img.set_pixel_size(32)                       # one icon size for every row
        box.pack_start(img, False, False, 0)

        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        text.set_valign(Gtk.Align.CENTER)
        title = Gtk.Label()
        title.set_text(main)              # plain text: names like "R&D.pdf" show as-is
        title.set_xalign(0.0)
        title.set_ellipsize(Pango.EllipsizeMode.MIDDLE if kind == "path" else Pango.EllipsizeMode.END)
        title.get_style_context().add_class("answer" if kind == "math" else "title")
        text.pack_start(title, False, False, 0)
        detail = {"app": sub and "", "path": pretty_path(sub), "setting": SETTING_HINTS.get(sub, ""),
                  "do": "Prime does it now"}.get(kind, sub)
        if kind == "app":
            detail = sub_comment = next((c for (_n, _e, d, c) in self.apps if d == sub), "")
            detail = sub_comment or "Application"
        if detail:
            st = Gtk.Label()
            st.set_text(detail)
            st.set_xalign(0.0)
            st.set_ellipsize(Pango.EllipsizeMode.MIDDLE)   # ~/a/…/file keeps both ends
            st.get_style_context().add_class("subtitle")
            text.pack_start(st, False, False, 0)
        box.pack_start(text, True, True, 0)

        verb = {"do": "Do", "app": "Open", "path": "Open", "setting": "Open", "math": "Copy", "ask": "Ask" if ASKER else "Search"}.get(kind)
        if verb:
            cap = Gtk.Label(label=f"{verb}  ↵")
            cap.get_style_context().add_class("keycap")
            cap.set_valign(Gtk.Align.CENTER)
            cap.set_no_show_all(True)
            row.keycap = cap
            box.pack_end(cap, False, False, 0)
        row.add(box)
        # what a screen reader says: the group, the name, the detail, and what Enter does
        named(row, ", ".join(x for x in (section, main, detail if kind != "math" else "", verb and f"Enter to {verb.lower()}") if x))
        row.connect("state-flags-changed", self._sync_keycap)
        return row

    @staticmethod
    def _sync_keycap(row, _old):
        cap = getattr(row, "keycap", None)
        if cap is not None:
            cap.set_visible(row.is_selected())

    def on_motion(self, _lb, event) -> bool:
        row = self.listbox.get_row_at_y(int(event.y))
        if row is not None and row.get_selectable() and not row.is_selected():
            self.listbox.select_row(row)
        return False

    # ── input ────────────────────────────────────────────────────────────────
    def move(self, step: int):
        n = len(self.rows)
        if not n:
            return
        cur = self.listbox.get_selected_row()
        i = cur.get_index() if cur else -1
        for _ in range(n):
            i = (i + step) % n
            row = self.listbox.get_row_at_index(i)
            if row is not None and row.get_selectable():
                self.listbox.select_row(row)
                return

    def on_key(self, _w, event) -> bool:
        key = event.keyval
        ctrl = event.state & Gdk.ModifierType.CONTROL_MASK
        if (time.monotonic() - self.mapped_at) < 0.3 and key == Gdk.KEY_Escape:
            return True                    # a stray key at map time is not an intent
        if key == Gdk.KEY_Escape:
            self.hide_now()
            return True
        if key in (Gdk.KEY_Down, Gdk.KEY_Tab) or (ctrl and key in (Gdk.KEY_n, Gdk.KEY_j)):
            self.move(1)
            return True
        if key in (Gdk.KEY_Up, Gdk.KEY_ISO_Left_Tab) or (ctrl and key in (Gdk.KEY_p, Gdk.KEY_k)):
            self.move(-1)
            return True
        return False

    def hide_now(self, *_a) -> bool:
        Gtk.main_quit()
        return False

    def run_selected(self):
        row = self.listbox.get_selected_row()
        if row is not None:
            self.run_row(row.idx)

    def run_row(self, idx: int):
        if not (0 <= idx < len(self.rows)):
            return
        kind, main, sub, _right = self.rows[idx][1]
        if kind == "hint":
            return
        action, payload = route(kind, main, sub, self.entry.get_text().strip())
        self.hide_now()
        if action == "launch_app":
            detached(["gtk-launch", payload])
        elif action == "open_path":
            detached(["xdg-open", payload])
        elif action == "run_setting":
            detached([os.path.join(LAYER, "bin", "prime-menu"), "--run", payload])
        elif action == "do":
            detached([os.path.join(LAYER, "bin", "prime-do"), "--id", payload])
        elif action == "copy":
            copy_to_clipboard(payload)
        elif action == "ask":
            detached([ASKER, payload])
        elif action == "web":
            detached(["xdg-open", WEB_SEARCH.format(urllib.parse.quote_plus(payload))])


def keycaps(pairs: list) -> Gtk.Box:
    """A footer group: [key] what-it-does, [key] what-it-does … as real keycap chips."""
    box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
    for i, (key, what) in enumerate(pairs):
        cap = Gtk.Label(label=key)
        cap.get_style_context().add_class("key")
        cap.set_valign(Gtk.Align.CENTER)
        box.pack_start(cap, False, False, 0)
        lab = Gtk.Label(label=what)
        lab.set_margin_end(10 if i < len(pairs) - 1 else 0)
        box.pack_start(lab, False, False, 0)
    named(box, ", ".join(f"{k} {w}" for k, w in pairs))
    return box


def named(widget, name: str):
    """The accessible name a screen reader announces for a widget."""
    acc = widget.get_accessible()
    if acc is not None:
        acc.set_name(name)
    return widget


def detached(cmd: list):
    """Fire and forget, fully detached from this process group."""
    env = dict(os.environ)
    env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    try:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True, env=env)
    except OSError:
        pass


def copy_to_clipboard(text: str):
    for tool in (["wl-copy"], ["xclip", "-selection", "clipboard"]):
        try:
            p = subprocess.run(tool, input=text, text=True, timeout=5)
            if p.returncode == 0:
                return
        except (OSError, subprocess.TimeoutExpired):
            continue


def install_css():
    style = Gtk.CssProvider()
    style.load_from_data(css_bytes())
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), style, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)


# ── headless verification ──────────────────────────────────────────────────────

def run_query(query: str) -> int:
    apps = load_apps()
    recents = load_recent()
    last = None
    for section, (kind, main, sub, right) in grouped(results_for(query, apps, recents, settings=load_settings()), query):
        if section != last:
            print(f"{section or '·'}")
            last = section
        print(f"  {kind:<5} {main:<52} {sub[:60]:<60} {right}")
    return 0


def screenshot(path: str, query: str) -> int:
    """Render the real window offscreen (needs a display, e.g. Xvfb) to a PNG."""
    if not Gtk.init_check(sys.argv)[0]:
        print("no display", file=sys.stderr)
        return 1
    install_css()
    win = Spotlight(show=False, offscreen=True)
    win.entry.set_text(query)
    win.entry.set_position(-1)
    win.render(results_for(query, win.apps, win.recents, settings=win.settings))
    off = Gtk.OffscreenWindow()
    screen = off.get_screen()
    if screen.get_rgba_visual() is not None:
        off.set_visual(screen.get_rgba_visual())
    win.remove(win.card)
    off.add(win.card)
    off.show_all()
    if query:
        win.listbox.select_row(win.listbox.get_row_at_index(0))
    for _ in range(40):
        while Gtk.events_pending():
            Gtk.main_iteration_do(False)
        time.sleep(0.01)
    pb = off.get_pixbuf()
    pb.savev(path, "png", [], [])
    print(path)
    return 0


def selftest() -> int:
    """Exercise every source and the router; build the window without mapping it."""
    fails = []

    def check(name, ok, detail=""):
        print(f"  {'PASS' if ok else 'FAIL'}  {name}" + (f" — {detail}" if detail else ""))
        if not ok:
            fails.append(name)

    apps = load_apps()
    check("application menu parsed", len(apps) > 5, f"{len(apps)} entries")

    first = apps[0][0] if apps else ""
    hits = rank_apps(first[:4], apps)
    check("app search finds an app by its first letters", bool(hits), hits[0][1] if hits else "nothing")
    check("apps carry an icon name", sum(1 for a in apps if APP_ICONS.get(a[2])) > len(apps) // 2,
          f"{sum(1 for a in apps if APP_ICONS.get(a[2]))}/{len(apps)}")

    check("arithmetic is exact", calc("=16*7/4") == "28" and calc("=2^10") == "1024"
          and calc("=10-2.5") == "7.5", f"16*7/4={calc('=16*7/4')} 2^10={calc('=2^10')}")
    check("not-arithmetic is refused", calc("hello") == "" and calc("=1;rm -rf /") == ""
          and calc("=9**9**9") == "")
    check("plain sums are answered without '='", looks_like_sum("2+2") and not looks_like_sum("2048")
          and not looks_like_sum("mp3") and grouped(results_for("12*3", apps, []), "12*3")[0][1][1] == "= 36")

    import tempfile
    probe = tempfile.NamedTemporaryFile(prefix="spotlight-selftest-R&D-", dir=HOME, delete=True)
    name = os.path.basename(probe.name)
    paths = find_paths(name)
    check("file search finds a file in home", any(name in p for p in paths), f"{len(paths)} hit(s)")
    rows = results_for(name, apps, [])
    probe.close()
    check("file names are shown as-is (no &amp;)",
          any(r[0] == "path" and "&" in r[1] and "&amp;" not in r[1] for r in rows))
    check("router opens a file hit",
          any(r[0] == "path" for r in rows) and route("path", "", "/tmp/x", "")[0] == "open_path")
    check("router launches an app hit", route("app", "", "firefox", "") == ("launch_app", "firefox"))
    st = load_settings()
    hits = rank_settings("wifi", st)
    check("settings: 'wifi' finds Wi-Fi & network", any(h[1].startswith("Wi-Fi") for h in hits), str(hits))
    check("settings: 'wallpaper' finds the theme", bool(rank_settings("wallpaper", st)))
    check("settings: two letters find nothing (no noise)", rank_settings("wi", st) == [])
    check("router opens a setting through the menu", route("setting", "", "set.network", "") == ("run_setting", "set.network"))
    check("router copies a sum", route("math", "= 28", "", "=16*7/4") == ("copy", "28"))
    check("no match falls through", rows[-1][0] == "ask"
          and route("ask", "", "", "weather")[0] == ("ask" if ASKER else "web"), rows[-1][1][:60])
    check("web prefix searches the web", route("ask", "", "", "/pla filament") == ("web", "pla filament"))
    g = grouped(results_for(first[:4], apps, []), first[:4])
    check("results are grouped with a Top Hit first",
          g and g[0][0] == "Top Hit" and g[-1][0] in ("Web", "Ask Prime"),
          " / ".join(dict.fromkeys(s for s, _ in g)))

    recents = load_recent()
    check("recent files parsed", isinstance(recents, list), f"{len(recents)} entries")
    check("Recent hides scratch and hidden-folder files",
          not wanted_recent("/tmp/x.png") and not wanted_recent("/var/tmp/a/b")
          and not wanted_recent("/home/alex/.claude/worktrees/w/file.py")
          and not wanted_recent("/home/alex/.cache/thumb.png")
          and wanted_recent("/home/alex/Documents/Essay.docx") and wanted_recent("/home/alex/.bashrc"))
    check("selected text is not drawn in the accent", "#search selection" in CSS
          and "@ACCENT@" not in CSS.split("#search selection", 1)[1].split("}", 1)[0])

    if Gtk.init_check(sys.argv)[0]:
        install_css()
        win = Spotlight(show=False, offscreen=True)
        win.entry.set_text(first[:4])
        win.render(results_for(first[:4], win.apps, win.recents))
        check("window builds: search field, grouped rows, top hit selected",
              win.get_name() == "prime-spotlight"
              and win.entry.get_placeholder_text().startswith("Search apps")
              and win.listbox.get_selected_row() is not None
              and win.listbox.get_selected_row().section == "Top Hit")
        names = [r.get_accessible().get_name() for r in win.listbox.get_children()]
        check("search field and every result have an accessible name",
              win.entry.get_accessible().get_name() == "Spotlight search" and all(names), str(names[:3]))
        check("nothing was mapped (no window on screen)",
              not win.get_mapped() and not win.get_visible(), "built but never shown, then destroyed")
        win.destroy()
    else:
        print("  SKIP  window build — no display here (the logic above is what runs)")
        prov = Gtk.CssProvider()
        try:
            prov.load_from_data(css_bytes())
            check("stylesheet parses", True)
        except GLib.Error as e:
            check("stylesheet parses", False, str(e))

    print(f"\n{len(fails)} failure(s)")
    return 1 if fails else 0


def main() -> int:
    ap = argparse.ArgumentParser(prog="prime-spotlight")
    ap.add_argument("--selftest", action="store_true", help="verify everything, map nothing")
    ap.add_argument("--query", help="print the list for a query, headless")
    ap.add_argument("--screenshot", metavar="PNG", help="render the window with --query to a PNG")
    ap.add_argument("--seconds", type=float, default=0, help="auto-close after N seconds")
    ap.add_argument("--prefill", default="", help="open with this text already typed")
    a = ap.parse_args()

    if a.selftest:
        return selftest()
    if a.screenshot:
        return screenshot(a.screenshot, a.query or "")
    if a.query is not None:
        return run_query(a.query)

    # one box at a time: pressing the key again replaces the open one
    for pid in subprocess.run(["pgrep", "-f", "prime-[s]potlight( --prefill .*)?$"], capture_output=True,
                              text=True).stdout.split():
        if int(pid) != os.getpid():
            try:
                os.kill(int(pid), 15)
            except OSError:
                pass

    install_css()
    started = time.monotonic()
    win = Spotlight()
    if a.prefill:
        win.entry.set_text(a.prefill)
        win.entry.set_position(-1)
    if a.seconds:
        GLib.timeout_add(int(a.seconds * 1000), lambda: (win.hide_now(), False)[1])
    Gtk.main()
    print(f"closed after {time.monotonic() - started:.1f}s", flush=True)
    return 0


if __name__ == "__main__":
    if not os.environ.get("WAYLAND_DISPLAY") and os.environ.get("PRIME_SPOTLIGHT_STRICT"):
        sys.exit("prime-spotlight: no WAYLAND_DISPLAY")
    sys.exit(main())
