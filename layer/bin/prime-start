#!/usr/bin/python3
"""Prime Start — the start menu on the P logo (click the logo, or Super+X).

A frosted card that drops out of the top-left corner, under the bar, on the
monitor you are using:

  * a search field — type and the apps filter live; Enter opens the top match,
    and when nothing matches the text goes on to Prime Search;
  * Pinned — six to a row; right-click an app to pin or unpin it
    (~/.config/prime/pinned, one app id per line);
  * All apps › — every app, A to Z;
  * Recent — the last files you opened;
  * your name, and buttons for Settings, Lock and Power.

Esc, a click anywhere outside, or the logo again closes it.

  prime-start                    open it (or close it if it is open)
  prime-start --selftest         check pins, search, recents and the window; map nothing
  prime-start --screenshot F     render the card to a PNG (needs a display)
     [--query Q] [--all]         … with something typed, or the All apps page
"""
from __future__ import annotations

import argparse
import json
import os
import re
import signal
import subprocess
import sys
import time

sys.dont_write_bytecode = True            # nothing cached inside the layer
import importlib.machinery  # noqa: E402
import importlib.util  # noqa: E402

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GLib, Gtk, Pango  # noqa: E402

try:
    gi.require_version("GtkLayerShell", "0.1")
    from gi.repository import GtkLayerShell
    HAVE_LAYER = True
except (ValueError, ImportError):
    GtkLayerShell = None
    HAVE_LAYER = False

BIN = os.path.dirname(os.path.realpath(__file__))
LAYER = os.path.realpath(os.path.join(BIN, ".."))
HOME = os.path.expanduser("~")
PINNED = os.path.join(HOME, ".config/prime/pinned")
IDENTITY = os.path.join(HOME, ".config/prime/identity.yaml")
MENU_JSON = os.path.join(LAYER, "default/menu.json")
COLUMNS, WIDTH, BAR_GAP = 6, 640, 6

# Prime Search owns the app list, the icons and the Recent list: load its module
# instead of keeping a second copy that would drift.
_loader = importlib.machinery.SourceFileLoader("prime_spotlight", os.path.join(BIN, "prime-spotlight"))
spot = importlib.util.module_from_spec(importlib.util.spec_from_loader("prime_spotlight", _loader))
_loader.exec_module(spot)


def private_dir(d: str) -> bool:
    """d is a real directory, ours, and nobody else can get in (mode 700)."""
    import stat
    try:
        st = os.lstat(d)
    except OSError:
        return False
    return stat.S_ISDIR(st.st_mode) and st.st_uid == os.getuid() and stat.S_IMODE(st.st_mode) == 0o700


def runtime_dir() -> str:
    d = os.environ.get("XDG_RUNTIME_DIR", "")
    if d and os.access(d, os.W_OK):
        return d
    # the fallback must be ours and private: another account could pre-create it and
    # plant a symlink where the pid file is written (same rule as prime-bar)
    d = f"/tmp/prime-{os.getuid()}"
    try:
        os.makedirs(d, mode=0o700, exist_ok=True)
    except OSError:
        pass
    if private_dir(d):
        return d
    import tempfile
    return tempfile.mkdtemp(prefix="prime-start-")


# Plain names for apps whose own name is a brand or a project name
FRIENDLY = {"kitty": "Terminal", "org.gnome.Software": "App Store"}

PIDFILE = os.path.join(runtime_dir(), "prime-start.pid")

# Sizes in rem: they follow the system font (Theme → Text size).
