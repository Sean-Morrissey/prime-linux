        else:
            missing(g, "Bluetooth")
        return page

    def p_sound(win):
        page = Adw.PreferencesPage()
        if not has("wpctl"):
            missing(group(page, "Sound"), "Sound")
            return page
        g = group(page, "Output", "Where sound plays")
        outs, out_default = audio_devices("Sinks")
        if outs:
            choice(win, g, "Play sound through", "Speakers, headphones, the screen's speakers…",
                   [(n, i) for i, n in outs], out_default,
                   lambda i: done(ok("wpctl", "set-default", i), "Sound now plays there"))
        v = sh("wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@")
        m = re.search(r"Volume:\s*([0-9.]+)", v)
        slider(win, g, "Volume", "", 0, 150, 1, round(float(m.group(1)) * 100) if m else 50,
               lambda x: done(ok("wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{x / 100:.2f}"), ""),
               fmt=lambda x: f"{x:.0f}%")
        switch(win, g, "Mute", "Silence everything", "[MUTED]" in v,
               lambda on: done(ok("wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "1" if on else "0"),
                               "Muted" if on else "Sound is on"))
        gi_ = group(page, "Input", "The microphone apps hear")
        ins, in_default = audio_devices("Sources")
        if ins:
            choice(win, gi_, "Microphone", "", [(n, i) for i, n in ins], in_default,
                   lambda i: done(ok("wpctl", "set-default", i), "Microphone changed"))
        mv = sh("wpctl", "get-volume", "@DEFAULT_AUDIO_SOURCE@")
        mm = re.search(r"Volume:\s*([0-9.]+)", mv)
        slider(win, gi_, "Microphone level", "How loud you are to others", 0, 150, 1,
               round(float(mm.group(1)) * 100) if mm else 100,
               lambda x: done(ok("wpctl", "set-volume", "@DEFAULT_AUDIO_SOURCE@", f"{x / 100:.2f}"), ""),
               fmt=lambda x: f"{x:.0f}%")
        switch(win, gi_, "Microphone off", "Nobody can hear you until you switch it back", "[MUTED]" in mv,
               lambda on: done(ok("wpctl", "set-mute", "@DEFAULT_AUDIO_SOURCE@", "1" if on else "0"),
                               "Microphone off" if on else "Microphone on"))
        ga = group(page, "Apps playing sound", "Each app's own volume")
        streams = app_streams()
        for idx, name, vol in streams:
            slider(win, ga, name, "", 0, 150, 1, vol,
                   lambda x, idx=idx: done(ok("pactl", "set-sink-input-volume", str(idx), f"{x:.0f}%"), ""),
                   fmt=lambda x: f"{x:.0f}%")
        if not streams:
            info(ga, "Nothing is playing right now", "Apps show up here while they play sound")
        g3 = group(page, "More")
        opener(g3, "Advanced mixer", "Every device, profile and stream", ["pavucontrol"])
        return page

    def keep_or_revert(win, name, new_line, old_line):
        """Like a Mac: a new screen setting is tried at once and goes back by itself in 15 s
        unless you keep it — a mode the screen can't show never leaves you stuck."""
        if os.environ.get("PRIME_SETTINGS_DRY"):
            print("MONITOR", new_line, flush=True)
            return True, ""
        if not ok(HYPRCTL, "keyword", "monitor", new_line):
            return False, "The screen didn't accept that — nothing changed"
        state = {"left": 15, "done": False}
        Dialog = getattr(Adw, "AlertDialog", None) or Adw.MessageDialog
        d = Dialog(heading="Keep these display settings?", body="Going back in 15 seconds…")
        d.add_response("revert", "Go back")
        d.add_response("keep", "Keep")
        d.set_response_appearance("keep", Adw.ResponseAppearance.SUGGESTED)
        d.set_default_response("keep")
        d.set_close_response("revert")

        def finish(keep):
            if state["done"]:
                return
            state["done"] = True
            if keep:
                save_monitor(name, new_line)
                win.toast("Saved — it stays like this")
            else:
                ok(HYPRCTL, "keyword", "monitor", old_line)
                win.toast("Back to how it was")
            GLib.timeout_add(300, lambda: win.refresh() and False)

        def countdown():
            if state["done"]:
                return False
            state["left"] -= 1
            if state["left"] <= 0:
                finish(False)
                (d.force_close() if hasattr(d, "force_close") else d.close())
                return False
            d.set_body(f"Going back in {state['left']} seconds…")
            return True
        d.connect("response", lambda _d, r: finish(r == "keep"))
        GLib.timeout_add_seconds(1, countdown)
        if Dialog is getattr(Adw, "AlertDialog", None):
            d.present(win)
        else:
            d.set_transient_for(win)
            d.present()
        return True, ""

    def p_display(win):
        page = Adw.PreferencesPage()
        mons = monitors()
        for mo in mons:
            name = mo.get("name", "")
            desc = (mo.get("description") or name or "Screen").split(" 0x")[0]
            g = group(page, desc, f"{name} · now {mo.get('width')} × {mo.get('height')} at "
                                  f"{round(mo.get('refreshRate', 0))} Hz, {round(mo.get('scale', 1) * 100)}%")
            cur_mode, scale, x, y = current_mode(mo), float(mo.get("scale", 1)), mo.get("x", 0), mo.get("y", 0)
            old = monitor_line(name, cur_mode, x, y, scale)
            modes = modes_of(mo)
            if modes:
                choice(win, g, "Resolution and refresh rate", "Highest first — the best your screen can do is at the top",
                       modes, cur_mode,
                       lambda m, name=name, x=x, y=y, scale=scale, old=old:
                       keep_or_revert(win, name, monitor_line(name, m, x, y, scale), old))
            choice(win, g, "Size of everything (scale)", "Bigger makes text and windows larger on a sharp screen",
                   SCALES, min((v for _l, v in SCALES), key=lambda v: abs(v - scale)),
                   lambda sc, name=name, cur_mode=cur_mode, x=x, y=y, old=old:
                   keep_or_revert(win, name, monitor_line(name, cur_mode, x, y, sc), old))
            choice(win, g, "Adaptive sync (FreeSync)", "Smooth games and video without tearing — needs a screen that has it",
                   VRR_MODES, 1 if mo.get("vrr") else 0,
                   lambda v, name=name, cur_mode=cur_mode, x=x, y=y, scale=scale, old=old:
                   keep_or_revert(win, name, monitor_line(name, cur_mode, x, y, scale, v), old))
        if not mons:
            info(group(page, "Screens"), "Screens", "Shown here while you're on the Prime desktop")
        ga = group(page, "Arrangement")
        opener(ga, "Arrange screens", "Drag screens into place, and pick which one is on the left", ["nwg-displays"], "Arrange")
        g2 = group(page, "Comfort")
        if has("brightnessctl") and sh("brightnessctl", "-m", "-c", "backlight", "info"):
            cur = sh("brightnessctl", "-m", "-c", "backlight", "info").split(",")
            pct = int(cur[3].rstrip("%")) if len(cur) > 3 and cur[3].rstrip("%").isdigit() else 50
            slider(win, g2, "Brightness", "", 5, 100, 1, pct,
                   lambda x: done(ok("brightnessctl", "-c", "backlight", "set", f"{x:.0f}%"), ""),
                   fmt=lambda x: f"{x:.0f}%")
        st = managed()
        switch(win, g2, "Night light", "Warmer colours in the evening, easier on the eyes",
               st.get("night_light", "off") != "off", lambda on: tb("night_light", "on" if on else "off"))
        g3 = group(page, "Screenshots", "Print Screen or Super+Shift+S: the picture is saved in Pictures › Screenshots "
                   "and copied, straight away")
        after = [("Show what I can do next (Edit, Show, Delete…)", "buttons"), ("Just save and copy it", "save")]
        if "ai" in enabled_addons():
            after.insert(1, ("Ask Prime about it", "ask"))
            after[0] = ("Show what I can do next (Edit, Ask Prime…)", "buttons")
        choice(win, g3, "After a screenshot", "", after, st.get("after_screenshot", "buttons"),
               lambda v: tb("after_screenshot", v))
        opener(g3, "Take a screenshot now", "Drag over the part you want", ["prime-snip", "area"], "Take")
        g4 = group(page, "Recording and colours")
        opener(g4, "Record part of the screen", "Super+Shift+R; press it again to stop", ["prime-record", "area"], "Record")
        opener(g4, "Record the whole screen with sound", "Super+Ctrl+Shift+R", ["prime-record", "screen", "--sound"], "Record")
        opener(g4, "Pick a colour from the screen", "Copies its code (Super+Shift+C)", ["prime-colour"], "Pick")
        return page

