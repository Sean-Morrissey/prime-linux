            if "hidden by Prime" in text:
                continue
            name = (re.search(r"^Name=(.*)$", text, re.M) or [None, f[:-8]])[1]
            hidden = re.search(r"^Hidden=true", text, re.M) is not None

            def flip(on, path=path):
                t = read(path)
                t = re.sub(r"^Hidden=.*\n?", "", t, flags=re.M).rstrip("\n") + ("\n" if on else "\nHidden=true\n")
                try:
                    open(path, "w").write(t)
                    return True, "Saved — it applies from your next login"
                except OSError:
                    return False, "Couldn't change that file"
            switch(win, g3, name, f, not hidden, flip)
            shown += 1
        if not shown:
            info(g3, "Nothing extra starts with the computer", "Apps you set to start by themselves show up here")
        for sec in registry():               # Coding, Creating, Studying… (Gaming and AI have their own pages)
            if sec.get("id") not in CORE_SECTIONS | {"gaming", "prime"}:
                pack_group(page, sec)
        return page

    def p_updates(win):
        page = Adw.PreferencesPage()
        g = group(page, "Updates")
        info(g, "Now", sh("prime-update-policy", "describe") or "—", "software-update-available-symbolic")
        choice(win, g, "Install updates", "A snapshot is taken first, so an update can always be undone",
               POLICIES, sh("prime-update-policy", "get"),
               lambda p: done(ok("prime-update-policy", "set", p, timeout=120), "Saved", "Not changed (the password was cancelled?)"))
        g2 = group(page, "Now")
        opener(g2, "Update everything", "The system, apps and Prime", ["prime-update"], "Update")
        opener(g2, "What's waiting", "Nothing changes until you choose to", ["prime-update", "--check"], "Show")
        opener(g2, "Undo the last update", "Go back to how things were before it", ["prime-update", "--undo"], "Undo")
        opener(g2, "System snapshots", "Every saved state of the system, newest first", ["prime-snapshots"], "Show")
        return page

    def p_security(win):
        page = Adw.PreferencesPage()
        g = group(page, "Safety check", "What protects this computer, in plain words")
        rows = [l.split("\t") for l in sh("prime-security", "status", "--tsv", timeout=20).splitlines() if "\t" in l]
        icons = {"ok": "emblem-ok-symbolic", "warn": "dialog-warning-symbolic", "bad": "dialog-error-symbolic",
                 "info": "dialog-information-symbolic"}
        words = {"ok": "OK", "warn": "Worth a look", "bad": "Needs you", "info": "Note"}
        for r in rows:
            lvl, msg = r[0], r[1]
            fix = r[2] if len(r) > 2 else ""
            row = info(g, msg, f"{words.get(lvl, '')}{' — ' + fix if fix else ''}", icons.get(lvl))
            row.update_property([Gtk.AccessibleProperty.DESCRIPTION], [words.get(lvl, "")])
        if not rows:
            info(g, "Safety check", "Couldn't read it right now")
        g2 = group(page, "More")
        opener(g2, "Full security check", "With the fix for anything that needs you",
               ["prime-panel", "--title", "Security check", "--", os.path.join(BIN, "prime-security"), "status"], "Open")
        opener(g2, "Get a file back", "File History", ["prime-file-history"], "Open")
        return page

    def p_printers(win):
        page = Adw.PreferencesPage()
        if not has("lpstat"):
            missing(group(page, "Printers"), "Printing")
            return page
        g = group(page, "Your printers")
        names, default = printers()

        def quick(good, yes):
            win.toast(yes if good else "That didn't work — try again")
            win.refresh()
        test_page = next((f for f in ("/usr/share/cups/data/testprint", "/usr/share/cups/data/default-testpage.pdf")
                          if os.path.exists(f)), "")
        for n, ready in names:
            nice = n.replace("_", " ")
            btns = []
            if n != default:
                btns.append(("Make default", lambda n=n, nice=nice: quick(act("lpoptions", "-d", n)[0],
                                                                          f"{nice} is the default printer"), ""))
            if test_page:
                btns.append(("Test page", lambda n=n, nice=nice: background(win, lambda: act("lp", "-d", n, test_page),
                                                                            f"Test page sent to {nice}", f"{nice} didn't take it", False), ""))
            btns.append(("Remove", lambda n=n: launch("prime-printer", "remove", n), ""))
            buttons_row(g, nice, ("Default printer · " if n == default else "") + ("Ready" if ready else "Paused or not answering"),
                        btns, "printer-symbolic")
        if not names:
            info(g, "No printers yet", "Printers on your Wi-Fi show up below")

        gn = group(page, "Printers on your network", "Ones that need no driver — nearly every printer made in the last ten years. "
                   "Adding one asks for your password")
        state = {"shown": False}

        def look():
            def work():
                found = printers_nearby()
                def show():
                    for child in list(state.get("rows", [])):
                        gn.remove(child)
                    state["rows"] = []
                    for name, uri in found:
                        state["rows"].append(buttons_row(gn, name.replace("_", " "), uri.split("/")[2] if "//" in uri else uri,
                                                         [("Add", lambda name=name, uri=uri: launch("prime-printer", "add", name, uri), "suggested")],
                                                         "printer-network-symbolic"))
                    if not found:
                        state["rows"].append(info(gn, "None found", "Check the printer is on and on the same Wi-Fi; a USB printer: plug it in and look again"))
                    win.toast(f"Found {len(found)} printer(s)" if found else "No new printers found")
                    return False
                GLib.idle_add(show)
                return True, ""
            threading.Thread(target=work, daemon=True).start()
            win.toast("Looking for printers…")
        buttons_row(gn, "Look for printers", "Takes a few seconds", [("Look", look, "")])

        jobs = print_jobs()
        gq = group(page, "Printing now", "What is waiting to print")
        for job, prn in jobs:
            buttons_row(gq, prn.replace("_", " "), f"Job {job.rsplit('-', 1)[-1]}",
                        [("Cancel", lambda job=job: quick(act("cancel", job)[0], "Cancelled"), "")])
        if not jobs:
            info(gq, "Nothing waiting to print", "")
        g3 = group(page, "More")
        opener(g3, "Advanced printer settings", "A USB printer that needs a driver, paper and ink options — opens the system's own tool, "
               "which looks different and uses more technical words", ["system-config-printer"], "Open")
        return page

    def p_datetime(win):
        page = Adw.PreferencesPage()
        g = group(page, "Date & time")
        props = dict(l.split("=", 1) for l in sh("timedatectl", "show").splitlines() if "=" in l)
        info(g, "Time zone", props.get("Timezone", "—"), "preferences-system-time-symbolic")
        switch(win, g, "Set the time automatically", "From the internet, always exact",
               props.get("NTP", "no") == "yes",
               lambda on: done(ok("timedatectl", "set-ntp", "true" if on else "false", timeout=120), "Saved"))
        zones = sh("timedatectl", "list-timezones").splitlines()
        if zones:
            choice(win, g, "Change time zone", "Asks for your password", [(z.replace("_", " "), z) for z in zones],
                   props.get("Timezone", ""),
                   lambda z: done(ok("timedatectl", "set-timezone", z, timeout=120), f"Time zone: {z}"))
        g2 = group(page, "Timetable & reminders", "Your classes for the week, with a note before each one")
        nxt = sh("prime-timetable", "--next")
        info(g2, "Next today", nxt or "No more classes today")
        opener(g2, "Open Timetable", "Add your classes and reminders — or type “remind me to … at 5pm” in Prime Search",
               ["prime-timetable"], "Open")
        return page

    def p_region(win):
