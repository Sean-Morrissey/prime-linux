def gui(page: str = "", screenshots: str = "", selftest: bool = False) -> int:
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Adw, Gdk, Gio, GLib, Gtk

    CSS = """
    .settings-sidebar row { padding: 2px 0; }
    .page-intro { opacity: 0.75; }
    .big-number { font-size: 1.6em; font-weight: 700; }
    .bar-track { background: alpha(currentColor, 0.12); border-radius: 99px; min-height: 8px; }
    .bar-fill { background: @accent_bg_color; border-radius: 99px; min-height: 8px; }
    .bar-fill.warn { background: #f59e0b; }
    """

    class Settings(Adw.ApplicationWindow):
        def __init__(self, app):
            super().__init__(application=app, title="Settings")
            self.set_default_size(1000, 720)
            self.toasts = Adw.ToastOverlay()
            self.split = Adw.NavigationSplitView()
            self.split.set_min_sidebar_width(250)
            self.toasts.set_child(self.split)
            self.set_content(self.toasts)

            # sidebar: search + sections
            side = Adw.ToolbarView()
            hb = Adw.HeaderBar()
            hb.set_title_widget(Adw.WindowTitle(title="Settings", subtitle="Prime"))
            side.add_top_bar(hb)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            self.search = Gtk.SearchEntry(placeholder_text="Find a setting")
            self.search.set_margin_start(10)
            self.search.set_margin_end(10)
            self.search.update_property([Gtk.AccessibleProperty.LABEL], ["Find a setting"])
            self.search.connect("search-changed", lambda *_: self.list.invalidate_filter())
            self.search.connect("activate", self.open_first_match)
            box.append(self.search)
            self.list = Gtk.ListBox()
            self.list.add_css_class("navigation-sidebar")
            self.list.add_css_class("settings-sidebar")
            self.list.update_property([Gtk.AccessibleProperty.LABEL], ["Settings sections"])
            self.rows = {}
            for pid, title, icon, words in PAGES:
                row = Gtk.ListBoxRow()
                row.pid, row.words = pid, f"{title} {words}".lower()
                h = Gtk.Box(spacing=12, margin_top=6, margin_bottom=6, margin_start=6)
                h.append(Gtk.Image.new_from_icon_name(icon))
                h.append(Gtk.Label(label=title, xalign=0))
                row.set_child(h)
                row.update_property([Gtk.AccessibleProperty.LABEL], [title])
                self.list.append(row)
                self.rows[pid] = row
            self.list.set_filter_func(self.matches)
            self.list.connect("row-activated", lambda _l, r: self.show(r.pid))
            sc = Gtk.ScrolledWindow(vexpand=True)
            sc.set_child(self.list)
            box.append(sc)
            side.set_content(box)
            self.split.set_sidebar(Adw.NavigationPage(title="Settings", child=side))

            self.content_view = Adw.ToolbarView()
            self.content_bar = Adw.HeaderBar()
            self.content_view.add_top_bar(self.content_bar)
            self.content = Adw.NavigationPage(title="", child=self.content_view)
            self.split.set_content(self.content)
            self.built = {}
            self.live_rows = []                 # (row, fn): numbers that change, refreshed while shown
            GLib.timeout_add_seconds(2, self.tick)
            self.show(page if page in self.rows else "network")

        # sidebar search
        def matches(self, row) -> bool:
            q = self.search.get_text().strip().lower()
            return not q or all(w in row.words for w in q.split())

        def open_first_match(self, *_a):
            for pid, *_ in PAGES:
                if self.matches(self.rows[pid]):
                    self.list.select_row(self.rows[pid])
                    self.show(pid)
                    return

        def toast(self, text: str):
            self.toasts.add_toast(Adw.Toast(title=GLib.markup_escape_text(text), timeout=4))

        def tick(self) -> bool:
            for row, fn in list(self.live_rows):
                try:
                    row.set_subtitle(GLib.markup_escape_text(str(fn())))
                except Exception:                  # noqa: BLE001 — a sensor that went away just stops updating
                    pass
            return True

        def show(self, pid: str):
            self.live_rows = []
            title = next(t for p, t, *_ in PAGES if p == pid)
            try:
                page = BUILDERS[pid](self)
            except Exception as e:                     # noqa: BLE001 — one page never takes the window down
                page = Adw.PreferencesPage()
                g = Adw.PreferencesGroup(title="This page couldn't load")
                g.add(Adw.ActionRow(title=str(e)[:200], subtitle="About & Help → Get help makes a report you can send"))
                page.add(g)
            page.update_property([Gtk.AccessibleProperty.LABEL], [title])
            self.built[pid] = page
            self.content.set_title(title)
            self.content_view.set_content(page)
            self.list.select_row(self.rows[pid])
            self.split.set_show_content(True)

        def refresh(self):
            row = self.list.get_selected_row()
            if row is not None:
                self.show(row.pid)

    # ── row helpers ────────────────────────────────────────────────────────
    def group(page, title="", description=""):
        g = Adw.PreferencesGroup(title=GLib.markup_escape_text(title), description=GLib.markup_escape_text(description))
        page.add(g)
        return g

    def info(g, title, value, icon=None):
        r = Adw.ActionRow(title=GLib.markup_escape_text(title), subtitle=GLib.markup_escape_text(str(value or "—")))
        r.set_subtitle_selectable(True)
        if icon:
            r.add_prefix(Gtk.Image.new_from_icon_name(icon))
        g.add(r)
        return r

    def live(win, g, title, fn, icon=None):
        """A fact that changes (speed, temperature, memory): refreshed every 2 seconds."""
        try:
            first = fn()
        except Exception:                          # noqa: BLE001
            first = "—"
        r = info(g, title, first, icon)
        win.live_rows.append((r, fn))
        return r

    def opener(g, title, subtitle, cmd, label="Open"):
        r = Adw.ActionRow(title=GLib.markup_escape_text(title), subtitle=GLib.markup_escape_text(subtitle))
        b = Gtk.Button(label=label, valign=Gtk.Align.CENTER)
        b.update_property([Gtk.AccessibleProperty.LABEL], [f"{label}: {title}"])
        b.connect("clicked", lambda *_: launch(*cmd))
        r.add_suffix(b)
        r.set_activatable_widget(b)
        g.add(r)
        return r

    def goto(win, g, title, subtitle, pid, label="Open"):
        """A row that opens another page of this window."""
        r = Adw.ActionRow(title=GLib.markup_escape_text(title), subtitle=GLib.markup_escape_text(subtitle))
        b = Gtk.Button(label=label, valign=Gtk.Align.CENTER)
        b.update_property([Gtk.AccessibleProperty.LABEL], [f"{label}: {title}"])
        b.connect("clicked", lambda *_: GLib.idle_add(lambda: win.show(pid) and False))
        r.add_suffix(b)
        r.set_activatable_widget(b)
        g.add(r)
        return r

    def switch(win, g, title, subtitle, current, on_change):
        r = Adw.SwitchRow(title=GLib.markup_escape_text(title), subtitle=GLib.markup_escape_text(subtitle))
        r.set_active(bool(current))

        def changed(row, _p):
            ok_, msg = on_change(row.get_active())
            if msg:
                win.toast(msg)
            if not ok_:
                row.handler_block(hid)
                row.set_active(not row.get_active())
                row.handler_unblock(hid)
        hid = r.connect("notify::active", changed)
        g.add(r)
        return r

    def choice(win, g, title, subtitle, options, current, on_change):
        r = Adw.ComboRow(title=GLib.markup_escape_text(title), subtitle=GLib.markup_escape_text(subtitle))
        r.set_model(Gtk.StringList.new([lab for lab, _ in options]))
        values = [v for _, v in options]
        if current in values:
            r.set_selected(values.index(current))
        else:
            r.set_selected(Gtk.INVALID_LIST_POSITION)

        def changed(row, _p):
            i = row.get_selected()
            if 0 <= i < len(values):
                _ok, msg = on_change(values[i])
                if msg:
                    win.toast(msg)
        r.connect("notify::selected", changed)
        g.add(r)
        return r

    def slider(win, g, title, subtitle, lo, hi, step, value, on_done, fmt=lambda v: f"{v:.0f}"):
        r = Adw.ActionRow(title=GLib.markup_escape_text(title), subtitle=GLib.markup_escape_text(subtitle))
        s = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, step)
        s.set_value(value)
        s.set_size_request(260, -1)
        s.set_draw_value(True)
        s.set_format_value_func(lambda _s, v: fmt(v))
        s.update_property([Gtk.AccessibleProperty.LABEL], [title])
        pending = {"id": 0}

        def settle():
            pending["id"] = 0
            _ok, msg = on_done(s.get_value())
            if msg:
                win.toast(msg)
            return False

        def moved(*_a):   # apply once the hand stops moving, not on every pixel
            if pending["id"]:
                GLib.source_remove(pending["id"])
            pending["id"] = GLib.timeout_add(450, settle)
        s.connect("value-changed", moved)
        r.add_suffix(s)
        g.add(r)
        return r

    def usage_bar(g, title, used, total, warn_at=0.9):
        r = Adw.ActionRow(title=GLib.markup_escape_text(title),
                          subtitle=f"{gb(total - used)} free of {gb(total)}")
        frac = used / total if total else 0
        track = Gtk.Box(valign=Gtk.Align.CENTER)
        track.add_css_class("bar-track")
        track.set_size_request(220, 8)
        fill = Gtk.Box()
        fill.add_css_class("bar-fill")
        if frac >= warn_at:
            fill.add_css_class("warn")
        fill.set_size_request(max(4, int(220 * frac)), 8)
        track.append(fill)
        lab = Gtk.Label(label=f"{frac * 100:.0f}% used" + (" — almost full" if frac >= warn_at else ""))
        r.add_suffix(track)
        r.add_suffix(lab)
        r.update_property([Gtk.AccessibleProperty.DESCRIPTION], [f"{frac * 100:.0f} percent used" + (", almost full" if frac >= warn_at else "")])
        g.add(r)
        return r

    CORE_SECTIONS = {"apps", "settings", "toggles", "tools", "style", "update", "power", "about"}

    def registry() -> list:
        """Every row Prime knows (its own, each enabled pack's, your own menu.json)."""
        try:
            return json.loads(sh("prime-menu", "--json", timeout=8) or "{}").get("sections", [])
        except ValueError:
            return []

    def pack_group(page, sec, title="", skip=()):
        rows = [it for it in sec.get("items", []) if it.get("id") not in skip]
        if not rows:
            return None
        g = group(page, title or re.sub(r"^\W+", "", sec.get("label", "")).strip())
        for it in rows:
            opener(g, it.get("label", ""), it.get("hint", ""), ["prime-menu", "--run", it["id"]],
                   "Show" if it.get("kind") in ("panel", "term") else "Open")
        return g

    def missing(g, what):
        g.add(Adw.ActionRow(title=GLib.markup_escape_text(what), subtitle="Not on this computer"))

    def tb(setting, value):
        return toolbox("change_setting", {"setting": setting, "value": value})

    def pack(on, name, title):
        """Packs install in their own Prime window (it shows progress and asks for the password)."""
        launch("prime-panel", "--title", title, "--", os.path.join(BIN, "prime-addon"),
               "enable" if on else "disable", name)
        return True, "Working on it in its own window…"

    def done(flag, yes, no="That didn't change — try again, or Get help"):
        return (True, yes) if flag else (False, no)

    # ── pages ───────────────────────────────────────────────────────────────
    def p_network(win):
        page = Adw.PreferencesPage()
        g = group(page, "Wi-Fi")
        if has("nmcli"):
            radio = sh("nmcli", "-t", "-f", "WIFI", "radio")
            conn = sh("nmcli", "-t", "-f", "NAME,TYPE,DEVICE", "connection", "show", "--active")
            wifi_name = next((l.split(":")[0] for l in conn.splitlines() if ":802-11-wireless:" in l), "")
            wired = any(":802-3-ethernet:" in l for l in conn.splitlines())
            switch(win, g, "Wi-Fi", f"Connected to {wifi_name}" if wifi_name else "Not connected to a Wi-Fi network",
                   radio == "enabled", lambda on: done(ok("nmcli", "radio", "wifi", "on" if on else "off"),
                                                        f"Wi-Fi is {'on' if on else 'off'}"))
            opener(g, "Choose a network", "See the networks around you and join one", ["prime-wifi"], "Choose")
            g2 = group(page, "Connection")
            info(g2, "Cable (Ethernet)", "Connected" if wired else "Not connected")
            ip = sh("ip", "-4", "-brief", "address", "show", "scope", "global")
            info(g2, "This computer's address on the network", " · ".join(l.split()[2].split("/")[0] for l in ip.splitlines() if len(l.split()) > 2) or "none")
            g3 = group(page, "More")
            opener(g3, "Advanced network settings", "VPN, fixed address, hidden networks, hotspot — opens the system's own tool, which looks different and uses more technical words",
                   ["nm-connection-editor"])
        else:
            missing(g, "Network settings")
        return page

    def p_bluetooth(win):
        page = Adw.PreferencesPage()
        g = group(page, "Bluetooth")
        if has("bluetoothctl") and os.path.isdir("/sys/class/bluetooth") and os.listdir("/sys/class/bluetooth"):
            on = "Powered: yes" in sh("bluetoothctl", "show")
            switch(win, g, "Bluetooth", "Lets headphones, mice, speakers and phones connect", on,
                   lambda v: done(ok("bluetoothctl", "power", "on" if v else "off"), f"Bluetooth is {'on' if v else 'off'}"))
            devs = sh("bluetoothctl", "devices", "Connected")
            g2 = group(page, "Connected now")
            names = [l.split(" ", 2)[2] for l in devs.splitlines() if l.startswith("Device ") and len(l.split(" ", 2)) == 3]
            for n in names or ["Nothing connected"]:
                info(g2, n, "Connected" if names else "")
            g3 = group(page, "Devices")
            opener(g3, "Connect a device", "Your paired devices, one click to connect", ["prime-bluetooth"], "Connect")
            opener(g3, "Pair a new device", "Put the device in pairing mode first — opens the system's own Bluetooth tool", ["blueman-manager"], "Pair")
        else:
            missing(g, "Bluetooth")
        return page

    def p_sound(win):
        page = Adw.PreferencesPage()
        if not has("wpctl"):
            missing(group(page, "Sound"), "Sound")
            return page
        g = group(page, "Output", "Where sound plays")
        outs, out_default = audio_devices("Sinks")
        if outs:
            choice(win, g, "Play sound through", "Speakers, headphones, the screen's speakers…",
                   [(n, i) for i, n in outs], out_default,
                   lambda i: done(ok("wpctl", "set-default", i), "Sound now plays there"))
        v = sh("wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@")
        m = re.search(r"Volume:\s*([0-9.]+)", v)
        slider(win, g, "Volume", "", 0, 150, 1, round(float(m.group(1)) * 100) if m else 50,
               lambda x: done(ok("wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{x / 100:.2f}"), ""),
               fmt=lambda x: f"{x:.0f}%")
        switch(win, g, "Mute", "Silence everything", "[MUTED]" in v,
               lambda on: done(ok("wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "1" if on else "0"),
                               "Muted" if on else "Sound is on"))
        gi_ = group(page, "Input", "The microphone apps hear")
        ins, in_default = audio_devices("Sources")
        if ins:
            choice(win, gi_, "Microphone", "", [(n, i) for i, n in ins], in_default,
                   lambda i: done(ok("wpctl", "set-default", i), "Microphone changed"))
        mv = sh("wpctl", "get-volume", "@DEFAULT_AUDIO_SOURCE@")
        mm = re.search(r"Volume:\s*([0-9.]+)", mv)
        slider(win, gi_, "Microphone level", "How loud you are to others", 0, 150, 1,
               round(float(mm.group(1)) * 100) if mm else 100,
               lambda x: done(ok("wpctl", "set-volume", "@DEFAULT_AUDIO_SOURCE@", f"{x / 100:.2f}"), ""),
               fmt=lambda x: f"{x:.0f}%")
        switch(win, gi_, "Microphone off", "Nobody can hear you until you switch it back", "[MUTED]" in mv,
               lambda on: done(ok("wpctl", "set-mute", "@DEFAULT_AUDIO_SOURCE@", "1" if on else "0"),
                               "Microphone off" if on else "Microphone on"))
        ga = group(page, "Apps playing sound", "Each app's own volume")
        streams = app_streams()
        for idx, name, vol in streams:
            slider(win, ga, name, "", 0, 150, 1, vol,
                   lambda x, idx=idx: done(ok("pactl", "set-sink-input-volume", str(idx), f"{x:.0f}%"), ""),
                   fmt=lambda x: f"{x:.0f}%")
        if not streams:
            info(ga, "Nothing is playing right now", "Apps show up here while they play sound")
        g3 = group(page, "More")
        opener(g3, "Advanced mixer", "Every device, profile and stream — opens the system's own tool, which looks different and uses more technical words", ["pavucontrol"])
        return page

    def keep_or_revert(win, name, new_line, old_line):
        """Like a Mac: a new screen setting is tried at once and goes back by itself in 15 s
        unless you keep it — a mode the screen can't show never leaves you stuck."""
        if os.environ.get("PRIME_SETTINGS_DRY"):
            print("MONITOR", new_line, flush=True)
            return True, ""
        if not ok(HYPRCTL, "keyword", "monitor", new_line):
            return False, "The screen didn't accept that — nothing changed"
        state = {"left": 15, "done": False}
        Dialog = getattr(Adw, "AlertDialog", None) or Adw.MessageDialog
        d = Dialog(heading="Keep these display settings?", body="Going back in 15 seconds…")
        d.add_response("revert", "Go back")
        d.add_response("keep", "Keep")
        d.set_response_appearance("keep", Adw.ResponseAppearance.SUGGESTED)
        d.set_default_response("keep")
        d.set_close_response("revert")

        def finish(keep):
            if state["done"]:
                return
            state["done"] = True
            if keep:
                save_monitor(name, new_line)
                win.toast("Saved — it stays like this")
            else:
                ok(HYPRCTL, "keyword", "monitor", old_line)
                win.toast("Back to how it was")
            GLib.timeout_add(300, lambda: win.refresh() and False)

        def countdown():
            if state["done"]:
                return False
            state["left"] -= 1
            if state["left"] <= 0:
                finish(False)
                (d.force_close() if hasattr(d, "force_close") else d.close())
                return False
            d.set_body(f"Going back in {state['left']} seconds…")
            return True
        d.connect("response", lambda _d, r: finish(r == "keep"))
        GLib.timeout_add_seconds(1, countdown)
        if Dialog is getattr(Adw, "AlertDialog", None):
            d.present(win)
        else:
            d.set_transient_for(win)
            d.present()
        return True, ""

    def p_display(win):
        page = Adw.PreferencesPage()
        mons = monitors()
        for mo in mons:
            name = mo.get("name", "")
            desc = (mo.get("description") or name or "Screen").split(" 0x")[0]
            g = group(page, desc, f"{name} · now {mo.get('width')} × {mo.get('height')} at "
                                  f"{round(mo.get('refreshRate', 0))} Hz, {round(mo.get('scale', 1) * 100)}%")
            cur_mode, scale, x, y = current_mode(mo), float(mo.get("scale", 1)), mo.get("x", 0), mo.get("y", 0)
            old = monitor_line(name, cur_mode, x, y, scale)
            modes = modes_of(mo)
            if modes:
                choice(win, g, "Resolution and refresh rate", "Highest first — the best your screen can do is at the top",
                       modes, cur_mode,
                       lambda m, name=name, x=x, y=y, scale=scale, old=old:
                       keep_or_revert(win, name, monitor_line(name, m, x, y, scale), old))
            choice(win, g, "Size of everything (scale)", "Bigger makes text and windows larger on a sharp screen",
                   SCALES, min((v for _l, v in SCALES), key=lambda v: abs(v - scale)),
                   lambda sc, name=name, cur_mode=cur_mode, x=x, y=y, old=old:
                   keep_or_revert(win, name, monitor_line(name, cur_mode, x, y, sc), old))
            choice(win, g, "Adaptive sync (FreeSync)", "Smooth games and video without tearing — needs a screen that has it",
                   VRR_MODES, 1 if mo.get("vrr") else 0,
                   lambda v, name=name, cur_mode=cur_mode, x=x, y=y, scale=scale, old=old:
                   keep_or_revert(win, name, monitor_line(name, cur_mode, x, y, scale, v), old))
        if not mons:
            info(group(page, "Screens"), "Screens", "Shown here while you're on the Prime desktop")
        ga = group(page, "Arrangement")
        opener(ga, "Arrange screens", "Drag screens into place, and pick which one is on the left — opens the system's own screen tool", ["nwg-displays"], "Arrange")
        g2 = group(page, "Comfort")
        if has("brightnessctl") and sh("brightnessctl", "-m", "-c", "backlight", "info"):
            cur = sh("brightnessctl", "-m", "-c", "backlight", "info").split(",")
            pct = int(cur[3].rstrip("%")) if len(cur) > 3 and cur[3].rstrip("%").isdigit() else 50
            slider(win, g2, "Brightness", "", 5, 100, 1, pct,
                   lambda x: done(ok("brightnessctl", "-c", "backlight", "set", f"{x:.0f}%"), ""),
                   fmt=lambda x: f"{x:.0f}%")
        st = managed()
        switch(win, g2, "Night light", "Warmer colours in the evening, easier on the eyes",
               st.get("night_light", "off") != "off", lambda on: tb("night_light", "on" if on else "off"))
        g3 = group(page, "Screenshots", "Print Screen or Super+Shift+S: the picture is saved in Pictures › Screenshots "
                   "and copied, straight away")
        after = [("Show what I can do next (Edit, Show, Delete…)", "buttons"), ("Just save and copy it", "save")]
        if "ai" in enabled_addons():
            after.insert(1, ("Ask Prime about it", "ask"))
            after[0] = ("Show what I can do next (Edit, Ask Prime…)", "buttons")
        choice(win, g3, "After a screenshot", "", after, st.get("after_screenshot", "buttons"),
               lambda v: tb("after_screenshot", v))
        opener(g3, "Take a screenshot now", "Drag over the part you want", ["prime-snip", "area"], "Take")
        g4 = group(page, "Recording and colours")
        opener(g4, "Record part of the screen", "Super+Shift+R; press it again to stop", ["prime-record", "area"], "Record")
        opener(g4, "Record the whole screen with sound", "Super+Ctrl+Shift+R", ["prime-record", "screen", "--sound"], "Record")
        opener(g4, "Pick a colour from the screen", "Copies its code (Super+Shift+C)", ["prime-colour"], "Pick")
        return page

