    def p_apps(win):
        page = Adw.PreferencesPage()
        g = group(page, "Getting apps")
        opener(g, "App Store", "Install apps with a click", ["gnome-software"])
        opener(g, "Packs and add-ons", "Gaming, coding, creating, studying, the AI assistant", ["prime-addon", "pick"], "Choose")
        opener(g, "Make a website into an app", "WhatsApp, YouTube, Gmail… in their own windows", ["prime-webapp"], "Make")
        g2 = group(page, "Default apps")
        br = sh("xdg-settings", "get", "default-web-browser").removesuffix(".desktop")
        fm = sh("xdg-mime", "query", "default", "inode/directory").removesuffix(".desktop")
        info(g2, "Web browser", br or "not set")
        info(g2, "File manager", fm or "not set")
        opener(g2, "Change the default apps", "", ["prime-default-apps"], "Change")
        g3 = group(page, "Start with the computer", "Apps that open by themselves when you log in")
        auto = os.path.join(HOME, ".config/autostart")
        entries = sorted(f for f in os.listdir(auto) if f.endswith(".desktop")) if os.path.isdir(auto) else []
        shown = 0
        for f in entries:
            path = os.path.join(auto, f)
            text = read(path)
            if "hidden by Prime" in text:
                continue
            name = (re.search(r"^Name=(.*)$", text, re.M) or [None, f[:-8]])[1]
            hidden = re.search(r"^Hidden=true", text, re.M) is not None

            def flip(on, path=path):
                t = read(path)
                t = re.sub(r"^Hidden=.*\n?", "", t, flags=re.M).rstrip("\n") + ("\n" if on else "\nHidden=true\n")
                try:
                    open(path, "w").write(t)
                    return True, "Saved — it applies from your next login"
                except OSError:
                    return False, "Couldn't change that file"
            switch(win, g3, name, f, not hidden, flip)
            shown += 1
        if not shown:
            info(g3, "Nothing extra starts with the computer", "Apps you set to start by themselves show up here")
        for sec in registry():               # Coding, Creating, Studying… (Gaming and AI have their own pages)
            if sec.get("id") not in CORE_SECTIONS | {"gaming", "prime"}:
                pack_group(page, sec)
        return page

