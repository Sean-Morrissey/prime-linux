        g1 = group(page, "Right now", "Updates every 2 seconds")
        live(win, g1, "How busy", lambda: f"{cpu_info()['busy']}% — " + {True: "very busy", False: "fine"}[cpu_info()["busy"] >= 80])
        if l["ghz"]:
            live(win, g1, "Speed", lambda: f"{cpu_live()['ghz']:.2f} GHz on average across the cores")
        if l["temp"]:
            live(win, g1, "Temperature", lambda: cpu_live()["temp"] or "—")
        mem = memory()
        if mem["total"]:
            live(win, g1, "Memory in use", lambda: (lambda m: f"{gb(m['total'] - m['available'])} of {gb(m['total'])}")(memory()))
        if mem["swap_total"]:
            live(win, g1, "Overflow memory (swap)", lambda: (lambda m: f"{gb(m['swap_total'] - m['swap_free'])} of {gb(m['swap_total'])}")(memory()))
        g2 = group(page, "Speed and power")
        cur = sh("prime-power-profile", "current")
        if cur:
            choice(win, g2, "Power mode", "Performance runs the processor fastest; Battery saver lasts longest", POWER, cur,
                   lambda p: done(ok("prime-power-profile", p), "Power mode changed"))
        if l["driver"]:
            info(g2, "How it's tuned", f"{l['driver']} · {l['governor'] or '—'}" + (f" · {l['epp'].replace('_', ' ')}" if l["epp"] else ""))
        opener(g2, "What's using it", "Every app, busiest first — quit a stuck one (Ctrl+Shift+Esc)", ["prime-activity"])
        return page

    def gpu_name(card: str) -> str:
        addr = os.path.basename(os.path.realpath(f"/sys/class/drm/{card}/device"))
        line = sh("lspci", "-s", addr) if has("lspci") and re.fullmatch(r"[0-9a-f:.]+", addr) else ""
        name = re.sub(r"^\S+\s+[^:]+:\s*", "", line)
        return re.sub(r"\s*\(rev [0-9a-f]+\)$", "", name) or card

    def p_graphics(win):
        page = Adw.PreferencesPage()
        cards = gpu_cards()
        for gc in cards:
            card = gc["card"]
            g = group(page, gpu_name(card), f"driver: {gc['driver'] or 'not reported'}")

            def stat(key, card=card):
                return next((x for x in gpu_cards() if x["card"] == card), {}).get(key)
            if "busy" in gc:
                live(win, g, "How busy", lambda stat=stat: f"{stat('busy')}%", "video-display-symbolic")
            if "vram" in gc:
                live(win, g, "Video memory in use", lambda stat=stat: (lambda v: f"{gb(v[0])} of {gb(v[1])}")(stat("vram")))
            if "clock" in gc:
                live(win, g, "Speed", lambda stat=stat: f"{stat('clock')} MHz")
            if "temp" in gc:
                live(win, g, "Temperature", lambda stat=stat: f"{stat('temp')} °C")
            if "watts" in gc:
                live(win, g, "Power draw", lambda stat=stat: f"{stat('watts'):.0f} W")
            if gc.get("level"):
                info(g, "Power level", {"auto": "automatic (recommended)", "high": "always fastest",
                                         "low": "always slowest"}.get(gc["level"], gc["level"]))
        if not cards:
            for name, drv in gpus() or [("Graphics", "")]:
                info(group(page, name), "Driver", drv or "not reported")
        gs = group(page, "Games and video")
        st = managed()
        choice(win, gs, "Adaptive sync (FreeSync / G-Sync)", "Smooth motion without tearing, on screens that support it",
               VRR_MODES, int(st.get("vrr", 2)), lambda v: tb("vrr", {0: "off", 1: "always", 2: "fullscreen"}[v]))
        switch(win, gs, "Lowest delay in games (allow tearing)", "Games that ask for it skip a frame of waiting; "
               "you may see a faint line on very fast motion", st.get("game_tearing", "on") == "on",
               lambda on: tb("game_tearing", "on" if on else "off"))
        hw = read(os.path.join(HOME, ".config/hypr/hardware.conf"))
        m = re.search(r"LIBVA_DRIVER_NAME,(\S+)", hw)
        info(gs, "Hardware video decoding", f"on ({m.group(1)}) — videos play smoothly and save power" if m else "default")
        gd = group(page, "Drivers", "Updated with the rest of the system")
        info(gd, "Graphics driver (Mesa)", package_versions("mesa", "vulkan-radeon", "vulkan-intel", "nvidia-utils") or "—")
        info(gd, "Firmware", package_versions("linux-firmware") or "—")
        info(gd, "Kernel", sh("uname", "-r") or "—")
        if "gaming" in enabled_addons():
            opener(gd, "Game settings", "Steam, Proton, the FPS overlay, Performance mode", ["prime-system-settings", "--page", "gaming"], "Open")
        return page

