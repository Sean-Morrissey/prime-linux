#!/usr/bin/python3
"""Settings — everything about this computer, in one window (like System Settings on
a Mac or Settings on Windows). A sidebar of sections; each page shows what's set now
and changes it in place.

It doesn't reinvent anything: each control calls the Prime tool that already does
the job — the settings toolbox (prime-settings: backed up, logged and undoable),
prime-theme, prime-toggle, prime-update-policy, prime-addon, prime-security… — or
the system's own (nmcli, wpctl, bluetoothctl, timedatectl). Something the computer
doesn't have (no battery, no Bluetooth, no Wi-Fi card) shows as such, never as an
error.

  prime-system-settings                 open Settings
  prime-system-settings --page sound    open on one page (ids: --list-pages)
  prime-system-settings --list-pages    id, title and search words for every page
  prime-system-settings --selftest      build every page offscreen and check them
  prime-system-settings --screenshots DIR   one PNG per page (needs a display, e.g. Xvfb)
"""
from __future__ import annotations

import json
import os
import re
import shutil
import subprocess
import sys

BIN = os.path.dirname(os.path.realpath(__file__))
LAYER = os.path.realpath(os.path.join(BIN, ".."))
HOME = os.path.expanduser("~")
CFG = os.path.join(HOME, ".config/prime")
ACCENTS = [("Rose", "f87171"), ("Ember", "fb923c"), ("Amber", "fbbf24"), ("Emerald", "34d399"),
           ("Teal", "2dd4bf"), ("Sapphire", "60a5fa"), ("Amethyst", "c084fc"), ("Silver", "d4d4d8")]
TEXT_SIZES = [("Small", "small"), ("Default", "default"), ("Large", "large"), ("Larger", "larger")]
LOOKS = [("Rounded", "rounded"), ("Sharp", "sharp"), ("Compact", "compact"), ("Airy", "airy")]
POLICIES = [("Automatically, at night (recommended)", "automatic"), ("Ask me first", "ask"),
            ("Only security fixes", "security"), ("Never by itself", "off")]
POWER = [("Battery saver", "power-saver"), ("Balanced", "balanced"), ("Performance", "performance")]
AUTONOMY = [("Ask me first", "suggest"), ("Change my own settings by itself", "auto-user"),
            ("Also look after the system by itself", "auto-all")]


# ── talking to the computer (all of it safe to call when something is missing) ──

def has(cmd: str) -> bool:
    return shutil.which(cmd) is not None or os.access(os.path.join(BIN, cmd), os.X_OK)


def sh(*args, timeout: float = 4) -> str:
    """Run a command, return its output ('' if it isn't there or fails)."""
    cmd = list(args)
    if not shutil.which(cmd[0]) and os.access(os.path.join(BIN, cmd[0]), os.X_OK):
        cmd[0] = os.path.join(BIN, cmd[0])
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def ok(*args, timeout: float = 30) -> bool:
    cmd = list(args)
    if not shutil.which(cmd[0]) and os.access(os.path.join(BIN, cmd[0]), os.X_OK):
        cmd[0] = os.path.join(BIN, cmd[0])
    try:
        return subprocess.run(cmd, capture_output=True, timeout=timeout).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def launch(*args):
    """Open another window (a Prime tool or an app), fully detached."""
    cmd = list(args)
    if not shutil.which(cmd[0]) and os.access(os.path.join(BIN, cmd[0]), os.X_OK):
        cmd[0] = os.path.join(BIN, cmd[0])
    if os.environ.get("PRIME_SETTINGS_DRY"):
        print("LAUNCH", " ".join(cmd), flush=True)
        return
    try:
        subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def toolbox(tool: str, args: dict) -> tuple:
    """prime-settings run: every change is backed up, logged and undoable."""
    if os.environ.get("PRIME_SETTINGS_DRY"):
        print("TOOL", tool, json.dumps(args, sort_keys=True), flush=True)
        return True, "ok"
    out = sh("prime-settings", "run", tool, json.dumps(args), timeout=60)
    try:
        r = json.loads(out)
        return bool(r.get("ok")), r.get("message", "")
    except ValueError:
        return False, "That didn't work — Get help (About this computer) makes a report."


def managed() -> dict:
    """The settings Prime's toolbox already manages (what Settings shows as current)."""
    try:
        return json.load(open(os.path.join(CFG, "settings.json"))).get("settings", {})
    except (OSError, ValueError):
        return {}


def theme_conf() -> dict:
    out = {}
    try:
        for line in open(os.path.join(CFG, "theme.conf")):
            if "=" in line:
                k, v = line.strip().split("=", 1)
                out[k] = v.strip("'\"")
    except OSError:
        pass
    return out


def enabled_addons() -> set:
    try:
        return {l.strip() for l in open(os.path.join(CFG, "addons")) if l.strip() and not l.startswith("#")}
    except OSError:
        return set()


def gb(n_bytes: float) -> str:
    return f"{n_bytes / 1e9:.0f} GB" if n_bytes >= 10e9 else f"{n_bytes / 1e9:.1f} GB"


def read(path: str) -> str:
    try:
        return open(path).read().strip()
    except OSError:
        return ""


# ── the hardware, described in words ───────────────────────────────────────────

def cpu_info() -> dict:
    model, cores = "", os.cpu_count() or 0
    for line in read("/proc/cpuinfo").splitlines():
        if line.startswith("model name"):
            model = line.split(":", 1)[1].strip()
            break
    load = os.getloadavg()[0] if hasattr(os, "getloadavg") else 0.0
    busy = min(100, round(load / max(cores, 1) * 100))
    freq = read("/sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq")
    temp = ""
    for z in sorted(os.listdir("/sys/class/thermal")) if os.path.isdir("/sys/class/thermal") else []:
        if read(f"/sys/class/thermal/{z}/type") in ("x86_pkg_temp", "k10temp", "cpu-thermal", "acpitz"):
            t = read(f"/sys/class/thermal/{z}/temp")
            if t.isdigit():
                temp = f"{int(t) // 1000} °C"
                break
    return {"model": model or "unknown", "cores": cores, "busy": busy,
            "speed": f"{int(freq) / 1e6:.1f} GHz" if freq.isdigit() else "", "temp": temp}


def gpus() -> list:
    """[(name, driver)] for each graphics card."""
    out = []
    text = sh("lspci", "-k") if has("lspci") else ""
    blocks = re.split(r"\n(?=\S)", text)
    for b in blocks:
        first = b.splitlines()[0] if b else ""
        if re.search(r"VGA|3D|Display", first):
            name = re.sub(r"^\S+\s+[^:]+:\s*", "", first)
            name = re.sub(r"\s*\(rev [0-9a-f]+\)$", "", name)
            m = re.search(r"Kernel driver in use:\s*(\S+)", b)
            out.append((name, m.group(1) if m else ""))
    return out


def disks() -> list:
    """[(where, total, free)] for / and the home folder's disk (once if they're the same)."""
    out, seen = [], set()
    for label, path in (("System", "/"), ("Your files", HOME)):
        try:
            st = os.statvfs(path)
        except OSError:
            continue
        key = (st.f_blocks, st.f_bfree)
        if key in seen:
            continue
        seen.add(key)
        out.append((label, st.f_blocks * st.f_frsize, st.f_bavail * st.f_frsize))
    return out


def battery() -> dict:
    root = "/sys/class/power_supply"
    for b in sorted(os.listdir(root)) if os.path.isdir(root) else []:
        if read(f"{root}/{b}/type") == "Battery" and read(f"{root}/{b}/scope") != "Device":
            cap = read(f"{root}/{b}/capacity")
            full, design = read(f"{root}/{b}/energy_full"), read(f"{root}/{b}/energy_full_design")
            health = f"{round(int(full) * 100 / int(design))}%" if full.isdigit() and design.isdigit() and int(design) else ""
            return {"percent": cap, "status": read(f"{root}/{b}/status"), "health": health}
    return {}


# ── screens (hyprctl), saved in ~/.config/hypr/monitors.conf ──────────────────

MONITORS_CONF = os.path.join(HOME, ".config/hypr/monitors.conf")
HYPRCTL = "hyprctl"                         # the window manager's control command
SCALES = [("100%", 1.0), ("125%", 1.25), ("150%", 1.5), ("175%", 1.75), ("200%", 2.0)]
VRR_MODES = [("Off", 0), ("Always", 1), ("Full-screen games and video", 2)]


def monitors() -> list:
    try:
        return json.loads(sh("hyprctl", "monitors", "-j") or "[]")
    except ValueError:
        return []


def modes_of(mon: dict) -> list:
    """[(label, "WxH@R")] best first: highest resolution, then highest refresh rate."""
    seen, out = set(), []
    for m in mon.get("availableModes", []):
        mm = re.match(r"(\d+)x(\d+)@([\d.]+)Hz", m)
        if not mm:
            continue
        w, h, r = int(mm.group(1)), int(mm.group(2)), float(mm.group(3))
        key = (w, h, round(r))
        if key in seen:
            continue
        seen.add(key)
        out.append((w * h, r, f"{w} × {h} at {round(r)} Hz", f"{w}x{h}@{r:.2f}"))
    out.sort(key=lambda t: (-t[0], -t[1]))
    return [(lab, val) for _a, _b, lab, val in out]


def current_mode(mon: dict) -> str:
    return f"{mon.get('width')}x{mon.get('height')}@{float(mon.get('refreshRate', 60)):.2f}"


def monitor_line(name: str, mode: str, x: int, y: int, scale: float, vrr: int | None = None) -> str:
    """One Hyprland monitor rule: name, mode, position, scale[, vrr]."""
    line = f"{name}, {mode}, {int(x)}x{int(y)}, {scale:g}"
    if vrr is not None:
        line += f", vrr, {int(vrr)}"
    return line


def save_monitor(name: str, line: str, path: str = MONITORS_CONF) -> None:
    """Replace this screen's rule in monitors.conf (or add it); other screens stay as they are."""
    try:
        lines = open(path).read().splitlines()
    except OSError:
        lines = ["# Screens — Settings → Displays rewrites this file."]
    pat = re.compile(r"^\s*monitor\s*=\s*" + re.escape(name) + r"\s*,")
    out, done = [], False
    for ln in lines:
        if pat.match(ln):
            if not done:
                out.append(f"monitor = {line}")
                done = True
            continue
        out.append(ln)
    if not done:
        out.append(f"monitor = {line}")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".tmp", "w") as fh:
        fh.write("\n".join(out) + "\n")
    os.replace(path + ".tmp", path)


# ── sound (PipeWire) ─────────────────────────────────────────────────────────────

def audio_devices(kind: str) -> tuple:
    """([(id, name)], default id) for "Sinks" (speakers) or "Sources" (microphones)."""
    text = sh("wpctl", "status")
    out, default, section, in_audio = [], "", "", False
    for line in text.splitlines():
        clean = line.replace("│", " ").replace("├", " ").replace("└", " ").replace("─", " ")
        st = clean.strip()
        if st.startswith("Audio"):
            in_audio = True
        elif st.startswith("Video") or st.startswith("Settings"):
            in_audio = False
        if not in_audio:
            continue
        if st.endswith(":") and st[:-1] in ("Devices", "Sinks", "Sources", "Filters", "Streams"):
            section = st[:-1]
            continue
        if section != kind:
            continue
        m = re.match(r"(\*)?\s*(\d+)\.\s+(.*?)(\s*\[vol:.*)?$", st)
        if m:
            out.append((m.group(2), m.group(3).strip()))
            if m.group(1):
                default = m.group(2)
    return out, default


def app_streams() -> list:
    """[(index, app name, volume 0-150)] for every app playing sound right now."""
    try:
        data = json.loads(sh("pactl", "-f", "json", "list", "sink-inputs") or "[]")
    except ValueError:
        return []
    out = []
    for d in data:
        props = d.get("properties", {})
        name = props.get("application.name") or props.get("media.name") or "An app"
        vols = [int(str(v.get("value_percent", "100%")).rstrip("%")) for v in d.get("volume", {}).values()] or [100]
        out.append((d.get("index"), name, max(vols)))
    return out


# ── graphics cards and the processor, live ──────────────────────────────────────

SYS = os.environ.get("PRIME_SYS_ROOT", "")     # tests point this at a made-up /sys


def gpu_cards() -> list:
    """Every graphics card with its live numbers (where the driver reports them)."""
    out = []
    drm = f"{SYS}/sys/class/drm"
    for card in sorted(os.listdir(drm)) if os.path.isdir(drm) else []:
        if not re.fullmatch(r"card\d+", card):
            continue
        dev = f"{drm}/{card}/device"
        driver = os.path.basename(os.path.realpath(f"{dev}/driver")) if os.path.exists(f"{dev}/driver") else ""
        info = {"card": card, "driver": driver}
        vt, vu = read(f"{dev}/mem_info_vram_total"), read(f"{dev}/mem_info_vram_used")
        if vt.isdigit() and int(vt):
            info["vram"] = (int(vu) if vu.isdigit() else 0, int(vt))
        busy = read(f"{dev}/gpu_busy_percent")
        if busy.isdigit():
            info["busy"] = int(busy)
        for hw in sorted(os.listdir(f"{dev}/hwmon")) if os.path.isdir(f"{dev}/hwmon") else []:
            t = read(f"{dev}/hwmon/{hw}/temp1_input")
            if t.isdigit():
                info["temp"] = int(t) // 1000
            pw = read(f"{dev}/hwmon/{hw}/power1_average") or read(f"{dev}/hwmon/{hw}/power1_input")
            if pw.isdigit():
                info["watts"] = int(pw) / 1e6
        clk = re.search(r"(\d+)Mhz \*", read(f"{dev}/pp_dpm_sclk"))
        if clk:
            info["clock"] = int(clk.group(1))
        info["level"] = read(f"{dev}/power_dpm_force_performance_level")
        out.append(info)
    return out


def package_versions(*names) -> str:
    out = sh("pacman", "-Q", *names)
    return " · ".join(" ".join(l.split()[:2]) for l in out.splitlines() if l.strip())


def cpu_live() -> dict:
    """Speed now (average of every core), the most it can boost to, and how it's tuned."""
    base = f"{SYS}/sys/devices/system/cpu"
    freqs = []
    for c in os.listdir(base) if os.path.isdir(base) else []:
        f = read(f"{base}/{c}/cpufreq/scaling_cur_freq")
        if re.fullmatch(r"cpu\d+", c) and f.isdigit():
            freqs.append(int(f))
    mx = read(f"{base}/cpu0/cpufreq/cpuinfo_max_freq")
    temp = ""
    hwm = f"{SYS}/sys/class/hwmon"
    for hw in sorted(os.listdir(hwm)) if os.path.isdir(hwm) else []:
        if read(f"{hwm}/{hw}/name") in ("k10temp", "coretemp", "zenpower"):
            t = read(f"{hwm}/{hw}/temp1_input")
            if t.isdigit():
                temp = f"{int(t) // 1000} °C"
                break
    return {"ghz": (sum(freqs) / len(freqs) / 1e6) if freqs else 0.0,
            "max": int(mx) / 1e6 if mx.isdigit() else 0.0,
            "driver": read(f"{base}/cpu0/cpufreq/scaling_driver"),
            "governor": read(f"{base}/cpu0/cpufreq/scaling_governor"),
            "epp": read(f"{base}/cpu0/cpufreq/energy_performance_preference"),
            "temp": temp}


def memory() -> dict:
    m = {k: int(v.split()[0]) * 1024 for k, v in (l.split(":", 1) for l in read("/proc/meminfo").splitlines() if ":" in l)
         if v.split() and v.split()[0].isdigit()}
    return {"total": m.get("MemTotal", 0), "available": m.get("MemAvailable", 0),
            "swap_total": m.get("SwapTotal", 0), "swap_free": m.get("SwapFree", 0)}


