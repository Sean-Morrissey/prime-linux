    def p_startup(win):
        page = Adw.PreferencesPage()
        g3 = group(page, "Open by themselves when you log in", "Switch one off and it stays installed — it just doesn't start by itself")
        auto = os.path.join(HOME, ".config/autostart")
        entries = sorted(f for f in os.listdir(auto) if f.endswith(".desktop")) if os.path.isdir(auto) else []
        shown = 0
        for f in entries:
            path = os.path.join(auto, f)
            text = read(path)
            if "hidden by Prime" in text:
                continue
            name = (re.search(r"^Name=(.*)$", text, re.M) or [None, f[:-8]])[1]
            hidden = re.search(r"^Hidden=true", text, re.M) is not None

            def flip(on, path=path):
                t = read(path)
                t = re.sub(r"^Hidden=.*\n?", "", t, flags=re.M).rstrip("\n") + ("\n" if on else "\nHidden=true\n")
                try:
                    open(path, "w").write(t)
                    return True, "Saved — it applies from your next login"
                except OSError:
                    return False, "Couldn't change that file"
            switch(win, g3, name, "Starts when you log in", not hidden, flip)
            shown += 1
        if not shown:
            info(g3, "Nothing extra starts yet", "Add an app below")
        g4 = group(page, "Add an app")
        apps = installed_apps()
        if apps:
            def add(desktop_id):
                src = next((p for p in (os.path.join(HOME, ".local/share/applications", desktop_id),
                                        os.path.join("/usr/share/applications", desktop_id)) if os.path.exists(p)), "")
                if not src:
                    return False, "That app isn't installed any more"
                os.makedirs(auto, exist_ok=True)
                try:
                    shutil.copyfile(src, os.path.join(auto, desktop_id))
                except OSError:
                    return False, "Couldn't add it"
                GLib.idle_add(win.refresh)
                return True, "Added — it opens by itself from your next login"
            choice(win, g4, "Open this app when I log in", "Pick one", apps, None, add)
        return page

    def p_troubleshoot(win):
        page = Adw.PreferencesPage()
        g = group(page, "Something's not right?", "Each one fixes one thing and touches nothing else. Try the first one first")
        opener(g, "Check and fix the desktop", "Looks at everything and repairs what it safely can (Super+H)", ["prime-doctor"], "Check")
        g2 = group(page, "Quick fixes")
        opener(g2, "No sound", "Restart the sound system — playing apps come back in a second",
               ["sh", "-c", "systemctl --user restart wireplumber pipewire pipewire-pulse"], "Fix")
        opener(g2, "Wi-Fi won't connect", "Switch networking off and on again",
               ["sh", "-c", "nmcli networking off; sleep 2; nmcli networking on"], "Fix")
        opener(g2, "The top bar froze or vanished", "Start it again (Super+W)", ["prime-bar", "restart"], "Fix")
        opener(g2, "The dock is missing", "Start it again", ["sh", "-c", f"{SYSTEMCTL} --user reset-failed prime-dock; {SYSTEMCTL} --user restart prime-dock"], "Fix")
        opener(g2, "Notifications stopped", "Start the notification centre again",
               ["sh", "-c", f"{SYSTEMCTL} --user reset-failed swaync; {SYSTEMCTL} --user restart swaync"], "Fix")
        opener(g2, "Window title bars are gone", "Build them again for this version (about a minute)",
               ["prime-titlebars", "--rebuild"], "Fix")
        opener(g2, "The screen doesn't lock by itself", "Start the idle timer again", ["prime-idle", "--restart"], "Fix")
        opener(g2, "Performance mode doesn't work", "Turn power modes on (asks for your password)", ["prime-fix", "power-modes"], "Fix")
        opener(g2, "Something looks wrong after a change", "Reload the window settings", [HYPRCTL, "reload"], "Fix")
        g3 = group(page, "Go back")
        r = Adw.ActionRow(title="Undo the last change made in Settings", subtitle="Mouse, keyboard, look, dock, bar and the rest")
        b = Gtk.Button(label="Undo", valign=Gtk.Align.CENTER)
        b.connect("clicked", lambda *_: (win.toast(toolbox("undo_last", {})[1] or "Undone"), win.refresh()))
        r.add_suffix(b)
        g3.add(r)
        opener(g3, "Restore desktop settings", "Back to a copy saved before an update", ["prime-desktop-backup", "restore"], "Restore")
        opener(g3, "Save desktop settings now", "A copy you can restore later", ["prime-menu", "--run", "style.save"], "Save")
        opener(g3, "Undo the last update", "Go back to how the system was before it", ["prime-update", "--undo"], "Undo")
        opener(g3, "Get a file back", "File History", ["prime-file-history"], "Open")
        g5 = group(page, "Remove Prime", "Takes Prime off this account and puts back what was there before. "
                   "Your files are never touched; your Prime settings are kept in a backup folder")
        r = Adw.ActionRow(title="Remove Prime from this computer", subtitle="You'll be asked to confirm first")
        b = Gtk.Button(label="Remove…", valign=Gtk.Align.CENTER)
        b.add_css_class("destructive-action")
        b.update_property([Gtk.AccessibleProperty.LABEL], ["Remove Prime from this computer"])
        b.connect("clicked", lambda *_: remove_prime(win))
        r.add_suffix(b)
        g5.add(r)
        g4 = group(page, "Still stuck?")
        opener(g4, "Update Prime", "Fixes often arrive as updates", ["prime-panel", "--title", "Updating Prime", "--",
               os.path.join(BIN, "prime-update"), "--prime"], "Update")
        opener(g4, "Get help", "A report to send to whoever helps you — no passwords, no files", ["prime-help"], "Make")
        return page

    def remove_prime(win):
        Dialog = getattr(Adw, "AlertDialog", None) or Adw.MessageDialog
        d = Dialog(heading="Remove Prime?",
                   body="Prime's desktop, bar, dock and settings come off this account, and what was there "
                        "before comes back. Your documents, photos and other files stay exactly as they are.\n\n"
                        "The apps Prime installed can stay (other things may use them) or go too.")
        d.add_response("cancel", "Cancel")
        d.add_response("keep", "Remove Prime, keep the apps")
        d.add_response("all", "Remove Prime and its apps")
        d.set_response_appearance("keep", Adw.ResponseAppearance.DESTRUCTIVE)
        d.set_response_appearance("all", Adw.ResponseAppearance.DESTRUCTIVE)
        d.set_default_response("cancel")
        d.set_close_response("cancel")

        def chosen(_d, r):
            if r in ("keep", "all"):
                launch("prime-panel", "--title", "Removing Prime", "--", os.path.join(BIN, "prime-uninstall"),
                       "--yes", *(["--packages"] if r == "all" else []))
        d.connect("response", chosen)
        if Dialog is getattr(Adw, "AlertDialog", None):
            d.present(win)
        else:
            d.set_transient_for(win)
            d.present()

