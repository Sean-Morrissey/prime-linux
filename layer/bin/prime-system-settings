    def p_accounts(win):
        page = Adw.PreferencesPage()
        g = group(page, "You")
        name = ""
        m = re.search(r'^name:\s*"?([^"\n]*)"?', read(os.path.join(CFG, "identity.yaml")), re.M)
        if m:
            name = m.group(1).strip()
        info(g, "Name", name or os.environ.get("USER", ""), "avatar-default-symbolic")
        info(g, "Account", os.environ.get("USER", "") or os.path.basename(HOME))
        opener(g, "Set up my computer again", "Your name, look, packs and updates — the Welcome app", ["prime-welcome"], "Open")
        g2 = group(page, "Password")
        r = Adw.ActionRow(title="Change your password", subtitle="The one you log in and unlock with")
        b = Gtk.Button(label="Change", valign=Gtk.Align.CENTER)
        b.update_property([Gtk.AccessibleProperty.LABEL], ["Change your password"])
        b.connect("clicked", lambda *_: password_dialog(win))
        r.add_suffix(b)
        r.set_activatable_widget(b)
        g2.add(r)
        return page

    def password_dialog(win):
        d = Adw.Window(transient_for=win, modal=True, title="Change your password")
        d.set_default_size(420, -1)
        tv = Adw.ToolbarView()
        tv.add_top_bar(Adw.HeaderBar())
        pg = Adw.PreferencesPage()
        g = Adw.PreferencesGroup(description="Use the new one next time you log in or unlock the screen.")
        rows = [Adw.PasswordEntryRow(title=t) for t in ("Current password", "New password", "New password again")]
        for r in rows:
            g.add(r)
        msg = Gtk.Label(wrap=True, xalign=0, margin_top=8)
        g.add(msg)
        pg.add(g)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.append(pg)
        bt = Gtk.Button(label="Change password", halign=Gtk.Align.END, margin_end=16, margin_bottom=16)
        bt.add_css_class("suggested-action")
        box.append(bt)
        tv.set_content(box)
        d.set_content(tv)

        def go(*_a):
            text = "".join(r.get_text() + "\n" for r in rows)
            if os.environ.get("PRIME_SETTINGS_DRY"):
                print("TOOL prime-passwd (3 lines on stdin)", flush=True)
                good, out = True, "Password changed."
            else:
                try:
                    p = subprocess.run([os.path.join(BIN, "prime-passwd")], input=text, capture_output=True,
                                       text=True, timeout=60)
                    good, out = p.returncode == 0, p.stdout.strip()
                except (OSError, subprocess.TimeoutExpired):
                    good, out = False, "The password wasn't changed — try again."
            if good:
                win.toast(out)
                d.close()
            else:
                msg.set_text(out)
        bt.connect("clicked", go)
        rows[-1].connect("entry-activated", go)
        d.present()
        return d

    def p_accessibility(win):
        page = Adw.PreferencesPage()
        th, st = theme_conf(), managed()
        g = group(page, "Seeing")
        choice(win, g, "Text size", "Bar, menus, notifications, lock screen and apps", TEXT_SIZES,
               th.get("TEXT", "default"), lambda t: done(ok("prime-theme", "--set-text", t), "Text size changed"))
        switch(win, g, "Reduce motion", "No sliding or fading animations",
               st.get("animations", "on") == "off", lambda on: tb("animations", "off" if on else "on"))
        g2 = group(page, "Keyboard")
        opener(g2, "Use the bar from the keyboard", "Every bar item and its menu (Super+Alt+B)", ["prime-bar", "--keys"])
        opener(g2, "Every keyboard shortcut", "(Super+/)", ["prime-keys"], "Show")
        return page

    def p_about(win):
        page = Adw.PreferencesPage()
        g = group(page, "This computer")
        c = cpu_info()
        model = " ".join(x for x in (read("/sys/devices/virtual/dmi/id/sys_vendor"),
                                     read("/sys/devices/virtual/dmi/id/product_name")) if x)
        info(g, "Computer", model or "—", "computer-symbolic")
        info(g, "Processor", f"{c['model']} · {c['cores']} cores")
        info(g, "Graphics", " · ".join(n for n, _ in gpus()) or "—")
        mem = re.search(r"MemTotal:\s*(\d+)", read("/proc/meminfo"))
        info(g, "Memory", gb(int(mem.group(1)) * 1024) if mem else "—")
        os_name = re.search(r'^PRETTY_NAME="?([^"\n]*)', read("/etc/os-release"), re.M)
        info(g, "System", f"Prime on {os_name.group(1) if os_name else 'Linux'}")
        ver = sh("git", "-C", os.path.dirname(LAYER), "describe", "--tags", "--always")
        info(g, "Prime version", ver or "—")
        g2 = group(page, "Help")
        opener(g2, "Check and fix the desktop", "Repairs what it safely can (Super+H)", ["prime-doctor"], "Check")
        opener(g2, "Get help", "A report to send to whoever helps you — no passwords, no files", ["prime-help"], "Make")
        opener(g2, "Restore desktop settings", "Back to a copy saved before an update", ["prime-desktop-backup", "restore"], "Restore")
        r = Adw.ActionRow(title="Undo the last change made here", subtitle="Mouse, keyboard, look and the other saved settings")
        b = Gtk.Button(label="Undo", valign=Gtk.Align.CENTER)
        b.connect("clicked", lambda *_: (win.toast(toolbox("undo_last", {})[1] or "Undone"), win.refresh()))
        r.add_suffix(b)
        g2.add(r)
        opener(g2, "About Prime", "P.R.I.M.E — Please Relax I'll Manage Everything", ["prime-about"])
        g3 = group(page, "Repair")
        opener(g3, "Save desktop settings now", "A copy you can restore later", ["prime-menu", "--run", "style.save"], "Save")
        opener(g3, "Restart the bar", "If the bar froze or vanished (Super+W)", ["prime-bar", "restart"], "Restart")
        opener(g3, "Reload window settings", "After editing the settings file by hand", ["prime-menu", "--run", "style.reload"], "Reload")
        return page

    BUILDERS = {"network": p_network, "bluetooth": p_bluetooth, "sound": p_sound, "display": p_display,
                "appearance": p_appearance,
                "notifications": p_notifications, "power": p_power,
                "camera": p_camera, "mouse": p_mouse, "keyboard": p_keyboard, "processor": p_processor, "graphics": p_graphics,
                "storage": p_storage, "gaming": p_gaming, "assistant": p_assistant, "apps": p_apps,
                "updates": p_updates, "security": p_security, "printers": p_printers, "datetime": p_datetime, "region": p_region,
                "accounts": p_accounts, "accessibility": p_accessibility, "about": p_about}
    assert set(BUILDERS) == {p for p, *_ in PAGES}

    # ── run ─────────────────────────────────────────────────────────────────
    result = {"code": 0}

    def snap(win, path):
        w, h = win.get_width(), win.get_height()
        p = Gtk.WidgetPaintable.new(win)
        s = Gtk.Snapshot()
        p.snapshot(s, w, h)
        node = s.to_node()
        if node:
            win.get_renderer().render_texture(node, None).save_to_png(path)
            return True
        return False

    def run_selftest(win):
        fails = []
        for pid, title, *_ in PAGES:
            win.show(pid)
            page = win.built[pid]
            bad = isinstance(page, Adw.PreferencesPage) and "couldn't load" in str(
                [g.get_title() for g in _groups(page)])
            print(f"  {'FAIL' if bad else 'PASS'}  {title}")
            if bad:
                fails.append(pid)
        win.search.set_text("touchpad")
        visible = [pid for pid, *_ in PAGES if win.matches(win.rows[pid])]
        good = visible == ["mouse"]
        print(f"  {'PASS' if good else 'FAIL'}  search 'touchpad' finds Mouse & Touchpad — {visible}")
        if not good:
            fails.append("search")
        print(f"\n{len(fails)} failure(s)")
        result["code"] = 1 if fails else 0
        win.get_application().quit()

    def _groups(page):
        out, child = [], page.get_first_child()
        stack = [child]
        while stack:
            c = stack.pop()
            if c is None:
                continue
            if isinstance(c, Adw.PreferencesGroup):
                out.append(c)
            stack.append(c.get_first_child())
            stack.append(c.get_next_sibling())
        return out

    def run_screenshots(win, outdir):
        os.makedirs(outdir, exist_ok=True)
        order = [p for p, *_ in PAGES]

        def step(i, tries=0):
            if i >= len(order):
                win.get_application().quit()
                return False
            win.show(order[i])

            def take():
                if not snap(win, os.path.join(outdir, f"settings-{i + 1:02d}-{order[i]}.png")) and tries < 10:
                    GLib.timeout_add(200, step, i, tries + 1)
                    return False
                GLib.timeout_add(150, step, i + 1)
                return False
            GLib.timeout_add(500, take)
            return False
        GLib.timeout_add(700, step, 0)

    Adw.init()
    app = Adw.Application(application_id="org.primelinux.Settings",
                          flags=Gio.ApplicationFlags.NON_UNIQUE if (screenshots or selftest) else Gio.ApplicationFlags.DEFAULT_FLAGS)

    def activate(app_):
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        prov = Gtk.CssProvider()
        prov.load_from_string(CSS) if hasattr(prov, "load_from_string") else prov.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        # the exact accent and Prime's own surfaces, written by prime-theme (absent: libadwaita's)
        adw = os.path.join(CFG, "theme/adw.css")
        if os.path.exists(adw):
            theme = Gtk.CssProvider()
            theme.load_from_path(adw)
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), theme,
                                                      Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        win = app_.get_active_window() or Settings(app_)
        if page and page in win.rows:
            win.show(page)
        win.present()
        if selftest:
            GLib.timeout_add(300, lambda: run_selftest(win) and False)
        elif screenshots:
            run_screenshots(win, screenshots)
    app.connect("activate", activate)
    rc = app.run([sys.argv[0]])
    return result["code"] or rc


def main(argv: list) -> int:
    if "--list-pages" in argv:
        for pid, title, _icon, words in PAGES:
            print(f"{pid}\t{title}\t{words}")
        return 0
    page = argv[argv.index("--page") + 1] if "--page" in argv and argv.index("--page") + 1 < len(argv) else ""
    if page and page not in {p for p, *_ in PAGES}:
        print(f"no such page: {page} (see --list-pages)", file=sys.stderr)
        return 2
    shots = argv[argv.index("--screenshots") + 1] if "--screenshots" in argv else ""
    return gui(page=page, screenshots=shots, selftest="--selftest" in argv)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
