def monitors() -> list:
    try:
        return json.loads(sh("hyprctl", "monitors", "-j") or "[]")
    except ValueError:
        return []


def modes_of(mon: dict) -> list:
    """[(label, "WxH@R")] best first: highest resolution, then highest refresh rate."""
    seen, out = set(), []
    for m in mon.get("availableModes", []):
        mm = re.match(r"(\d+)x(\d+)@([\d.]+)Hz", m)
        if not mm:
            continue
        w, h, r = int(mm.group(1)), int(mm.group(2)), float(mm.group(3))
        key = (w, h, round(r))
        if key in seen:
            continue
        seen.add(key)
        out.append((w * h, r, f"{w} × {h} at {round(r)} Hz", f"{w}x{h}@{r:.2f}"))
    out.sort(key=lambda t: (-t[0], -t[1]))
    return [(lab, val) for _a, _b, lab, val in out]


def current_mode(mon: dict) -> str:
    return f"{mon.get('width')}x{mon.get('height')}@{float(mon.get('refreshRate', 60)):.2f}"


def monitor_line(name: str, mode: str, x: int, y: int, scale: float, vrr: int | None = None) -> str:
    """One Hyprland monitor rule: name, mode, position, scale[, vrr]."""
    line = f"{name}, {mode}, {int(x)}x{int(y)}, {scale:g}"
    if vrr is not None:
        line += f", vrr, {int(vrr)}"
    return line


def save_monitor(name: str, line: str, path: str = MONITORS_CONF) -> None:
    """Replace this screen's rule in monitors.conf (or add it); other screens stay as they are."""
    try:
        lines = open(path).read().splitlines()
    except OSError:
        lines = ["# Screens — Settings → Displays rewrites this file."]
    pat = re.compile(r"^\s*monitor\s*=\s*" + re.escape(name) + r"\s*,")
    out, done = [], False
    for ln in lines:
        if pat.match(ln):
            if not done:
                out.append(f"monitor = {line}")
                done = True
            continue
        out.append(ln)
    if not done:
        out.append(f"monitor = {line}")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".tmp", "w") as fh:
        fh.write("\n".join(out) + "\n")
    os.replace(path + ".tmp", path)


# ── sound (PipeWire) ─────────────────────────────────────────────────────────────

def audio_devices(kind: str) -> tuple:
    """([(id, name)], default id) for "Sinks" (speakers) or "Sources" (microphones)."""
    text = sh("wpctl", "status")
    out, default, section, in_audio = [], "", "", False
    for line in text.splitlines():
        clean = line.replace("│", " ").replace("├", " ").replace("└", " ").replace("─", " ")
        st = clean.strip()
        if st.startswith("Audio"):
            in_audio = True
        elif st.startswith("Video") or st.startswith("Settings"):
            in_audio = False
        if not in_audio:
            continue
        if st.endswith(":") and st[:-1] in ("Devices", "Sinks", "Sources", "Filters", "Streams"):
            section = st[:-1]
            continue
        if section != kind:
            continue
        m = re.match(r"(\*)?\s*(\d+)\.\s+(.*?)(\s*\[vol:.*)?$", st)
        if m:
            out.append((m.group(2), m.group(3).strip()))
            if m.group(1):
                default = m.group(2)
    return out, default


def app_streams() -> list:
    """[(index, app name, volume 0-150)] for every app playing sound right now."""
    try:
        data = json.loads(sh("pactl", "-f", "json", "list", "sink-inputs") or "[]")
    except ValueError:
        return []
    out = []
    for d in data:
        props = d.get("properties", {})
        name = props.get("application.name") or props.get("media.name") or "An app"
        vols = [int(str(v.get("value_percent", "100%")).rstrip("%")) for v in d.get("volume", {}).values()] or [100]
        out.append((d.get("index"), name, max(vols)))
    return out


def sink_names() -> dict:
    """{pactl sink index: (sink name, description)} — where an app's sound can go."""
    try:
        data = json.loads(sh("pactl", "-f", "json", "list", "sinks") or "[]")
    except ValueError:
        return {}
    return {d.get("index"): (d.get("name", ""), d.get("description") or d.get("name", "")) for d in data}


def stream_sinks() -> dict:
    """{app stream index: the sink index it plays through}."""
    try:
        data = json.loads(sh("pactl", "-f", "json", "list", "sink-inputs") or "[]")
    except ValueError:
        return {}
    return {d.get("index"): d.get("sink") for d in data}


def sound_cards() -> list:
    """[(card name, what it is, active profile, [(profile, words)])] — the modes each sound
    device can run in (HDMI or speakers, a headset's music or call mode, off)."""
    try:
        data = json.loads(sh("pactl", "-f", "json", "list", "cards") or "[]")
    except ValueError:
        return []
    out = []
    for c in data:
        profs = [(n, p.get("description") or n) for n, p in (c.get("profiles") or {}).items()
                 if p.get("available", True)]
        if len(profs) < 2:
            continue                       # nothing to choose
        desc = (c.get("properties") or {}).get("device.description") or c.get("name", "")
        out.append((c.get("name", ""), desc, c.get("active_profile", ""), profs))
    return out


def cameras() -> list:
    """[(device, name)] for each camera (one per camera: its first capture node)."""
    base = f"{SYS}/sys/class/video4linux"
    out = []
    try:
        names = sorted(os.listdir(base), key=lambda n: int(re.sub(r"\D", "", n) or 0))
    except OSError:
        return []
    for d in names:
        idx = read(os.path.join(base, d, "index"))
        if idx not in ("", "0"):
            continue                       # extra nodes of the same camera (metadata)
        out.append((f"/dev/{d}", read(os.path.join(base, d, "name")) or "Camera"))
    return out


def camera_users() -> list:
    """Names of the apps using a camera right now (the ones this account can see)."""
    users = set()
    for pid in os.listdir(f"{SYS}/proc") if os.path.isdir(f"{SYS}/proc") else []:
        if not pid.isdigit():
            continue
        fd = f"{SYS}/proc/{pid}/fd"
        try:
            links = [os.readlink(os.path.join(fd, f)) for f in os.listdir(fd)]
        except OSError:
            continue
        if any(re.fullmatch(r"/dev/video\d+", l) for l in links):
            users.add(read(f"{SYS}/proc/{pid}/comm") or pid)
    return sorted(users)


def nm_fields(line: str) -> list:
    """nmcli -t splits on ':' and escapes ':' and '\\' inside values."""
    return [f.replace("\\:", ":").replace("\\\\", "\\") for f in re.split(r"(?<!\\):", line)]


def nm_connections() -> list:
    """[(name, kind, active)] for saved connections: kind is wifi, vpn, wired or other."""
    kinds = {"802-11-wireless": "wifi", "vpn": "vpn", "wireguard": "vpn", "802-3-ethernet": "wired"}
    out = []
    for line in sh("nmcli", "-t", "-f", "NAME,TYPE,ACTIVE", "connection", "show").splitlines():
        f = nm_fields(line)
        if len(f) >= 3 and f[0]:
            out.append((f[0], kinds.get(f[1], "other"), f[2] == "yes"))
    return out


def vpn_file_type(path: str) -> str:
    """What kind of VPN file this is (nmcli import type), or "" if Prime can't tell."""
    low = path.lower()
    if low.endswith(".ovpn"):
        return "openvpn"
    if low.endswith(".conf"):
        try:
            text = open(path, errors="replace").read(20000)
        except OSError:
            return ""
        if "[Interface]" in text and "PrivateKey" in text:
            return "wireguard"
        if re.search(r"^\s*(remote|client)\b", text, re.M):
            return "openvpn"
    return ""


def printers() -> tuple:
    """([(name, ready?)], default name) from CUPS."""
    names = []
    for l in sh("lpstat", "-p").splitlines():
        m = re.match(r"printer (\S+) (.*)", l)
        if m:
            names.append((m.group(1), "disabled" not in m.group(2)))
    default = ""
    m = re.search(r":\s*(\S+)\s*$", sh("lpstat", "-d"))
    if m and "no system default" not in sh("lpstat", "-d"):
        default = m.group(1)
    return names, default


def print_jobs() -> list:
    """[(job id, printer)] waiting or printing."""
    out = []
    for l in sh("lpstat", "-o").splitlines():
        f = l.split()
        if f and "-" in f[0]:
            out.append((f[0], f[0].rsplit("-", 1)[0]))
    return out


def printers_nearby() -> list:
    """[(name, address)] for printers on the network that need no driver (nearly every
    printer made since 2012) and aren't added yet."""
    added = {n for n, _ in printers()[0]}
    out = []
    for uri in sh("driverless", timeout=20).splitlines():
        uri = uri.strip()
        if not uri.startswith(("ipp://", "ipps://")):
            continue
        m = re.match(r"ipps?://([^/:.]+)", uri)
        raw = urllib.parse.unquote(m.group(1)) if m else "Printer"
        name = re.sub(r"[^A-Za-z0-9_-]+", "_", raw).strip("_")[:60] or "Printer"
        if name not in added and all(name != n for n, _ in out):
            out.append((name, uri))
    return out


# ── graphics cards and the processor, live ──────────────────────────────────────

SYS = os.environ.get("PRIME_SYS_ROOT", "")     # tests point this at a made-up /sys


def gpu_cards() -> list:
    """Every graphics card with its live numbers (where the driver reports them)."""
    out = []
    drm = f"{SYS}/sys/class/drm"
    for card in sorted(os.listdir(drm)) if os.path.isdir(drm) else []:
        if not re.fullmatch(r"card\d+", card):
            continue
        dev = f"{drm}/{card}/device"
        driver = os.path.basename(os.path.realpath(f"{dev}/driver")) if os.path.exists(f"{dev}/driver") else ""
        info = {"card": card, "driver": driver}
        vt, vu = read(f"{dev}/mem_info_vram_total"), read(f"{dev}/mem_info_vram_used")
        if vt.isdigit() and int(vt):
            info["vram"] = (int(vu) if vu.isdigit() else 0, int(vt))
        busy = read(f"{dev}/gpu_busy_percent")
        if busy.isdigit():
            info["busy"] = int(busy)
        for hw in sorted(os.listdir(f"{dev}/hwmon")) if os.path.isdir(f"{dev}/hwmon") else []:
            t = read(f"{dev}/hwmon/{hw}/temp1_input")
            if t.isdigit():
                info["temp"] = int(t) // 1000
            pw = read(f"{dev}/hwmon/{hw}/power1_average") or read(f"{dev}/hwmon/{hw}/power1_input")
            if pw.isdigit():
                info["watts"] = int(pw) / 1e6
        clk = re.search(r"(\d+)Mhz \*", read(f"{dev}/pp_dpm_sclk"))
        if clk:
            info["clock"] = int(clk.group(1))
        info["level"] = read(f"{dev}/power_dpm_force_performance_level")
        out.append(info)
    return out


def package_versions(*names) -> str:
    out = sh("pacman", "-Q", *names)
    return " · ".join(" ".join(l.split()[:2]) for l in out.splitlines() if l.strip())


def cpu_live() -> dict:
    """Speed now (average of every core), the most it can boost to, and how it's tuned."""
    base = f"{SYS}/sys/devices/system/cpu"
    freqs = []
    for c in os.listdir(base) if os.path.isdir(base) else []:
        f = read(f"{base}/{c}/cpufreq/scaling_cur_freq")
        if re.fullmatch(r"cpu\d+", c) and f.isdigit():
            freqs.append(int(f))
    mx = read(f"{base}/cpu0/cpufreq/cpuinfo_max_freq")
    temp = ""
    hwm = f"{SYS}/sys/class/hwmon"
    for hw in sorted(os.listdir(hwm)) if os.path.isdir(hwm) else []:
        if read(f"{hwm}/{hw}/name") in ("k10temp", "coretemp", "zenpower"):
            t = read(f"{hwm}/{hw}/temp1_input")
            if t.isdigit():
                temp = f"{int(t) // 1000} °C"
                break
    return {"ghz": (sum(freqs) / len(freqs) / 1e6) if freqs else 0.0,
            "max": int(mx) / 1e6 if mx.isdigit() else 0.0,
            "driver": read(f"{base}/cpu0/cpufreq/scaling_driver"),
            "governor": read(f"{base}/cpu0/cpufreq/scaling_governor"),
            "epp": read(f"{base}/cpu0/cpufreq/energy_performance_preference"),
            "temp": temp}


def memory() -> dict:
    m = {k: int(v.split()[0]) * 1024 for k, v in (l.split(":", 1) for l in read("/proc/meminfo").splitlines() if ":" in l)
         if v.split() and v.split()[0].isdigit()}
    return {"total": m.get("MemTotal", 0), "available": m.get("MemAvailable", 0),
            "swap_total": m.get("SwapTotal", 0), "swap_free": m.get("SwapFree", 0)}


# ── the pages: id, title, icon, search words ──────────────────────────────────

PAGES = [
    ("network", "Wi-Fi & Network", "network-wireless-symbolic", "wifi internet wireless ethernet cable vpn wireguard openvpn hotspot share hidden saved forget ip"),
    ("bluetooth", "Bluetooth", "bluetooth-symbolic", "headphones mouse speaker pair devices"),
    ("sound", "Sound", "audio-volume-high-symbolic", "volume speakers headphones microphone mute output input hdmi headset mode per app mixer"),
    ("display", "Displays", "video-display-symbolic", "screen monitor resolution scale brightness night light refresh hz screenshot snip print capture"),
    ("appearance", "Appearance", "preferences-desktop-appearance-symbolic", "theme wallpaper background accent colour color dark text size corners animations window layout tiling tile float floating tidy"),
    ("notifications", "Notifications", "preferences-system-notifications-symbolic", "do not disturb alerts banners"),
    ("power", "Power & Battery", "battery-full-symbolic", "battery sleep performance power saver keep awake laptop"),
    ("camera", "Camera & Microphone", "camera-web-symbolic", "camera webcam microphone mic test check call video meeting zoom teams meet discord"),
    ("mouse", "Mouse & Touchpad", "input-mouse-symbolic", "pointer speed acceleration scrolling natural tap click left handed trackpad"),
    ("keyboard", "Keyboard", "input-keyboard-symbolic", "layout language repeat shortcuts keys typing"),
    ("processor", "Processor", "cpu-symbolic", "cpu cores speed temperature usage activity performance"),
    ("graphics", "Graphics", "video-display-symbolic", "gpu graphics card driver nvidia amd intel vram"),
    ("storage", "Storage", "drive-harddisk-symbolic", "disk space free full trash file history snapshots cleanup"),
    ("gaming", "Gaming", "input-gaming-symbolic", "steam games performance fps overlay mangohud gamemode proton"),
    ("assistant", "AI Assistant", "user-available-symbolic", "ai ask prime model chat assistant permissions autonomy"),
    ("apps", "Apps", "view-app-grid-symbolic", "default browser file manager startup autostart packs add-ons app store"),
    ("updates", "Updates", "software-update-available-symbolic", "update upgrade automatic nightly undo rollback snapshot"),
    ("security", "Privacy & Security", "security-high-symbolic", "firewall ssh remote login password encryption permissions"),
    ("printers", "Printers", "printer-symbolic", "print printer paper ink add default test page queue cancel"),
    ("datetime", "Date & Time", "preferences-system-time-symbolic", "clock time zone timezone date ntp timetable schedule classes lessons reminders"),
    ("region", "Language & Region", "preferences-desktop-locale-symbolic", "language locale region format"),
    ("accounts", "Users & Accounts", "system-users-symbolic", "account name password user login"),
    ("accessibility", "Accessibility", "preferences-desktop-accessibility-symbolic", "text size larger motion animations zoom contrast"),
    ("about", "About & Help", "help-about-symbolic", "about version computer specs help support repair health check report restore"),
]


def gui(page: str = "", screenshots: str = "", selftest: bool = False) -> int:
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Adw, Gdk, Gio, GLib, Gtk

    CSS = """
    .settings-sidebar row { padding: 2px 0; }
    .page-intro { opacity: 0.75; }
    .big-number { font-size: 1.6em; font-weight: 700; }
    .bar-track { background: alpha(currentColor, 0.12); border-radius: 99px; min-height: 8px; }
    .bar-fill { background: @accent_bg_color; border-radius: 99px; min-height: 8px; }
    .bar-fill.warn { background: #f59e0b; }
    """

    class Settings(Adw.ApplicationWindow):
        def __init__(self, app):
            super().__init__(application=app, title="Settings")
            self.set_default_size(1000, 720)
            self.toasts = Adw.ToastOverlay()
            self.split = Adw.NavigationSplitView()
            self.split.set_min_sidebar_width(250)
            self.toasts.set_child(self.split)
            self.set_content(self.toasts)

            # sidebar: search + sections
            side = Adw.ToolbarView()
            hb = Adw.HeaderBar()
            hb.set_title_widget(Adw.WindowTitle(title="Settings", subtitle="Prime"))
            side.add_top_bar(hb)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            self.search = Gtk.SearchEntry(placeholder_text="Find a setting")
            self.search.set_margin_start(10)
            self.search.set_margin_end(10)
            self.search.update_property([Gtk.AccessibleProperty.LABEL], ["Find a setting"])
            self.search.connect("search-changed", lambda *_: self.list.invalidate_filter())
            self.search.connect("activate", self.open_first_match)
            box.append(self.search)
            self.list = Gtk.ListBox()
            self.list.add_css_class("navigation-sidebar")
            self.list.add_css_class("settings-sidebar")
            self.list.update_property([Gtk.AccessibleProperty.LABEL], ["Settings sections"])
            self.rows = {}
            for pid, title, icon, words in PAGES:
                row = Gtk.ListBoxRow()
                row.pid, row.words = pid, f"{title} {words}".lower()
                h = Gtk.Box(spacing=12, margin_top=6, margin_bottom=6, margin_start=6)
                h.append(Gtk.Image.new_from_icon_name(icon))
                h.append(Gtk.Label(label=title, xalign=0))
                row.set_child(h)
                row.update_property([Gtk.AccessibleProperty.LABEL], [title])
                self.list.append(row)
                self.rows[pid] = row
            self.list.set_filter_func(self.matches)
            self.list.connect("row-activated", lambda _l, r: self.show(r.pid))
            sc = Gtk.ScrolledWindow(vexpand=True)
            sc.set_child(self.list)
            box.append(sc)
            side.set_content(box)
            self.split.set_sidebar(Adw.NavigationPage(title="Settings", child=side))

            self.content_view = Adw.ToolbarView()
            self.content_bar = Adw.HeaderBar()
            self.content_view.add_top_bar(self.content_bar)
            self.content = Adw.NavigationPage(title="", child=self.content_view)
            self.split.set_content(self.content)
            self.built = {}
            self.show(page if page in self.rows else "network")

        # sidebar search
        def matches(self, row) -> bool:
            q = self.search.get_text().strip().lower()
            return not q or all(w in row.words for w in q.split())

        def open_first_match(self, *_a):
            for pid, *_ in PAGES:
                if self.matches(self.rows[pid]):
                    self.list.select_row(self.rows[pid])
                    self.show(pid)
                    return

        def toast(self, text: str):
            self.toasts.add_toast(Adw.Toast(title=GLib.markup_escape_text(text), timeout=4))

        def show(self, pid: str):
            title = next(t for p, t, *_ in PAGES if p == pid)
            try:
                page = BUILDERS[pid](self)
            except Exception as e:                     # noqa: BLE001 — one page never takes the window down
                page = Adw.PreferencesPage()
                g = Adw.PreferencesGroup(title="This page couldn't load")
                # &amp;, not &: Adw row text is parsed as Pango markup, and a bare
                # ampersand aborts the parse — the row then renders empty, which is
                # exactly the case where something has already gone wrong.
                g.add(Adw.ActionRow(title=str(e)[:200], subtitle="About &amp; Help → Get help makes a report you can send"))
                page.add(g)
            page.update_property([Gtk.AccessibleProperty.LABEL], [title])
            self.built[pid] = page
            self.content.set_title(title)
            self.content_view.set_content(page)
            self.list.select_row(self.rows[pid])
            self.split.set_show_content(True)

        def refresh(self):
            row = self.list.get_selected_row()
            if row is not None:
                self.show(row.pid)

    # ── row helpers ────────────────────────────────────────────────────────
    def group(page, title="", description=""):
        g = Adw.PreferencesGroup(title=GLib.markup_escape_text(title), description=GLib.markup_escape_text(description))
        page.add(g)
        return g

    def info(g, title, value, icon=None):
        r = Adw.ActionRow(title=GLib.markup_escape_text(title), subtitle=GLib.markup_escape_text(str(value or "—")))
        r.set_subtitle_selectable(True)
        if icon:
            r.add_prefix(Gtk.Image.new_from_icon_name(icon))
        g.add(r)
        return r

    def opener(g, title, subtitle, cmd, label="Open"):
        r = Adw.ActionRow(title=GLib.markup_escape_text(title), subtitle=GLib.markup_escape_text(subtitle))
        b = Gtk.Button(label=label, valign=Gtk.Align.CENTER)
        b.update_property([Gtk.AccessibleProperty.LABEL], [f"{label}: {title}"])
        b.connect("clicked", lambda *_: launch(*cmd))
        r.add_suffix(b)
        r.set_activatable_widget(b)
        g.add(r)
        return r

    def goto(win, g, title, subtitle, pid, label="Open"):
        """A row that opens another page of this window."""
        r = Adw.ActionRow(title=GLib.markup_escape_text(title), subtitle=GLib.markup_escape_text(subtitle))
        b = Gtk.Button(label=label, valign=Gtk.Align.CENTER)
        b.update_property([Gtk.AccessibleProperty.LABEL], [f"{label}: {title}"])
        b.connect("clicked", lambda *_: GLib.idle_add(lambda: win.show(pid) and False))
        r.add_suffix(b)
        r.set_activatable_widget(b)
        g.add(r)
        return r

    def buttons_row(g, title, subtitle, buttons, icon=None):
        """A row with one or more buttons: [(label, callback, style)] — style "", "suggested" or "destructive"."""
        r = Adw.ActionRow(title=GLib.markup_escape_text(title), subtitle=GLib.markup_escape_text(subtitle))
        if icon:
            r.add_prefix(Gtk.Image.new_from_icon_name(icon))
        for label, cb, style in buttons:
            b = Gtk.Button(label=label, valign=Gtk.Align.CENTER)
            if style:
                b.add_css_class(f"{style}-action")
            b.update_property([Gtk.AccessibleProperty.LABEL], [f"{label}: {title}"])
            b.connect("clicked", lambda _b, cb=cb: cb())
            r.add_suffix(b)
        g.add(r)
        return r

    def background(win, work, yes, no="That didn't work", refresh=True):
        """Run a slow change (connecting, adding a printer) without freezing the window;
        say how it went, then show the page again."""
        win.toast("Working on it…")

        def run():
            try:
                good, why = work()
            except Exception as e:                  # noqa: BLE001 — say it, don't crash the window
                good, why = False, str(e)
            def report():
                win.toast(yes if good else f"{no}{' — ' + why[:120] if why else ''}")
                if refresh:
                    win.refresh()
                return False
            GLib.idle_add(report)
        threading.Thread(target=run, daemon=True).start()

    def form_dialog(win, title, intro, fields, button, on_ok):
        """A small window asking for a few things: fields = [(label, is_password)];
        on_ok(values) → (ok, message). Passwords are never shown or logged."""
        d = Adw.Window(transient_for=win, modal=True, title=title)
        d.set_default_size(440, -1)
        tv = Adw.ToolbarView()
        tv.add_top_bar(Adw.HeaderBar())
        pg = Adw.PreferencesPage()
        g = Adw.PreferencesGroup(description=GLib.markup_escape_text(intro))
        rows = [Adw.PasswordEntryRow(title=lab) if pw else Adw.EntryRow(title=lab) for lab, pw in fields]
        for r in rows:
            g.add(r)
        pg.add(g)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.append(pg)
        bt = Gtk.Button(label=button, halign=Gtk.Align.END, margin_end=16, margin_bottom=16)
        bt.add_css_class("suggested-action")
        box.append(bt)
        tv.set_content(box)
        d.set_content(tv)

        def go(*_a):
            d.close()
            on_ok([r.get_text() for r in rows])
        bt.connect("clicked", go)
        rows[-1].connect("entry-activated", go)
        d.present()
        return d

    def pick_file(win, title, on_file):
        """The file picker: on_file(path)."""
        if hasattr(Gtk, "FileDialog"):
            fd = Gtk.FileDialog(title=title)

            def got(dlg, res):
                try:
                    f = dlg.open_finish(res)
                except GLib.Error:
                    return                          # cancelled
                if f is not None and f.get_path():
                    on_file(f.get_path())
            fd.open(win, None, got)
        else:
            fc = Gtk.FileChooserNative(title=title, transient_for=win, action=Gtk.FileChooserAction.OPEN)

            def resp(n, r):
                if r == Gtk.ResponseType.ACCEPT and n.get_file():
                    on_file(n.get_file().get_path())
            fc.connect("response", resp)
            fc.show()

    def switch(win, g, title, subtitle, current, on_change):
        r = Adw.SwitchRow(title=GLib.markup_escape_text(title), subtitle=GLib.markup_escape_text(subtitle))
        r.set_active(bool(current))

        def changed(row, _p):
            ok_, msg = on_change(row.get_active())
            if msg:
                win.toast(msg)
            if not ok_:
                row.handler_block(hid)
                row.set_active(not row.get_active())
                row.handler_unblock(hid)
        hid = r.connect("notify::active", changed)
        g.add(r)
        return r

    def choice(win, g, title, subtitle, options, current, on_change):
        r = Adw.ComboRow(title=GLib.markup_escape_text(title), subtitle=GLib.markup_escape_text(subtitle))
        r.set_model(Gtk.StringList.new([lab for lab, _ in options]))
        values = [v for _, v in options]
        if current in values:
            r.set_selected(values.index(current))
        else:
            r.set_selected(Gtk.INVALID_LIST_POSITION)

        def changed(row, _p):
            i = row.get_selected()
            if 0 <= i < len(values):
                _ok, msg = on_change(values[i])
                if msg:
                    win.toast(msg)
        r.connect("notify::selected", changed)
        g.add(r)
        return r

    def slider(win, g, title, subtitle, lo, hi, step, value, on_done, fmt=lambda v: f"{v:.0f}"):
        r = Adw.ActionRow(title=GLib.markup_escape_text(title), subtitle=GLib.markup_escape_text(subtitle))
        s = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, step)
        s.set_value(value)
        s.set_size_request(260, -1)
        s.set_draw_value(True)
        s.set_format_value_func(lambda _s, v: fmt(v))
        s.update_property([Gtk.AccessibleProperty.LABEL], [title])
        pending = {"id": 0}

        def settle():
            pending["id"] = 0
            _ok, msg = on_done(s.get_value())
            if msg:
                win.toast(msg)
            return False

        def moved(*_a):   # apply once the hand stops moving, not on every pixel
            if pending["id"]:
                GLib.source_remove(pending["id"])
            pending["id"] = GLib.timeout_add(450, settle)
        s.connect("value-changed", moved)
        r.add_suffix(s)
        g.add(r)
        return r

    def usage_bar(g, title, used, total, warn_at=0.9):
        r = Adw.ActionRow(title=GLib.markup_escape_text(title),
                          subtitle=f"{gb(total - used)} free of {gb(total)}")
        frac = used / total if total else 0
        track = Gtk.Box(valign=Gtk.Align.CENTER)
        track.add_css_class("bar-track")
        track.set_size_request(220, 8)
        fill = Gtk.Box()
        fill.add_css_class("bar-fill")
        if frac >= warn_at:
            fill.add_css_class("warn")
        fill.set_size_request(max(4, int(220 * frac)), 8)
        track.append(fill)
        lab = Gtk.Label(label=f"{frac * 100:.0f}% used" + (" — almost full" if frac >= warn_at else ""))
        r.add_suffix(track)
        r.add_suffix(lab)
        r.update_property([Gtk.AccessibleProperty.DESCRIPTION], [f"{frac * 100:.0f} percent used" + (", almost full" if frac >= warn_at else "")])
        g.add(r)
        return r

    CORE_SECTIONS = {"apps", "settings", "toggles", "tools", "style", "update", "power", "about"}

    def registry() -> list:
        """Every row Prime knows (its own, each enabled pack's, your own menu.json)."""
        try:
            return json.loads(sh("prime-menu", "--json", timeout=8) or "{}").get("sections", [])
        except ValueError:
            return []

    def pack_group(page, sec, title="", skip=()):
        rows = [it for it in sec.get("items", []) if it.get("id") not in skip]
        if not rows:
            return None
        g = group(page, title or re.sub(r"^\W+", "", sec.get("label", "")).strip())
        for it in rows:
            opener(g, it.get("label", ""), it.get("hint", ""), ["prime-menu", "--run", it["id"]],
                   "Show" if it.get("kind") in ("panel", "term") else "Open")
        return g

    def missing(g, what):
        g.add(Adw.ActionRow(title=GLib.markup_escape_text(what), subtitle="Not on this computer"))

    def tb(setting, value):
        return toolbox("change_setting", {"setting": setting, "value": value})

    def pack(on, name, title):
        """Packs install in their own Prime window (it shows progress and asks for the password)."""
        launch("prime-panel", "--title", title, "--", os.path.join(BIN, "prime-addon"),
               "enable" if on else "disable", name)
        return True, "Working on it in its own window…"

    def done(flag, yes, no="That didn't change — try again, or Get help"):
        return (True, yes) if flag else (False, no)

    # ── pages ───────────────────────────────────────────────────────────────
    def p_network(win):
        page = Adw.PreferencesPage()
        g = group(page, "Wi-Fi")
        if has("nmcli"):
            radio = sh("nmcli", "-t", "-f", "WIFI", "radio")
            conn = sh("nmcli", "-t", "-f", "NAME,TYPE,DEVICE", "connection", "show", "--active")
            wifi_name = next((l.split(":")[0] for l in conn.splitlines() if ":802-11-wireless:" in l), "")
            wired = any(":802-3-ethernet:" in l for l in conn.splitlines())
            switch(win, g, "Wi-Fi", f"Connected to {wifi_name}" if wifi_name else "Not connected to a Wi-Fi network",
                   radio == "enabled", lambda on: done(ok("nmcli", "radio", "wifi", "on" if on else "off"),
                                                        f"Wi-Fi is {'on' if on else 'off'}"))
            opener(g, "Choose a network", "See the networks around you and join one", ["prime-wifi"], "Choose")
            g2 = group(page, "Connection")
            info(g2, "Cable (Ethernet)", "Connected" if wired else "Not connected")
            ip = sh("ip", "-4", "-brief", "address", "show", "scope", "global")
            info(g2, "This computer's address on the network", " · ".join(l.split()[2].split("/")[0] for l in ip.splitlines() if len(l.split()) > 2) or "none")
            conns = nm_connections()
            # saved Wi-Fi: forget the ones you don't use (and the wrong password for one)
            gs = group(page, "Saved Wi-Fi networks", "This computer joins these by itself when they're near")
            saved = [(n, act_) for n, k, act_ in conns if k == "wifi"]
            for n, active in saved:
                buttons_row(gs, n, "Connected now" if active else "Saved",
                            [("Forget", lambda n=n: background(win, lambda: act("nmcli", "connection", "delete", "id", n),
                                                               f"Forgot {n}", f"Couldn't forget {n}"), "")],
                            "network-wireless-symbolic")
            if not saved:
                info(gs, "No saved networks yet", "Choose a network above and it's saved here")

            def join_hidden(vals):
                ssid, pw = vals[0].strip(), vals[1]
                if not ssid:
                    win.toast("Type the network's name first")
                    return
                background(win, lambda: act("nmcli", "--ask", "device", "wifi", "connect", ssid, "hidden", "yes",
                                            stdin=(pw + "\n") if pw else "\n", timeout=60),
                           f"Joined {ssid}", f"Couldn't join {ssid} (check the name and password)")
            buttons_row(gs, "Join a hidden network", "One that doesn't show in the list — type its exact name",
                        [("Join…", lambda: form_dialog(win, "Join a hidden network",
                                                         "Type the network's name exactly as it is written (capitals count).",
                                                         [("Network name", False), ("Password", True)], "Join", join_hidden), "")])

            # VPN: a school's or work's VPN arrives as a file — add it, then switch it on and off here
            gv = group(page, "VPN", "A private connection to your school or work. They give you a file to add")
            vpns = [(n, act_) for n, k, act_ in conns if k == "vpn"]
            for n, active in vpns:
                switch(win, gv, n, "Connected" if active else "Off", active,
                       lambda on, n=n: (background(win, lambda: act("nmcli", "connection", "up" if on else "down", "id", n, timeout=90),
                                                   f"{n} is {'connected' if on else 'off'}", f"{n} didn't {'connect' if on else 'switch off'}"),
                                        (True, ""))[1])
                buttons_row(gv, f"Remove {n}", "", [("Remove", lambda n=n: background(win, lambda: act("nmcli", "connection", "delete", "id", n),
                                                                                      f"{n} removed", f"Couldn't remove {n}"), "")])

            def add_vpn(path):
                kind = vpn_file_type(path)
                if not kind:
                    win.toast("That file isn't a VPN file Prime knows (.ovpn or a WireGuard .conf)")
                    return
                background(win, lambda: act("nmcli", "connection", "import", "type", kind, "file", path),
                           "VPN added — switch it on above", "Couldn't add that VPN (OpenVPN needs Update everything first)")
            buttons_row(gv, "Add a VPN from a file", "An .ovpn (OpenVPN) or .conf (WireGuard) file",
                        [("Choose file…", lambda: pick_file(win, "Choose the VPN file", add_vpn), "")])

            # hotspot: share this computer's internet with a phone or tablet
            gh = group(page, "Hotspot", "Share this computer's internet with a phone or another computer")
            hot = any(n == "Hotspot" and act_ for n, _k, act_ in conns)

            def hotspot(on):
                if on:
                    def work():
                        good, why = act("nmcli", "device", "wifi", "hotspot", timeout=40)
                        if good:
                            pw = re.search(r"Password:\s*(\S+)", sh("nmcli", "device", "wifi", "show-password"))
                            GLib.idle_add(lambda: win.toast(f"Hotspot on — password: {pw.group(1)}" if pw else "Hotspot on") and False)
                        return good, why
                    background(win, work, "Hotspot on — the password is shown on this page",
                               "This Wi-Fi card can't share right now (it may be connected elsewhere)")
                else:
                    background(win, lambda: act("nmcli", "connection", "down", "id", "Hotspot"), "Hotspot off")
                return True, ""
            switch(win, gh, "Hotspot", "While it's on, this computer's Wi-Fi is used for sharing", hot, hotspot)
            if hot:
                pw = re.search(r"Password:\s*(\S+)", sh("nmcli", "device", "wifi", "show-password"))
                ssid = re.search(r"SSID:\s*(.+)", sh("nmcli", "device", "wifi", "show-password"))
                info(gh, "Join it with", f"{ssid.group(1).strip() if ssid else 'Hotspot'} · password {pw.group(1) if pw else '—'}")

            g3 = group(page, "More")
            opener(g3, "Advanced network settings", "A fixed address, proxy and other rare settings — opens the system's own tool, which looks different and uses more technical words",
                   ["nm-connection-editor"])
        else:
            missing(g, "Network settings")
        return page

    def p_bluetooth(win):
        page = Adw.PreferencesPage()
        g = group(page, "Bluetooth")
        if has("bluetoothctl") and os.path.isdir("/sys/class/bluetooth") and os.listdir("/sys/class/bluetooth"):
            on = "Powered: yes" in sh("bluetoothctl", "show")
            switch(win, g, "Bluetooth", "Lets headphones, mice, speakers and phones connect", on,
                   lambda v: done(ok("bluetoothctl", "power", "on" if v else "off"), f"Bluetooth is {'on' if v else 'off'}"))
            devs = sh("bluetoothctl", "devices", "Connected")
            g2 = group(page, "Connected now")
            names = [l.split(" ", 2)[2] for l in devs.splitlines() if l.startswith("Device ") and len(l.split(" ", 2)) == 3]
            for n in names or ["Nothing connected"]:
                info(g2, n, "Connected" if names else "")
            g3 = group(page, "Devices")
            opener(g3, "Connect a device", "Your paired devices, one click to connect", ["prime-bluetooth"], "Connect")
            opener(g3, "Pair a new device", "Put the device in pairing mode first", ["blueman-manager"], "Pair")
        else:
            missing(g, "Bluetooth")
        return page

    def p_sound(win):
        page = Adw.PreferencesPage()
        if not has("wpctl"):
            missing(group(page, "Sound"), "Sound")
            return page
        g = group(page, "Output", "Where sound plays")
        outs, out_default = audio_devices("Sinks")
        if outs:
            choice(win, g, "Play sound through", "Speakers, headphones, the screen's speakers…",
                   [(n, i) for i, n in outs], out_default,
                   lambda i: done(ok("wpctl", "set-default", i), "Sound now plays there"))
        v = sh("wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@")
        m = re.search(r"Volume:\s*([0-9.]+)", v)
        slider(win, g, "Volume", "", 0, 150, 1, round(float(m.group(1)) * 100) if m else 50,
               lambda x: done(ok("wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{x / 100:.2f}"), ""),
               fmt=lambda x: f"{x:.0f}%")
        switch(win, g, "Mute", "Silence everything", "[MUTED]" in v,
               lambda on: done(ok("wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "1" if on else "0"),
                               "Muted" if on else "Sound is on"))
        gi_ = group(page, "Input", "The microphone apps hear")
        ins, in_default = audio_devices("Sources")
        if ins:
            choice(win, gi_, "Microphone", "", [(n, i) for i, n in ins], in_default,
                   lambda i: done(ok("wpctl", "set-default", i), "Microphone changed"))
        mv = sh("wpctl", "get-volume", "@DEFAULT_AUDIO_SOURCE@")
        mm = re.search(r"Volume:\s*([0-9.]+)", mv)
        slider(win, gi_, "Microphone level", "How loud you are to others", 0, 150, 1,
               round(float(mm.group(1)) * 100) if mm else 100,
               lambda x: done(ok("wpctl", "set-volume", "@DEFAULT_AUDIO_SOURCE@", f"{x / 100:.2f}"), ""),
               fmt=lambda x: f"{x:.0f}%")
        switch(win, gi_, "Microphone off", "Nobody can hear you until you switch it back", "[MUTED]" in mv,
               lambda on: done(ok("wpctl", "set-mute", "@DEFAULT_AUDIO_SOURCE@", "1" if on else "0"),
                               "Microphone off" if on else "Microphone on"))
        ga = group(page, "Apps playing sound", "Each app's own volume, and where it plays — music on the speakers, "
                   "a call in the headphones")
        streams = app_streams()
        sinks, where = sink_names(), stream_sinks()
        for idx, name, vol in streams:
            slider(win, ga, name, "", 0, 150, 1, vol,
                   lambda x, idx=idx: done(ok("pactl", "set-sink-input-volume", str(idx), f"{x:.0f}%"), ""),
                   fmt=lambda x: f"{x:.0f}%")
            if len(sinks) > 1:
                choice(win, ga, f"{name} plays through", "", [(d, n) for n, d in sinks.values()],
                       sinks.get(where.get(idx), ("", ""))[0],
                       lambda sink, idx=idx, name=name: done(act("pactl", "move-sink-input", str(idx), sink)[0],
                                                             f"{name} moved"))
        if not streams:
            info(ga, "Nothing is playing right now", "Apps show up here while they play sound")
        cards = sound_cards()
        if cards:
            gc = group(page, "Sound devices", "How each one is used — for example the screen's speakers (HDMI) "
                       "or the computer's own, or a headset's music mode or call mode (with its microphone)")
            for card, desc, active, profs in cards:
                choice(win, gc, desc, "", [(w, n) for n, w in profs], active,
                       lambda prof, card=card, desc=desc: done(act("pactl", "set-card-profile", card, prof)[0],
                                                               f"{desc} changed"))
        g3 = group(page, "More")
        opener(g3, "Advanced mixer", "Rare settings such as balance per device — opens the system's own tool, which looks different and uses more technical words", ["pavucontrol"])
        return page

    def keep_or_revert(win, name, new_line, old_line):
        """Like a Mac: a new screen setting is tried at once and goes back by itself in 15 s
        unless you keep it — a mode the screen can't show never leaves you stuck."""
        if os.environ.get("PRIME_SETTINGS_DRY"):
            print("MONITOR", new_line, flush=True)
            return True, ""
        if not ok(HYPRCTL, "keyword", "monitor", new_line):
            return False, "The screen didn't accept that — nothing changed"
        state = {"left": 15, "done": False}
        Dialog = getattr(Adw, "AlertDialog", None) or Adw.MessageDialog
        d = Dialog(heading="Keep these display settings?", body="Going back in 15 seconds…")
        d.add_response("revert", "Go back")
        d.add_response("keep", "Keep")
        d.set_response_appearance("keep", Adw.ResponseAppearance.SUGGESTED)
        d.set_default_response("keep")
        d.set_close_response("revert")

        def finish(keep):
            if state["done"]:
                return
            state["done"] = True
            if keep:
                save_monitor(name, new_line)
                win.toast("Saved — it stays like this")
            else:
                ok(HYPRCTL, "keyword", "monitor", old_line)
                win.toast("Back to how it was")
            GLib.timeout_add(300, lambda: win.refresh() and False)

        def countdown():
            if state["done"]:
                return False
            state["left"] -= 1
            if state["left"] <= 0:
                finish(False)
                (d.force_close() if hasattr(d, "force_close") else d.close())
                return False
            d.set_body(f"Going back in {state['left']} seconds…")
            return True
        d.connect("response", lambda _d, r: finish(r == "keep"))
        GLib.timeout_add_seconds(1, countdown)
        if Dialog is getattr(Adw, "AlertDialog", None):
            d.present(win)
        else:
            missing(g, "Sound")
        return page

    def p_display(win):
        page = Adw.PreferencesPage()
        g = group(page, "Screens")
        mons = []
        try:
            mons = json.loads(sh("hyprctl", "monitors", "-j") or "[]")
        except ValueError:
            pass
        for mo in mons:
            desc = (mo.get("description") or mo.get("name") or "Screen").split(" 0x")[0]
            info(g, desc, f"{mo.get('width')}×{mo.get('height')} at {round(mo.get('refreshRate', 0))} Hz · "
                          f"scale {mo.get('scale', 1):g}", "video-display-symbolic")
        if not mons:
            info(g, "Screens", "Shown here while you're on the Prime desktop")
        opener(g, "Arrange screens", "Resolution, refresh rate, scale, and where each screen sits", ["nwg-displays"], "Arrange")
        g2 = group(page, "Comfort")
        if has("brightnessctl") and sh("brightnessctl", "-m", "-c", "backlight", "info"):
            cur = sh("brightnessctl", "-m", "-c", "backlight", "info").split(",")
            pct = int(cur[3].rstrip("%")) if len(cur) > 3 and cur[3].rstrip("%").isdigit() else 50
            slider(win, g2, "Brightness", "", 5, 100, 1, pct,
                   lambda x: done(ok("brightnessctl", "-c", "backlight", "set", f"{x:.0f}%"), ""),
                   fmt=lambda x: f"{x:.0f}%")
        st = managed()
        switch(win, g2, "Night light", "Warmer colours in the evening, easier on the eyes",
               st.get("night_light", "off") != "off", lambda on: tb("night_light", "on" if on else "off"))
        g3 = group(page, "Screenshots", "Print Screen or Super+Shift+S: the picture is saved in Pictures › Screenshots "
                   "and copied, straight away")
        after = [("Show what I can do next (Edit, Show, Delete…)", "buttons"), ("Just save and copy it", "save")]
        if "ai" in enabled_addons():
