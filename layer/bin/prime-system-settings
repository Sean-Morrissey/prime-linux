    def p_accounts(win):
        page = Adw.PreferencesPage()
        g = group(page, "You")
        name = ""
        m = re.search(r'^name:\s*"?([^"\n]*)"?', read(os.path.join(CFG, "identity.yaml")), re.M)
        if m:
            name = m.group(1).strip()
        info(g, "Name", name or os.environ.get("USER", ""), "avatar-default-symbolic")
        info(g, "Account", os.environ.get("USER", "") or os.path.basename(HOME))
        opener(g, "Set up my computer again", "Your name, look, packs and updates — the Welcome app", ["prime-welcome"], "Open")
        g2 = group(page, "Password")
        r = Adw.ActionRow(title="Change your password", subtitle="The one you log in and unlock with")
        b = Gtk.Button(label="Change", valign=Gtk.Align.CENTER)
        b.update_property([Gtk.AccessibleProperty.LABEL], ["Change your password"])
        b.connect("clicked", lambda *_: password_dialog(win))
        r.add_suffix(b)
        r.set_activatable_widget(b)
        g2.add(r)
        return page

    def password_dialog(win):
        d = Adw.Window(transient_for=win, modal=True, title="Change your password")
        d.set_default_size(420, -1)
        tv = Adw.ToolbarView()
        tv.add_top_bar(Adw.HeaderBar())
        pg = Adw.PreferencesPage()
        g = Adw.PreferencesGroup(description="Use the new one next time you log in or unlock the screen.")
        rows = [Adw.PasswordEntryRow(title=t) for t in ("Current password", "New password", "New password again")]
        for r in rows:
            g.add(r)
        msg = Gtk.Label(wrap=True, xalign=0, margin_top=8)
        g.add(msg)
        pg.add(g)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.append(pg)
        bt = Gtk.Button(label="Change password", halign=Gtk.Align.END, margin_end=16, margin_bottom=16)
        bt.add_css_class("suggested-action")
        box.append(bt)
        tv.set_content(box)
        d.set_content(tv)

        def go(*_a):
            text = "".join(r.get_text() + "\n" for r in rows)
            if os.environ.get("PRIME_SETTINGS_DRY"):
                print("TOOL prime-passwd (3 lines on stdin)", flush=True)
                good, out = True, "Password changed."
            else:
                try:
                    p = subprocess.run([os.path.join(BIN, "prime-passwd")], input=text, capture_output=True,
                                       text=True, timeout=60)
                    good, out = p.returncode == 0, p.stdout.strip()
                except (OSError, subprocess.TimeoutExpired):
                    good, out = False, "The password wasn't changed — try again."
            if good:
                win.toast(out)
                d.close()
            else:
                msg.set_text(out)
        bt.connect("clicked", go)
        rows[-1].connect("entry-activated", go)
        d.present()
        return d

    def p_accessibility(win):
        page = Adw.PreferencesPage()
        th, st = theme_conf(), managed()
        g = group(page, "Seeing")
        choice(win, g, "Text size", "Bar, menus, notifications, lock screen and apps", TEXT_SIZES,
               th.get("TEXT", "default"), lambda t: done(ok("prime-theme", "--set-text", t), "Text size changed"))
        switch(win, g, "Reduce motion", "No sliding or fading animations",
               st.get("animations", "on") == "off", lambda on: tb("animations", "off" if on else "on"))
        gz = group(page, "Magnifier", "Enlarges the screen around the pointer. Keys: Super+Alt+= bigger, "
                   "Super+Alt+- smaller, Super+Alt+0 normal size")
        opener(gz, "Zoom in", "Super + Alt + =", ["prime-zoom", "in"], "Bigger")
        opener(gz, "Zoom out", "Super + Alt + -", ["prime-zoom", "out"], "Smaller")
        opener(gz, "Normal size", "Super + Alt + 0", ["prime-zoom", "reset"], "Reset")
        g2 = group(page, "Keyboard")
        opener(g2, "Use the bar from the keyboard", "Every bar item and its menu (Super+Alt+B)", ["prime-bar", "--keys"])
