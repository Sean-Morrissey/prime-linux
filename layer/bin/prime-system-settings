MINUTE_CHOICES = [("1 minute", 1), ("2 minutes", 2), ("5 minutes", 5), ("10 minutes", 10), ("15 minutes", 15),
                  ("20 minutes", 20), ("30 minutes", 30), ("45 minutes", 45), ("1 hour", 60), ("2 hours", 120),
                  ("Never", 0)]
BAR_ITEM_NAMES = [("media", "Music controls", "Play, pause and skip, with what's playing"),
                  ("toggles", "Quick toggles", "Night light, do not disturb, keep awake"),
                  ("keyboard", "Keyboard layout", "Shown when you have more than one"),
