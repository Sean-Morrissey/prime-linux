    def p_topbar(win):
        page = Adw.PreferencesPage()
        st = managed()
        g = group(page, "Clock")
        choice(win, g, "Clock style", "", [("12-hour (3:45 PM)", "12h"), ("24-hour (15:45)", "24h")],
               st.get("clock_format", "12h"), lambda v: tb("clock_format", v))
        switch(win, g, "Show the date", "Next to the time", st.get("clock_date", "on") != "off",
               lambda on: tb("clock_date", "on" if on else "off"))
        switch(win, g, "Show seconds", "", st.get("clock_seconds", "off") == "on",
               lambda on: tb("clock_seconds", "on" if on else "off"))
        info(g, "Click the clock", "Opens the calendar")
        g2 = group(page, "What the bar shows", "Switch off what you don't need — the bar stays tidy")
        hidden = {x for x in str(st.get("bar_hidden", "")).split(",") if x}

        def set_item(key, on):
            now = set(x for x in str(managed().get("bar_hidden", "")).split(",") if x)
            now = now - {key} if on else now | {key}
            return tb("bar_hidden", ",".join(sorted(now)))
        for key, title, sub_ in BAR_ITEM_NAMES:
            switch(win, g2, title, sub_, key not in hidden, lambda on, key=key: set_item(key, on))
        g3 = group(page, "More")
        opener(g3, "Use the bar from the keyboard", "Every bar item and its menu (Super+Alt+B)", ["prime-bar", "--keys"])
        opener(g3, "Restart the bar", "If it froze or vanished (Super+W)", ["prime-bar", "restart"], "Restart")
        return page

