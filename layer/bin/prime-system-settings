        g = group(page, "Ask Prime", "Optional. Nothing is sent anywhere until you connect a model.")
        switch(win, g, "AI assistant", "Ask Prime from Prime Search, right-click menus and Super+Shift+Space", on,
               lambda v: pack(v, "ai", "AI assistant"))
        conf = read(os.path.join(CFG, "ai.conf"))
        mm = re.search(r"^MODEL=(.*)$", conf, re.M)
        info(g, "Model", mm.group(1) if mm and mm.group(1) else "not connected yet")
        opener(g, "Change the model", "On this computer, on your network, or a service",
               [os.path.join(LAYER, "addons/ai/bin/prime-ai-setup")], "Change")
        g2 = group(page, "What Prime may do on its own")
        cur = sh("prime-settings", "autonomy").split(" ")[0] if has("prime-settings") else ""
        choice(win, g2, "Permission", "Destructive changes and passwords always ask, whatever this says",
               AUTONOMY, cur, lambda lv: done(ok("prime-settings", "autonomy", lv), "Saved"))
        opener(g2, "What Prime changed", "Every change, in plain words, and how to undo it",
               ["prime-panel", "--title", "What Prime changed", "--", os.path.join(BIN, "prime-settings"), "log", "30"], "Show")
        if on:
            for sec in registry():
                if sec.get("id") == "prime":
                    pack_group(page, sec, "Ask Prime")
        return page

    def p_apps(win):
        page = Adw.PreferencesPage()
        g = group(page, "Getting apps")
        opener(g, "App Store", "Install apps with a click", ["gnome-software"])
        opener(g, "Packs and add-ons", "Gaming, coding, creating, studying, the AI assistant", ["prime-addon", "pick"], "Choose")
        opener(g, "Make a website into an app", "WhatsApp, YouTube, Gmail… in their own windows", ["prime-webapp"], "Make")
        g2 = group(page, "Default apps")
        br = sh("xdg-settings", "get", "default-web-browser").removesuffix(".desktop")
        fm = sh("xdg-mime", "query", "default", "inode/directory").removesuffix(".desktop")
        info(g2, "Web browser", br or "not set")
        info(g2, "File manager", fm or "not set")
        opener(g2, "Change the default apps", "", ["prime-default-apps"], "Change")
        g3 = group(page, "Start with the computer")
        goto(win, g3, "Apps that open when you log in", "Startup Apps", "startup")
        for sec in registry():               # Coding, Creating, Studying… (Gaming and AI have their own pages)
            if sec.get("id") not in CORE_SECTIONS | {"gaming", "prime"}:
                pack_group(page, sec)
        return page

    def p_updates(win):
        page = Adw.PreferencesPage()
        g = group(page, "Updates")
        info(g, "Now", sh("prime-update-policy", "describe") or "—", "software-update-available-symbolic")
        choice(win, g, "Install updates", "A snapshot is taken first, so an update can always be undone",
               POLICIES, sh("prime-update-policy", "get"),
               lambda p: done(ok("prime-update-policy", "set", p, timeout=120), "Saved", "Not changed (the password was cancelled?)"))
        g2 = group(page, "Now")
        opener(g2, "Update everything", "The system, apps and Prime", ["prime-update"], "Update")
        opener(g2, "What's waiting", "Nothing changes until you choose to", ["prime-update", "--check"], "Show")
        opener(g2, "Undo the last update", "Go back to how things were before it", ["prime-update", "--undo"], "Undo")
        opener(g2, "System snapshots", "Every saved state of the system, newest first", ["prime-snapshots"], "Show")
        return page

    def p_security(win):
        page = Adw.PreferencesPage()
        g = group(page, "Safety check", "What protects this computer, in plain words")
        rows = [l.split("\t") for l in sh("prime-security", "status", "--tsv", timeout=20).splitlines() if "\t" in l]
        icons = {"ok": "emblem-ok-symbolic", "warn": "dialog-warning-symbolic", "bad": "dialog-error-symbolic",
                 "info": "dialog-information-symbolic"}
        words = {"ok": "OK", "warn": "Worth a look", "bad": "Needs you", "info": "Note"}
        for r in rows:
            lvl, msg = r[0], r[1]
            fix = r[2] if len(r) > 2 else ""
            fix_id = r[3] if len(r) > 3 else ""
            row = info(g, msg, f"{words.get(lvl, '')}{' — ' + fix if fix and not fix_id else ''}", icons.get(lvl))
            row.update_property([Gtk.AccessibleProperty.DESCRIPTION], [words.get(lvl, "")])
            if fix_id:                                 # a button that does it (prime-fix: a fixed list)
                b = Gtk.Button(label=fix, valign=Gtk.Align.CENTER)
                b.update_property([Gtk.AccessibleProperty.LABEL], [fix])
                b.connect("clicked", lambda _b, f=fix_id: launch("prime-fix", f))
                row.add_suffix(b)
        if not rows:
            info(g, "Safety check", "Couldn't read it right now")
        g2 = group(page, "More")
        opener(g2, "Full security check", "With the fix for anything that needs you",
               ["prime-panel", "--title", "Security check", "--", os.path.join(BIN, "prime-security"), "status"], "Open")
        opener(g2, "Get a file back", "File History", ["prime-file-history"], "Open")
        return page

    def p_printers(win):
        page = Adw.PreferencesPage()
        g = group(page, "Printers", "Most Wi-Fi printers are found by themselves")
        names = [l.split()[1] for l in sh("lpstat", "-p").splitlines() if l.startswith("printer ")]
        default = sh("lpstat", "-d").split(":")[-1].strip()
        for n in names:
            info(g, n.replace("_", " "), "Default printer" if n == default else "Ready", "printer-symbolic")
        if not names:
            info(g, "No printers yet", "Add one below")
        opener(g, "Add or change a printer", "Find a printer on the network or a USB cable — opens the system's own tool, which looks different and uses more technical words", ["system-config-printer"], "Open")
        return page

    def p_datetime(win):
        page = Adw.PreferencesPage()
        g = group(page, "Date & time")
        props = dict(l.split("=", 1) for l in sh("timedatectl", "show").splitlines() if "=" in l)
        info(g, "Time zone", props.get("Timezone", "—"), "preferences-system-time-symbolic")
        switch(win, g, "Set the time automatically", "From the internet, always exact",
               props.get("NTP", "no") == "yes",
               lambda on: done(ok("timedatectl", "set-ntp", "true" if on else "false", timeout=120), "Saved"))
        zones = sh("timedatectl", "list-timezones").splitlines()
        if zones:
            choice(win, g, "Change time zone", "Asks for your password", [(z.replace("_", " "), z) for z in zones],
                   props.get("Timezone", ""),
                   lambda z: done(ok("timedatectl", "set-timezone", z, timeout=120), f"Time zone: {z}"))
        return page

    def p_region(win):
