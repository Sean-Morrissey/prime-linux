    def p_camera(win):
        page = Adw.PreferencesPage()
        g = group(page, "Camera", "Check it before a call or a lesson")
        cams = cameras()
        for dev, name in cams:
            info(g, name, "Ready", "camera-web-symbolic")
        if not cams:
            info(g, "No camera found", "A USB camera shows up here as soon as it's plugged in")
        users = camera_users()
        # Read once when the page opens, rather than polled. The branch this page
        # came from had a live() helper backed by a 2-second refresh on the window;
        # that plumbing does not exist here, and one row is not worth it. Reopening
        # the page re-reads it.
        info(g, "Using the camera now", ", ".join(camera_users()) or "Nothing", "camera-web-symbolic")
        app = next((a for a in ("snapshot", "cheese") if has(a)), "")
        if cams and app:
            opener(g, "Test the camera", "See yourself — the light next to the camera comes on", [app], "Test")
        elif cams:
            missing(g, "The camera test app (Update everything adds it)")
        gm = group(page, "Microphone", "Hear yourself the way others will")
        ins, in_default = audio_devices("Sources")
        if ins:
            choice(win, gm, "Microphone", "", [(n, i) for i, n in ins], in_default,
                   lambda i: done(ok("wpctl", "set-default", i), "Microphone changed"))
        mv = sh("wpctl", "get-volume", "@DEFAULT_AUDIO_SOURCE@")
        if "[MUTED]" in mv:
            def mic_on():
                win.toast("Microphone on" if ok("wpctl", "set-mute", "@DEFAULT_AUDIO_SOURCE@", "0") else "That didn't work")
                win.refresh()
            buttons_row(gm, "The microphone is off", "Nobody can hear you",
                        [("Switch on", mic_on, "suggested")], "microphone-disabled-symbolic")
        clip = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "prime-mic-test.wav")

        def mic_test():
            def work():
                good, why = act("sh", "-c", f"timeout 5 pw-record '{clip}'; pw-play '{clip}'; rm -f '{clip}'", timeout=30)
                return good or "Terminated" in why or why == "", why
            background(win, work, "That's how you sound", "The microphone test didn't work", refresh=False)
            win.toast("Recording for 5 seconds — say something…")
        if has("pw-record"):
            buttons_row(gm, "Test the microphone", "Records 5 seconds, then plays it back",
                        [("Record", mic_test, "")], "audio-input-microphone-symbolic")
        goto(win, gm, "More sound settings", "Volume, speakers and each app", "sound")
        if users:
            g.set_description("Check it before a call or a lesson. The camera is in use right now")
        return page

