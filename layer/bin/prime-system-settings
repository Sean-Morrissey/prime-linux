    BUILDERS = {"network": p_network, "bluetooth": p_bluetooth, "sound": p_sound, "display": p_display,
                "appearance": p_appearance, "notifications": p_notifications, "power": p_power,
                "mouse": p_mouse, "keyboard": p_keyboard, "processor": p_processor, "graphics": p_graphics,
                "storage": p_storage, "gaming": p_gaming, "assistant": p_assistant, "apps": p_apps,
                "updates": p_updates, "security": p_security, "printers": p_printers, "datetime": p_datetime, "region": p_region,
                "accounts": p_accounts, "accessibility": p_accessibility, "about": p_about}
    assert set(BUILDERS) == {p for p, *_ in PAGES}

    # ── run ─────────────────────────────────────────────────────────────────
    result = {"code": 0}

    def snap(win, path):
        w, h = win.get_width(), win.get_height()
        p = Gtk.WidgetPaintable.new(win)
        s = Gtk.Snapshot()
        p.snapshot(s, w, h)
        node = s.to_node()
        if node:
            win.get_renderer().render_texture(node, None).save_to_png(path)
            return True
        return False

    def run_selftest(win):
        fails = []
        for pid, title, *_ in PAGES:
            win.show(pid)
            page = win.built[pid]
            bad = isinstance(page, Adw.PreferencesPage) and "couldn't load" in str(
                [g.get_title() for g in _groups(page)])
            print(f"  {'FAIL' if bad else 'PASS'}  {title}")
            if bad:
                fails.append(pid)
        win.search.set_text("touchpad")
        visible = [pid for pid, *_ in PAGES if win.matches(win.rows[pid])]
        good = visible == ["mouse"]
        print(f"  {'PASS' if good else 'FAIL'}  search 'touchpad' finds Mouse & Touchpad — {visible}")
        if not good:
            fails.append("search")
        print(f"\n{len(fails)} failure(s)")
        result["code"] = 1 if fails else 0
        win.get_application().quit()

    def _groups(page):
        out, child = [], page.get_first_child()
        stack = [child]
        while stack:
            c = stack.pop()
            if c is None:
                continue
            if isinstance(c, Adw.PreferencesGroup):
                out.append(c)
            stack.append(c.get_first_child())
            stack.append(c.get_next_sibling())
        return out

    def run_screenshots(win, outdir):
        os.makedirs(outdir, exist_ok=True)
        order = [p for p, *_ in PAGES]

        def step(i, tries=0):
            if i >= len(order):
                win.get_application().quit()
                return False
            win.show(order[i])

            def take():
                if not snap(win, os.path.join(outdir, f"settings-{i + 1:02d}-{order[i]}.png")) and tries < 10:
                    GLib.timeout_add(200, step, i, tries + 1)
                    return False
                GLib.timeout_add(150, step, i + 1)
                return False
            GLib.timeout_add(500, take)
            return False
        GLib.timeout_add(700, step, 0)

    Adw.init()
    app = Adw.Application(application_id="org.primelinux.Settings",
                          flags=Gio.ApplicationFlags.NON_UNIQUE if (screenshots or selftest) else Gio.ApplicationFlags.DEFAULT_FLAGS)

    def activate(app_):
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        prov = Gtk.CssProvider()
        prov.load_from_string(CSS) if hasattr(prov, "load_from_string") else prov.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        # the exact accent and Prime's own surfaces, written by prime-theme (absent: libadwaita's)
        adw = os.path.join(CFG, "theme/adw.css")
        if os.path.exists(adw):
            theme = Gtk.CssProvider()
            theme.load_from_path(adw)
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), theme,
                                                      Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        win = app_.get_active_window() or Settings(app_)
        if page and page in win.rows:
            win.show(page)
        win.present()
        if selftest:
            GLib.timeout_add(300, lambda: run_selftest(win) and False)
        elif screenshots:
            run_screenshots(win, screenshots)
    app.connect("activate", activate)
    rc = app.run([sys.argv[0]])
    return result["code"] or rc


def main(argv: list) -> int:
    if "--hardware" in argv:
        print(describe_hardware())
        return 0
    if "--list-pages" in argv:
        for pid, title, _icon, words in PAGES:
            print(f"{pid}\t{title}\t{words}")
        return 0
    page = argv[argv.index("--page") + 1] if "--page" in argv and argv.index("--page") + 1 < len(argv) else ""
    if page and page not in {p for p, *_ in PAGES}:
        print(f"no such page: {page} (see --list-pages)", file=sys.stderr)
        return 2
    shots = argv[argv.index("--screenshots") + 1] if "--screenshots" in argv else ""
    return gui(page=page, screenshots=shots, selftest="--selftest" in argv)


def describe_hardware() -> str:
    """What the Graphics and Processor pages read, as text (tests, Get help)."""
    lines = []
    for g in gpu_cards():
        bits = [g["card"], g["driver"] or "?"]
        if "busy" in g:
            bits.append(f"busy {g['busy']}%")
        if "vram" in g:
            bits.append(f"vram {gb(g['vram'][0])}/{gb(g['vram'][1])}")
        if "clock" in g:
            bits.append(f"clock {g['clock']} MHz")
        if "temp" in g:
            bits.append(f"temp {g['temp']} °C")
        if "watts" in g:
            bits.append(f"power {g['watts']:.0f} W")
        lines.append("gpu " + " · ".join(bits))
    c = cpu_live()
    lines.append(f"cpu {c['ghz']:.2f} GHz (max {c['max']:.1f}) · {c['driver']} · {c['governor']} · {c['epp']} · {c['temp']}")
    return "\n".join(lines)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
