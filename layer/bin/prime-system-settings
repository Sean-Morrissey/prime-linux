        choice(win, g3, "After a screenshot", "", after, st.get("after_screenshot", "buttons"),
               lambda v: tb("after_screenshot", v))
        opener(g3, "Take a screenshot now", "Drag over the part you want", ["prime-snip", "area"], "Take")
        g4 = group(page, "Recording and colours")
        opener(g4, "Record part of the screen", "Super+Shift+R; press it again to stop", ["prime-record", "area"], "Record")
        opener(g4, "Record the whole screen with sound", "Super+Ctrl+Shift+R", ["prime-record", "screen", "--sound"], "Record")
        opener(g4, "Pick a colour from the screen", "Copies its code (Super+Shift+C)", ["prime-colour"], "Pick")
        return page

