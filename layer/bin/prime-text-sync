#!/usr/bin/env bash
# prime:summary=make GTK3 apps follow the one Text size control
# prime-text-sync — make GTK3 apps follow the one Text size control.
#
# GTK4, the bar, notifications, kitty, the dock, the lock screen and the title
# bars are all regenerated by `prime-theme` when Text size changes. GTK3 is not:
# nemo, pavucontrol, nm-connection-editor, blueman and the tray menus read
# ~/.config/gtk-3.0/settings.ini, and nothing kept that file in step, so they sat
# at whatever was typed there once (often a font the machine does not have, so
# they silently rendered a fallback at a fixed size).
#
# This copies the value GTK4 already uses (gsettings font-name) into the GTK3
# file. prime-text-sync.path runs it whenever prime-theme rewrites the generated
# fonts.rasi, so it fires wherever the change came from: Settings, the menu or
# the command line.
set -u

INI="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0/settings.ini"
LOG="${XDG_RUNTIME_DIR:-/tmp}/prime-text-sync.log"

font="$(gsettings get org.gnome.desktop.interface font-name 2>/dev/null | tr -d "'")"
[ -n "$font" ] || { echo "no gsettings font-name" >>"$LOG"; exit 0; }

mkdir -p "$(dirname "$INI")"
[ -s "$INI" ] || printf '[Settings]\n' >"$INI"
# GTK reads keys only inside [Settings]: a key in a file without it is ignored
grep -q '^\[Settings\]' "$INI" || sed -i '1i [Settings]' "$INI"

if grep -q '^gtk-font-name=' "$INI"; then
  sed -i "s|^gtk-font-name=.*|gtk-font-name=${font}|" "$INI"
else
  sed -i "/^\[Settings\]/a gtk-font-name=${font}" "$INI"
fi

printf '%s gtk-3.0 -> %s\n' "$(date '+%H:%M:%S')" "$font" >>"$LOG"
