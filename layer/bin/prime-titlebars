#!/usr/bin/env bash
# prime-titlebars — make sure the window title bars (the hyprbars plugin) are
# built for the Hyprland that's running, then load them.
#
#   prime-titlebars            at login (autostart): quick when already built;
#                              otherwise builds once in the background (~1 min) —
#                              including after a Hyprland update, when the old build
#                              no longer loads (no "Needs you" in the health check)
#   prime-titlebars --rebuild  build again (after a Hyprland update)
#
# hyprpm can only add plugins from inside a running Hyprland session, so the
# installer — usually run from another desktop — leaves this to the first login.
set -u
LOG="$HOME/.cache/prime-hyprpm.log"; mkdir -p "$HOME/.cache"
note() { notify-send -a Prime -t "${3:-5000}" "$1" "${2:-}" >/dev/null 2>&1 || true; }
[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || { echo "run this inside Hyprland" >&2; exit 1; }

# The title bars' look (plugins.conf) is only valid while the plugin is loaded: Hyprland
# lists every one of its lines as an error otherwise (a screen of them during the minute a
# rebuild takes after a Hyprland update). So Hyprland reads it through a switch file,
# pointed at it only while the bars are loaded.
SWITCH="$HOME/.config/prime/theme/plugins.conf"
LAYER="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
bars_conf() {   # bars_conf on|off — and reload Hyprland only when it changed
    local want
    if [ "$1" = on ]; then want="source = $LAYER/default/hypr/plugins.conf"
    else want="# window title bars aren't loaded right now (prime-titlebars)"; fi
    mkdir -p "$(dirname "$SWITCH")"
    [ "$(cat "$SWITCH" 2>/dev/null)" = "$want" ] && return 0
    printf '%s\n' "$want" > "$SWITCH"
    hyprctl reload >/dev/null 2>&1
}

command -v hyprpm >/dev/null || { bars_conf off; exit 0; }
# switched off in Settings → Windows & Workspaces → Title bars
if [ "$(jq -r '.settings.titlebars // "on"' "$HOME/.config/prime/settings.json" 2>/dev/null)" = off ]; then
    bars_conf off; exit 0
fi

enabled() { hyprpm list 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | grep -A3 -i 'hyprbars' | grep -qi 'enabled: *\(true\|yes\)'; }
loaded()  { hyprctl plugin list 2>/dev/null | grep -qi hyprbars; }

again=0
if [ "${1:-}" != --rebuild ] && enabled; then
    hyprpm reload -n >/dev/null 2>&1
    for _ in 1 2 3; do loaded && { bars_conf on; exit 0; }; sleep 1; done
    again=1      # built for the Hyprland before an update: build again, quietly
fi
# not loaded (yet): their settings must not show as errors while they're built
loaded || bars_conf off
# one build at a time: the health check at login may want one too (hyprpm takes no lock)
exec 9>"$HOME/.cache/prime-hyprpm.lock"
flock -n 9 || { echo "== $(date) another title-bar build is already running" >>"$LOG"; exit 0; }
if [ $again = 1 ]; then
    note "Updating window title bars" "Hyprland was updated, so they're rebuilt for it — about a minute. Everything works meanwhile."
else
    note "Setting up window title bars" "A one-time build for this version of Hyprland — about a minute. Everything works meanwhile."
fi
{
    echo "== $(date) prime-titlebars ${1:-}"
    hyprpm update &&
    { hyprpm list 2>/dev/null | grep -qi hyprbars || hyprpm add https://github.com/hyprwm/hyprland-plugins; } &&
    hyprpm enable hyprbars && hyprpm reload -n
} >>"$LOG" 2>&1 </dev/null
if loaded; then bars_conf on; note "Window title bars are ready"
else bars_conf off; note "Couldn't set up title bars" "No internet? Prime tries again at your next login. Details: ~/.cache/prime-hyprpm.log" 8000; fi
