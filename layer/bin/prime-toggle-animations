#!/usr/bin/env bash
# prime:summary=Animations on/off for this session (a slow machine, or screen recording)
# Animations on/off for this session (a slow machine, or screen recording).
HYPR="$(dirname "$(readlink -f "$0")")/prime-hypr"
# Hyprland 0.57 reports this option as "bool"; older versions as "int"
if [ "$(hyprctl getoption animations:enabled -j | jq '.int // (if .bool then 1 else 0 end)')" = 1 ]; then
    "$HYPR" keyword animations:enabled false >/dev/null && notify-send -a Prime "Animations off"
else
    "$HYPR" keyword animations:enabled true >/dev/null && notify-send -a Prime "Animations on"
fi
