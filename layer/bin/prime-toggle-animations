#!/usr/bin/env bash
# prime:summary=Reduce motion on/off (animations and frosted blur)
# Reduce motion on/off for this session: toggles both window animations and the
# frosted blur (blur is the common vestibular trigger).
BIN="$(dirname "$(readlink -f "$0")")"
HYPR="$BIN/prime-hypr"
# Hyprland 0.57 reports this option as "bool"; older versions as "int"
if [ "$(hyprctl getoption animations:enabled -j | jq '.int // (if .bool then 1 else 0 end)')" = 1 ]; then
    "$HYPR" keyword animations:enabled false >/dev/null
    "$HYPR" keyword decoration:blur:enabled false >/dev/null
    "$BIN/prime-notify" -T 3000 -t "Reduce motion on" -b "Window animations and frosted blur are off." -a "$BIN/prime-system-settings --page accessibility"
else
    "$HYPR" keyword animations:enabled true >/dev/null
    "$HYPR" keyword decoration:blur:enabled true >/dev/null
    "$BIN/prime-notify" -T 3000 -t "Motion back on" -b "Window animations and frosted blur are back on." -a "$BIN/prime-system-settings --page accessibility"
fi
