#!/usr/bin/env bash
# Animations on/off for this session (a slow machine, or screen recording).
if [ "$(hyprctl getoption animations:enabled -j | jq .int)" = 1 ]; then
    hyprctl keyword animations:enabled false >/dev/null && notify-send -a Prime "Animations off"
else
    hyprctl keyword animations:enabled true >/dev/null && notify-send -a Prime "Animations on"
fi
