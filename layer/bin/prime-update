#!/usr/bin/env bash
# prime-update — update everything: Prime Linux itself, the system (with a
# safety snapshot first), apps from the AUR (asks first), App Store apps, and
# the window title bars. Explains every step, and every failure, in plain words.
#
#   prime-update            update everything
#   prime-update --prime    only Prime Linux itself (no system packages)
#   prime-update --check    what is waiting — changes nothing
#   prime-update --undo     how to go back to before the last update
#
# The system part runs in Prime's updater (prime-system-update): downloads
# finish before anything installs, shutdown is blocked while it installs, and
# closing this window can't stop it half-way.
#
# Opened from the bar, the menu or the app list it runs in a Prime window
# (prime-panel), and the password is asked for in a Prime box (prime-askpass).
set -u
LAYER="$(readlink -f "$(dirname "$(readlink -f "$0")")/..")"
REPO="$(readlink -f "$LAYER/..")"
BIN="$LAYER/bin"
ENGINE=/usr/local/lib/prime-linux/prime-system-update
[ -x "$ENGINE" ] || ENGINE="$LAYER/system/updates/prime-system-update"
STATE=/var/lib/prime-linux/updates
A=$'\e[38;2;248;113;113m'; B=$'\e[1m'; D=$'\e[2m'; G=$'\e[32m'; Y=$'\e[33m'; R=$'\e[0m'
TOTAL=5; n=0
if [ -z "${PRIME_PANEL:-}${PRIME_NO_PANEL:-}" ] && [ ! -t 1 ] && [ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]; then
    case "${1:-}" in
        --undo)  exec "$BIN/prime-panel" --title "Undo an update" -- "$0" "$@" ;;
        --check) exec "$BIN/prime-panel" --title "What's waiting to update" -- "$0" "$@" ;;
        *)       exec "$BIN/prime-panel" --title "Update everything" \
                     --subtitle "Prime, the system and your apps. A snapshot is taken first, so this can be undone." -- "$0" "$@" ;;
    esac
fi
if [ -n "${PRIME_PANEL:-}" ]; then
    # "@kind text" rows for the Prime window; the password in a Prime box
    A=""; B=""; D=""; G=""; Y=""; R=""
    step() { n=$((n+1)); echo "@step $*"; }
    ok()   { echo "@ok $*"; }
    note() { echo "@note $*"; }
    warn() { echo "@bad $*"; }
    stop() { echo "@bad $1"; shift; for l in "$@"; do echo "@note $l"; done; echo "@summary Stopped — $(sed 's/[.]$//' <<<"${1:-see above}")."; exit 1; }
    sudo() { command sudo -A "$@"; }
    export PRIME_ASKPASS_REASON="Prime needs your password to install the system updates."
else
    step() { n=$((n+1)); printf '\n%s[%d/%d]%s %s%s%s\n' "$A" "$n" "$TOTAL" "$R" "$B" "$*" "$R"; }
    ok()   { printf '    %s✓%s %s\n' "$G" "$R" "$*"; }
    note() { printf '    %s\n' "$*"; }
    warn() { printf '    %s!%s %s\n' "$Y" "$R" "$*"; }
    stop() { printf '\n%s%s%s\n' "$B" "$1" "$R"; shift; for l in "$@"; do printf '  %s\n' "$l"; done; echo; exit 1; }
fi
confirm() {   # confirm <question> <default y|n> — a Prime picker in the window, a prompt in a terminal
    local a
    if [ -n "${PRIME_PANEL:-}" ]; then
        a="$(printf 'Yes\nNo\n' | "$BIN/prime-rofi" -dmenu -i -no-custom -p "$1" -theme spotlight 2>/dev/null)" || a=""
        [ -n "$a" ] || { [ "$2" = y ] && a=Yes || a=No; }
        [ "$a" = Yes ]; return
    fi
    read -rp "    $1 [$([ "$2" = y ] && echo Y/n || echo y/N)] " a
    a="${a:-$2}"; [[ "${a,,}" =~ ^y ]]
}
trap 'printf "\n  Stopped. The system part (if it had started) finishes by itself — nothing is left half-installed.\n"; exit 130' INT

case "${1:-}" in
  --check) exec "$ENGINE" check ;;
  --undo)
    "$ENGINE" undo
    if findmnt -no OPTIONS / 2>/dev/null | grep -q 'subvol=[^,]*\.snapshots/[0-9]' && command -v limine-snapper-restore >/dev/null; then
      confirm "Make this snapshot the permanent system now?" n && { sudo limine-snapper-restore; exit $?; }
    fi
    exit 0 ;;
  --prime) ONLY_PRIME=1 ;;
  "") ONLY_PRIME=0 ;;
  -h|--help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *) echo "unknown option: $1 (try: prime-update --help)" >&2; exit 2 ;;
esac
[ "$ONLY_PRIME" = 1 ] && TOTAL=2

[ -n "${PRIME_PANEL:-}" ] || printf '\n  %sUpdating your computer%s %s— this usually takes a few minutes. You can keep working.%s\n' "$B" "$R" "$D" "$R"

# ── 1. Prime Linux itself ────────────────────────────────────────────────────
step "Prime Linux"
before="$(git -C "$REPO" rev-parse --short HEAD 2>/dev/null)"
# never stop to ask for a GitHub username in a window that can't answer (private repo, no login):
# fail at once instead, and say how to sign in
# Fetch, check, then move: on the stable channel the new version must be a release
# signed by a key THIS computer already trusts (prime-release-verify), so nobody who
# gets push access to the branch — or sits between here and GitHub — can ship code.
if pull_err="$(GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=/bin/false SSH_ASKPASS=/bin/false timeout 120 \
               git -C "$REPO" fetch --quiet --tags 2>&1 </dev/null)"; then
    target="$(git -C "$REPO" rev-parse --verify -q '@{upstream}' 2>/dev/null || true)"
    if [ -z "$target" ]; then
        warn "couldn't update Prime Linux itself: this copy doesn't follow a release channel — carrying on"
    elif ! verdict="$("$BIN/prime-release-verify" "$REPO" "$target" 2>&1)"; then
        warn "didn't install the new Prime Linux: it isn't signed by Prime's release key. Your computer is unchanged."
        warn "(${verdict}) If this keeps happening, use Get help in Settings → About & Help."
    elif ! git -C "$REPO" merge-base HEAD "$target" >/dev/null 2>&1 \
         && [ -z "$(git -C "$REPO" status --porcelain --untracked-files=no 2>/dev/null)" ]; then
        # the published history was started afresh (nothing in common with this copy):
        # follow it, as long as nothing here was edited — it passed the same check above
        git -C "$REPO" reset --quiet --hard "$target"
        ok "updated (Prime Linux's history was started afresh; this copy now follows the new one)"
    elif ! merge_err="$(git -C "$REPO" merge --ff-only --quiet "$target" 2>&1)"; then
        warn "couldn't update Prime Linux itself (files in $REPO were edited) — carrying on"
        printf '%s\n' "$merge_err" >&2
    else
        after="$(git -C "$REPO" rev-parse --short HEAD)"
        if [ "$before" = "$after" ]; then ok "already up to date"
        else ok "updated"; git -C "$REPO" log --format='%s' "$before..$after" | head -8 | sed 's/^/      · /'; fi
    fi
elif grep -qiE 'username|authentication|could not read|403|repository not found|permission denied' <<<"$pull_err"; then
    warn "couldn't update Prime Linux itself: GitHub didn't let this computer in. Carrying on with the rest."
    warn "If this keeps happening, Get help (Settings → About & Help) makes a report for whoever helps you."
else
    warn "couldn't update Prime Linux itself (offline, or files in $REPO were edited) — carrying on"
fi
# say it when Prime itself isn't signature-checked (a test channel such as main)
case "${verdict:-}" in
    "not checked: the "*) note "This computer follows Prime's test channel ($(git -C "$REPO" symbolic-ref --short -q HEAD || echo detached)), so Prime's own updates aren't checked for a signature." ;;
esac

if [ "$ONLY_PRIME" = 0 ]; then
  # ── 2. ready? ──────────────────────────────────────────────────────────────
  step "Getting ready"
  if ! getent hosts cachyos.org >/dev/null 2>&1 && ! getent hosts archlinux.org >/dev/null 2>&1; then
    stop "No internet connection." "Connect to Wi-Fi or a cable (top bar → network), then run Update everything again." \
         "Nothing was changed."
  fi
  ok "internet works"
  for b in /sys/class/power_supply/*; do
    [ "$(cat "$b/type" 2>/dev/null)" = Battery ] && [ "$(cat "$b/scope" 2>/dev/null)" != Device ] || continue
    cap="$(cat "$b/capacity" 2>/dev/null)"; st="$(cat "$b/status" 2>/dev/null)"
    if [ "$st" = Discharging ] && [ "${cap:-100}" -lt 15 ]; then
      stop "The battery is at ${cap}%." "Plug in the charger first — an update must not be cut off by an empty battery." "Nothing was changed."
    fi
    [ "$st" = Discharging ] && warn "on battery (${cap}%) — plugging in is safer"
  done
  free="$(df -BG --output=avail / | tail -1 | tr -dc 0-9)"
  [ "${free:-0}" -ge 3 ] || stop "The disk is almost full (${free} GB free)." \
      "Empty the Trash and Downloads, or remove old game installs, then try again." \
      "Settings → Storage shows what takes the most room." "Nothing was changed."
  ok "${free} GB free on the disk"
  note "Prime needs your password once, to change the system."
  sudo -v || stop "The password wasn't accepted." "Nothing was changed. Try again, or ask whoever set up this computer."
  # keep sudo's permission alive for the AUR step after a long system update
  ( while sleep 50; do sudo -n -v 2>/dev/null || exit; done ) & KEEPALIVE=$!
  trap 'kill $KEEPALIVE 2>/dev/null' EXIT
  if ! bash "$LAYER/system/install-system.sh" needs-update >/dev/null 2>&1; then
    note "updating Prime's update service and safety settings…"
    sudo bash "$LAYER/system/install-system.sh" install --user "$(id -un)" 2>&1 | sed 's/^    /      /' \
      && ENGINE=/usr/local/lib/prime-linux/prime-system-update
  fi

  # ── 3. the system ──────────────────────────────────────────────────────────
  step "System (safety snapshot first)"
  out="$(mktemp)"; need="$(mktemp)"
  # only what's actually missing — a package "provided" by another (CachyOS's
  # tuned-ppd for power-profiles-daemon) must not be asked for, or pacman stops
  "$BIN/prime-missing-packages" > "$need" 2>/dev/null || : > "$need"
  sudo env PRIME_ALLOW_REAL_SYSTEM_CHANGES=yes "$ENGINE" apply --manual --ensure "$need" 2>&1 | tee "$out"
  rm -f "$need"
  result="$(sed -n 's/^RESULT //p' "$out" | tail -1)"; rm -f "$out"
  case "$result" in
    ok)        ok "system up to date" ;;
    attention) warn "system updated — see the ! lines above (nothing urgent)" ;;
    skipped)   stop "The system wasn't updated this time." "The reason is just above. Nothing was changed — try again later." ;;
    failed)    stop "The system update didn't go through." "The reason is just above. Your computer is exactly as it was." \
                    "If it keeps happening: Settings → Updates, or ask for help with the log in $STATE." ;;
    broken)    stop "The system update stopped part-way." \
                    "Your computer still works. Please don't restart it yet." \
                    "Run Update everything once more — it usually finishes the job." \
                    "If that doesn't help: Settings → Updates → Undo the last update shows the safe way back." ;;
    *)         stop "The updater stopped unexpectedly." "Nothing should have changed. Get help (Settings → About & Help) makes a report with the details." ;;
  esac

  # the login screen offers "Prime" (the install script leaves it saying Hyprland)
  sess="$LAYER/system/wayland-sessions/prime.desktop"
  if [ -f "$sess" ] && ! cmp -s "$sess" /usr/share/wayland-sessions/prime.desktop; then
    sudo install -Dm644 "$sess" /usr/share/wayland-sessions/prime.desktop \
      && ok "the login screen now offers Prime" || warn "couldn't add Prime to the login screen — the next update tries again"
  fi

  # ── 4. AUR (never unattended) ──────────────────────────────────────────────
  step "Community apps"
  if command -v paru >/dev/null && aur="$(paru -Qua 2>/dev/null)" && [ -n "$aur" ]; then
    printf '%s\n' "$aur" | sed 's/^/      · /'
    note "These come from the community collection: made by volunteers and not checked by CachyOS."
    if confirm "Update them too?" y; then
      paru -Sua --skipreview || warn "some community apps didn't update — they keep working as they are"
    else note "skipped — they keep working as they are"; fi
  else ok "nothing to update"; fi

  # ── 5. App Store (system-wide apps were done in step 3) ────────────────────
  step "App Store apps"
  if command -v flatpak >/dev/null && flatpak list --user --app 2>/dev/null | grep -q .; then
    flatpak update --user -y --noninteractive >/dev/null 2>&1 && ok "your apps are up to date" || warn "some apps couldn't update — try again later"
  else ok "up to date"; fi
fi

# ── refresh the desktop ──────────────────────────────────────────────────────
if [ -n "${PRIME_PANEL:-}" ]; then echo "@step Refreshing the desktop"; else printf '\n%sRefreshing the desktop%s\n' "$B" "$R"; fi
for u in "$LAYER"/systemd/*; do ln -sfn "$u" "$HOME/.config/systemd/user/$(basename "$u")"; done
systemctl --user daemon-reload 2>/dev/null
"$BIN/prime-migrate" || warn "some one-time upgrade steps will retry at the next update"
"$BIN/prime-addon" --relink >/dev/null 2>&1
"$BIN/prime-theme" --apply >/dev/null 2>&1
if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    "$BIN/prime-titlebars" --rebuild >/dev/null 2>&1 && ok "window title bars rebuilt for this version" \
        || warn "window title bars couldn't be rebuilt now (the next login retries)"
fi
if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    hyprctl reload >/dev/null
    systemctl --user stop prime-bar@side 2>/dev/null     # the dock replaced the side bar
    systemctl --user daemon-reload 2>/dev/null
    systemctl --user restart prime-session.target prime-bar@top prime-dock 2>/dev/null
fi
rm -f "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/waybar-updates.json"
mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/prime"
jq -r '.seq // empty' "$STATE/last-run.json" 2>/dev/null > "${XDG_STATE_HOME:-$HOME/.local/state}/prime/updates-seen"

case "$(jq -r '.restart // "no"' "$STATE/last-run.json" 2>/dev/null)" in
  yes)  after="Restart the computer when convenient — a new system core is installed." ;;
  soon) after="Restarting when convenient makes every part use the new versions." ;;
  *)    after="Nothing else to do." ;;
esac
if [ -n "${PRIME_PANEL:-}" ]; then
    echo "@summary All done. $after"
    printf '@action %s\t%s\n' "Check the desktop" "$BIN/prime-doctor"
else
    printf '\n%sDone.%s %s\n' "$B" "$R" "$after"
    echo "If anything looks wrong: Super+H checks and repairs the desktop; prime-update --undo goes back."
fi
