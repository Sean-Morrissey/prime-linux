#!/usr/bin/env bash
# prime-update — update everything: Prime itself, the system, App Store apps,
# and the window title bars. A system snapshot and a copy of your desktop
# settings are taken first (package hooks), so a bad update can be undone
# (start-up menu / Prime menu → Style & repair → Restore desktop settings).
#
#   prime-update            update everything (in a Prime window when opened
#                           from the bar, the menu or the app list)
#   prime-update --prime    only Prime itself (no system packages)
#
# The password is asked for in a Prime window (prime-askpass), never a terminal.
set -u
LAYER="$(readlink -f "$(dirname "$(readlink -f "$0")")/..")"
REPO="$(readlink -f "$LAYER/..")"
BIN="$LAYER/bin"
ONLY_PRIME=0; [ "${1:-}" = "--prime" ] && ONLY_PRIME=1

if [ -z "${PRIME_PANEL:-}${PRIME_NO_PANEL:-}" ] && [ ! -t 1 ] && [ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]; then
    exec "$BIN/prime-panel" --title "Update everything" \
        --subtitle "Prime, the system and your apps. A snapshot is taken first, so this can be undone." -- "$0" "$@"
fi

# "@kind text" for the Prime window; plain lines in a terminal
if [ -n "${PRIME_PANEL:-}" ]; then
    step() { echo "@step $*"; }; good() { echo "@ok $*"; }; warn() { echo "@bad $*"; }; note() { echo "@note $*"; }
    SUDO=(sudo -A); NOCONFIRM=(--noconfirm)
    export PRIME_ASKPASS_REASON="Prime needs your password to install the system updates."
else
    A=$'\e[38;2;248;113;113m'; B=$'\e[1m'; R=$'\e[0m'
    step() { printf '\n%s==>%s %s%s%s\n' "$A" "$R" "$B" "$*" "$R"; }
    good() { echo "    $*"; }; warn() { echo "    ! $*"; }; note() { echo "    $*"; }
    SUDO=(sudo); NOCONFIRM=()
fi
problems=0

step "Updating Prime"
before="$(git -C "$REPO" rev-parse --short HEAD)"
if git -C "$REPO" pull --ff-only --quiet; then
    after="$(git -C "$REPO" rev-parse --short HEAD)"
    if [ "$before" = "$after" ]; then good "Prime is already up to date"
    else
        good "Prime updated"
        git -C "$REPO" log --format='%s' "$before..$after" | head -15 | sed 's/^/      /'
    fi
else
    warn "Couldn't update Prime right now (no internet?) — carrying on with the rest"; problems=$((problems+1))
fi

if [ $ONLY_PRIME = 0 ]; then
    step "Updating the system"
    mapfile -t want < <(grep -vE '^\s*(#|$)' "$REPO/os/arch/packages.txt")
    if command -v paru >/dev/null; then paru -Syu --needed "${NOCONFIRM[@]}" --sudoflags "${SUDO[*]:1}" "${want[@]}"
    else "${SUDO[@]}" pacman -Syu --needed "${NOCONFIRM[@]}" "${want[@]}"; fi
    if [ $? = 0 ]; then good "System up to date"
    else warn "The system update didn't finish — nothing was half-applied; try again later"; problems=$((problems+1)); fi

    # the login screen offers "Prime" (the install script leaves it saying Hyprland)
    sess="$LAYER/system/wayland-sessions/prime.desktop"
    if ! cmp -s "$sess" /usr/share/wayland-sessions/prime.desktop; then
        if "${SUDO[@]}" install -Dm644 "$sess" /usr/share/wayland-sessions/prime.desktop; then
            good "The login screen now offers Prime"
        else warn "Couldn't add Prime to the login screen — it will be tried again next update"; problems=$((problems+1)); fi
    fi

    if command -v flatpak >/dev/null; then
        step "Updating App Store apps"
        if flatpak update -y --noninteractive; then good "App Store apps up to date"
        else warn "Some App Store apps couldn't update — try again later"; problems=$((problems+1)); fi
    fi
fi

step "Refreshing the desktop"
for u in "$LAYER"/systemd/*; do ln -sfn "$u" "$HOME/.config/systemd/user/$(basename "$u")"; done
systemctl --user daemon-reload
"$BIN/prime-addon" --relink >/dev/null
"$BIN/prime-theme" --apply
if hyprpm update >/dev/null 2>&1 && hyprpm reload -n >/dev/null 2>&1; then good "Window title bars rebuilt for this version"
else warn "Window title bars couldn't be rebuilt (no internet?) — they'll be retried next update"; problems=$((problems+1)); fi
if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    hyprctl reload >/dev/null
    systemctl --user restart prime-session.target prime-bar@top prime-bar@side 2>/dev/null
fi
rm -f "${XDG_RUNTIME_DIR:-/tmp}/waybar-updates.json"
good "Desktop refreshed"

if [ -n "${PRIME_PANEL:-}" ]; then
    if [ $problems = 0 ]; then echo "@summary All up to date. If anything looks wrong, Super+H checks and repairs the desktop."
    else echo "@summary Finished, with $problems part(s) to retry later. Super+H checks and repairs the desktop."; fi
    printf '@action %s\t%s\n' "Check the desktop" "$BIN/prime-doctor"
else
    printf '\n%sDone.%s If anything looks wrong: Super+H checks and repairs the desktop.\n' "$B" "$R"
fi
