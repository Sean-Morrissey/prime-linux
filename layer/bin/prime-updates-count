#!/usr/bin/env bash
# prime-updates-count — package-update counter for the bar (custom/updates).
#
# Always prints one valid JSON line (an empty result would hide the module).
# It caches the result so the bar never waits on `checkupdates` (which
# takes ~5-10s and blocks on /var/lib/pacman/db.lck):
#   * cache younger than CACHE_TTL  -> print it and exit (instant)
#   * otherwise re-count, rewrite the cache, print
#   * counting fails / db locked    -> still print the last known value
#
#   prime-updates-count            status (cached)
#   prime-updates-count --refresh  force a re-count
#   prime-updates-count --list     what's waiting, one "@row" per update (Prime window)
set -u

if [ "${1:-}" = "--list" ]; then
    BIN="$(dirname "$(readlink -f "$0")")"
    if [ -z "${PRIME_PANEL:-}${PRIME_NO_PANEL:-}" ] && [ ! -t 1 ] && [ -n "${WAYLAND_DISPLAY:-}${DISPLAY:-}" ]; then
        exec "$BIN/prime-panel" --title "What's waiting to update" \
            --subtitle "Nothing changes until you choose Update everything." -- "$0" --list
    fi
    echo "@step Checking for updates"
    n=0
    while read -r name old _ new; do
        [ -n "$name" ] || continue
        printf '@row %s\t%s → %s\n' "$name" "$old" "$new"; n=$((n+1))
    done < <(timeout 60 checkupdates 2>/dev/null)
    apps="$(flatpak remote-ls --updates --columns=name 2>/dev/null | sed '/^$/d')"
    while read -r a; do [ -n "$a" ] && { printf '@row %s\t%s\n' "$a" "App Store app"; n=$((n+1)); }; done <<<"$apps"
    if [ $n = 0 ]; then echo "@summary Everything is up to date."
    else
        echo "@summary $n update(s) waiting."
        printf '@action %s\t%s\n' "Update everything" "$BIN/prime-update"
    fi
    exit 0
fi

CACHE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/waybar-updates.json"
CACHE_TTL=900          # seconds; bar polls every 15 min
CHECK_TIMEOUT=45       # hard cap on checkupdates / paru
LOCK=/var/lib/pacman/db.lck

force=0
[ "${1:-}" = "--refresh" ] && force=1

cache_age() {                     # seconds since the cache was written, or -1
    [ -f "$CACHE" ] || { echo -1; return; }
    echo $(( $(date +%s) - $(stat -c %Y "$CACHE" 2>/dev/null || echo 0) ))
}

# ── fast path: fresh cache ────────────────────────────────────────────────────
age=$(cache_age)
if [ "$force" -eq 0 ] && [ "$age" -ge 0 ] && [ "$age" -lt "$CACHE_TTL" ]; then
    cat "$CACHE"
    exit 0
fi

# ── count ────────────────────────────────────────────────────────────────────
official=0
aur=0
stale=0

# Don't fight a live transaction; checkupdates' own db copy is fine, but the
# real pacman lock means another run is mid-check and we'd just block.
if [ -f "$LOCK" ]; then
    stale=1
else
    if command -v checkupdates >/dev/null 2>&1; then
        official=$(timeout "$CHECK_TIMEOUT" checkupdates 2>/dev/null | wc -l | tr -d ' ')
    fi
    helper=""
    for h in paru yay; do
        if command -v "$h" >/dev/null 2>&1; then helper="$h"; break; fi
    done
    if [ -n "$helper" ]; then
        aur=$(timeout "$CHECK_TIMEOUT" "$helper" -Qum 2>/dev/null | wc -l | tr -d ' ')
    fi
fi

# Anything non-numeric (partial failure) becomes 0, never an empty field.
case "$official" in ''|*[!0-9]*) official=0 ;; esac
case "$aur"      in ''|*[!0-9]*) aur=0      ;; esac
total=$((official + aur))

# ── class by severity (styled in the bar CSS) ────────────────────────────
if   [ "$stale" -eq 1 ]; then cls="yellow"
elif [ "$total" -eq 0  ]; then cls="green"
elif [ "$total" -gt 100   ]; then cls="red"
elif [ "$total" -gt 25    ]; then cls="yellow"
else                           cls="normal"
fi

when=$(date +%H:%M)
if [ "$stale" -eq 1 ]; then
    tip="Updates: an update is running right now — showing the last count\nchecked $when"
elif [ "$total" -eq 0 ]; then
    tip="Updates: everything is up to date\nchecked $when · right-click for more"
else
    tip="Updates: $total waiting\nclick to update everything · right-click to see the list\nchecked $when"
fi

line=$(printf '{"text":"%s","class":"%s","tooltip":"%s"}\n' "$total" "$cls" "${tip//$'\n'/\\n}")

# Only overwrite the cache with a real measurement.
if [ "$stale" -eq 0 ]; then
    printf '%s\n' "$line" > "$CACHE.tmp" && mv -f "$CACHE.tmp" "$CACHE"
fi
printf '%s\n' "$line"
