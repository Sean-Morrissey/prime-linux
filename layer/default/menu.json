{
  "sections": [
    {
      "id": "apps",
      "label": "Apps",
      "icon": "󰣇",
      "list": "apps",
      "pins": [
        "nemo",
        "org.gnome.Software",
        "firefox",
        "chromium",
        "steam"
      ],
      "items": [
        {
          "id": "apps.spotlight",
          "label": "Search everything",
          "hint": "Super+Space",
          "kind": "run",
          "cmd": "exec ~/.local/share/prime-linux/layer/bin/prime-spotlight"
        },
        {
          "id": "apps.store",
          "label": "App Store",
          "hint": "install apps with a click",
          "kind": "run",
          "cmd": "exec gnome-software"
        },
        {
          "id": "apps.activity",
          "label": "Activity",
          "hint": "what's using the computer right now",
          "kind": "run",
          "cmd": "exec ~/.local/share/prime-linux/layer/bin/prime-activity"
        }
      ]
    },
    {
      "id": "settings",
      "label": "Settings",
      "icon": "󰒓",
      "items": [
        {
          "id": "set.shortcuts",
          "label": "Keyboard shortcuts",
          "hint": "Super+/",
          "kind": "run",
          "cmd": "exec ~/.local/share/prime-linux/layer/bin/prime-keys"
        },
        {
          "id": "set.theme",
          "label": "Theme — wallpaper, accent colour, text size",
          "hint": "Super+Shift+W",
          "kind": "run",
          "cmd": "exec ~/.local/share/prime-linux/layer/bin/prime-theme"
        },
        {
          "id": "set.text",
          "label": "Text size",
          "hint": "one size for the whole desktop",
          "kind": "run",
          "cmd": "exec ~/.local/share/prime-linux/layer/bin/prime-theme --text"
        },
        {
          "id": "set.displays",
          "label": "Displays",
          "hint": "arrange screens, resolution, refresh rate",
          "kind": "run",
          "cmd": "exec nwg-displays"
        },
        {
          "id": "set.network",
          "label": "Wi-Fi & network",
          "kind": "run",
          "cmd": "exec ~/.local/share/prime-linux/layer/bin/prime-wifi",
          "hint": "join a network, turn Wi-Fi on or off"
        },
        {
          "id": "set.bluetooth",
          "label": "Bluetooth",
          "kind": "run",
          "cmd": "exec blueman-manager"
        },
        {
          "id": "set.audio",
          "label": "Sound",
          "hint": "outputs, inputs, per-app volume",
          "kind": "run",
          "cmd": "exec pavucontrol"
        },
        {
          "id": "set.apps",
          "label": "Default apps",
          "hint": "browser and file manager",
          "kind": "run",
          "cmd": "exec ~/.local/share/prime-linux/layer/bin/prime-default-apps"
        },
        {
          "id": "set.store",
          "label": "App Store",
          "kind": "run",
          "cmd": "exec gnome-software"
        },
        {
          "id": "set.addons",
          "label": "Add-ons",
          "hint": "optional extras, e.g. the Ask Prime assistant",
          "kind": "run",
          "cmd": "exec ~/.local/share/prime-linux/layer/bin/prime-addon --choose"
        },
        {
          "id": "set.hyprconf",
          "label": "Advanced window & keyboard settings",
          "hint": "your own settings file, opens in Text Editor",
          "kind": "run",
          "cmd": "exec gnome-text-editor ~/.config/hypr/hyprland.conf"
        }
      ]
    },
    {
      "id": "style",
      "label": "Style & repair",
      "icon": "󰸉",
      "items": [
        {
          "id": "style.doctor",
          "label": "Check and fix the desktop",
          "hint": "Super+H",
          "kind": "run",
          "cmd": "exec ~/.local/share/prime-linux/layer/bin/prime-doctor"
        },
        {
          "id": "style.restore",
          "label": "Restore desktop settings",
          "hint": "undo — back to a copy saved before an update",
          "kind": "run",
          "cmd": "exec ~/.local/share/prime-linux/layer/bin/prime-desktop-backup restore"
        },
        {
          "id": "style.save",
          "label": "Save desktop settings now",
          "hint": "a copy is also saved before every update",
          "kind": "run",
          "cmd": "~/.local/share/prime-linux/layer/bin/prime-desktop-backup save manual && notify-send -a Prime 'Desktop settings saved'"
        },
        {
          "id": "style.restartbars",
          "label": "Restart the bar",
          "hint": "Super+W",
          "kind": "run",
          "cmd": "exec ~/.local/share/prime-linux/layer/bin/prime-bar restart"
        },
        {
          "id": "style.anim",
          "label": "Animations on / off",
          "kind": "run",
          "cmd": "exec ~/.local/share/prime-linux/layer/bin/prime-toggle-animations"
        },
        {
          "id": "style.reload",
          "label": "Reload window settings",
          "kind": "run",
          "cmd": "hyprctl reload && notify-send -a Prime 'Window settings reloaded'"
        }
      ]
    },
    {
      "id": "update",
      "label": "Update",
      "icon": "󰚰",
      "items": [
        {
          "id": "upd.all",
          "label": "Update everything",
          "hint": "the system, apps and Prime — a snapshot is taken first",
          "kind": "run",
          "cmd": "exec ~/.local/share/prime-linux/layer/bin/prime-update"
        },
        {
          "id": "upd.check",
          "label": "What's waiting to update",
          "kind": "run",
          "cmd": "exec ~/.local/share/prime-linux/layer/bin/prime-updates-count --list"
        },
        {
          "id": "upd.snapshots",
          "label": "Undo an update",
          "hint": "go back to before the last update, from the start-up menu",
          "kind": "run",
          "cmd": "exec ~/.local/share/prime-linux/layer/bin/prime-snapshots"
        }
      ]
    },
    {
      "id": "power",
      "label": "Power",
      "icon": "󰐥",
      "items": [
        {
          "id": "power.menu",
          "label": "Lock · sleep · restart · shut down",
          "kind": "run",
          "cmd": "exec ~/.local/share/prime-linux/layer/bin/prime-power-menu"
        },
        {
          "id": "power.lock",
          "label": "Lock the screen",
          "hint": "Super+L",
          "kind": "run",
          "cmd": "loginctl lock-session"
        }
      ]
    },
    {
      "id": "about",
      "label": "About",
      "icon": "󰋽",
      "items": [
        {
          "id": "about.prime",
          "label": "About Prime",
          "kind": "run",
          "cmd": "exec ~/.local/share/prime-linux/layer/bin/prime-about"
        },
        {
          "id": "about.info",
          "label": "This computer",
          "kind": "run",
          "cmd": "exec ~/.local/share/prime-linux/layer/bin/prime-about --computer"
        },
        {
          "id": "about.barkeys",
          "label": "Use the bar from the keyboard",
          "hint": "Super+Alt+B",
          "kind": "run",
          "cmd": "exec ~/.local/share/prime-linux/layer/bin/prime-bar --keys"
        }
      ]
    }
  ]
}
