/*
 * Prime small pickers that drop out of the bar (power menu, quick questions).
 */
@import "~/.config/prime/theme/colors.rasi"
/* every font size comes from Theme → Text size (generated by prime-theme) */
@import "~/.config/prime/theme/fonts.rasi"

/* One look for every Prime box (menu.rasi, spotlight.rasi, bar.rasi share this core):
   a frosted dark card with a 1px hairline and 14px corners, a search field with a
   magnifier, rows with a fixed icon column, dimmer secondary text, equal row
   heights, and a soft rounded accent fill on the selected row. */
* {
    font:                        @prime-font-body;
    bg-base:                     rgba(12, 12, 16, 0.96);   /* surface-1 #0c0c10 */
    bg-input:                    rgba(10, 10, 14, 0.96);   /* surface-0 #0a0a0e */
    hairline:                    rgba(255, 255, 255, 0.08);
    fg-primary:                  #ececef;
    fg-secondary:                #a1a1a6;

    background-color:            transparent;
    text-color:                  @fg-primary;
    margin:                      0;
    padding:                     0;
    spacing:                     0;
}

window {
    width:                       560px;
    background-color:            @bg-base;
    border:                      1px;
    border-color:                @hairline;
    border-radius:               14px;
    location:                    north;
    anchor:                      north;
    y-offset:                    48px;
    padding:                     8px;
}

mainbox {
    children:                    [ inputbar, listview, message ];
    spacing:                     8px;
}

inputbar {
    background-color:            @bg-input;
    border:                      1px;
    border-color:                @hairline;
    border-radius:               10px;
    padding:                     8px 12px;
    children:                    [ icon-search, prompt, textbox-prompt-colon, entry ];
    spacing:                     8px;
}

icon-search {
    expand:                      false;
    filename:                    "system-search-symbolic";
    size:                        18px;
    vertical-align:              0.5;
}

/* "Prime › Settings": the breadcrumb ends in a chevron, so it never reads as part of what you type */
textbox-prompt-colon {
    expand:                      false;
    str:                         "›";
    text-color:                  @fg-secondary;
    vertical-align:              0.5;
}

/* the prompt is a quiet breadcrumb ("Prime", "Settings", "Wi-Fi"), not a headline */
prompt {
    font:                        @prime-font-body-m;
    text-color:                  @fg-secondary;
    vertical-align:              0.5;
}

entry {
    font:                        @prime-font-l;
    text-color:                  @fg-primary;
    placeholder:                 "Type to filter…";
    placeholder-color:           @fg-secondary;
    vertical-align:              0.5;
    cursor:                      text;
}

message {
    padding:                     8px 12px;
}

textbox {
    font:                        @prime-font-s;
    text-color:                  @fg-secondary;
    vertical-align:              0.5;
}

listview {
    columns:                     1;
    lines:                       12;
    spacing:                     4px;
    fixed-height:                false;
    fixed-num-lines:             false;
    dynamic:                     true;
    cycle:                       true;
    scrollbar:                   false;
    padding:                     4px 0px;
}

element {
    background-color:            transparent;
    text-color:                  @fg-primary;
    border:                      1px;
    border-color:                transparent;
    border-radius:               6px;
    padding:                     8px 12px;
    spacing:                     12px;
    children:                    [ element-icon, element-text ];
    cursor:                      pointer;
}

element selected.normal, element selected.active {
    background-color:            @bg-selected;
    border-color:                @border-focus;
    text-color:                  @fg-primary;
}

element-icon {
    size:                        24px;
    vertical-align:              0.5;
}

element-text {
    font:                        @prime-font-body;
    text-color:                  inherit;
    vertical-align:              0.5;
}
