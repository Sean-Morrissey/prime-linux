/**
 * Prime right-click menu — the universal context menu for the desktop.
 *
 * Used by prime-context (every bar element's right-click,
 * and the desktop itself). Windows-like: click anywhere outside and it closes
 * (the engine passes -click-to-exit); groups are split by dimmed rules.
 *
 *   rofi -dmenu -i -no-custom -click-to-exit -markup-rows \
 *        -theme menu -p "󰚩 <Label>" -mesg "<live value>"
 */
@import "~/.config/prime/theme/colors.rasi"
/* every font size comes from Theme → Text size (generated by prime-theme) */
@import "~/.config/prime/theme/fonts.rasi"

* {
    font:                        @prime-font-body;
    bg-base:                     rgba(12, 12, 16, 0.96);
    hairline:                    rgba(255, 255, 255, 0.09);
    fg-primary:                  #e8e8ec;
    fg-secondary:                #97979f;

    background-color:            transparent;
    text-color:                  @fg-primary;
    margin:                      0;
    padding:                     0;
    spacing:                     0;
}

window {
    width:                       520px;
    background-color:            @bg-base;
    border:                      1px;
    border-color:                @hairline;
    border-radius:               12px;
    location:                    north;
    anchor:                      north;
    y-offset:                    52px;
    padding:                     6px;
}

mainbox {
    background-color:            transparent;
    children:                    [ message, listview ];
    spacing:                     2px;
}

/* The live value of the thing you right-clicked — one quiet line, ruled off
   from the actions below it. */
message {
    background-color:            transparent;
    border:                      0px 0px 1px 0px;
    border-color:                @hairline;
    padding:                     10px 12px 9px 12px;
}

message-text {
    font:                        @prime-font-mono-s;
    text-color:                  @fg-secondary;
    vertical-align:              0.5;
}

listview {
    background-color:            transparent;
    columns:                     1;
    lines:                       12;
    spacing:                     0px;
    dynamic:                     true;
    scrollbar:                   false;
    padding:                     4px 0px;
}

element {
    background-color:            transparent;
    text-color:                  @fg-primary;
    border-radius:               7px;
    padding:                     8px 12px;
}

/* Windows-ish highlight: a soft fill, not a loud colour. */
element selected.normal {
    background-color:            rgba(255, 255, 255, 0.08);
    text-color:                  #ffffff;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    font:                        @prime-font-body;
    vertical-align:              0.5;
}

/* App rows (rofi -show-icons): the app's own icon, sized like the rows. */
element-icon {
    background-color:            transparent;
    size:                        26px;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}

prompt {
    font:                        @prime-font-m;
    text-color:                  @fg-secondary;
    padding:                     9px 12px 2px 12px;
    vertical-align:              0.5;
}
