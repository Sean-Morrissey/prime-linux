// Prime's terminal greeting (fastfetch, shown by the shell's greeting).
// P.R.I.M.E — Please Relax I'll Manage Everything.
// Seeded by prime-linux; it's yours now — prime-update never overwrites it.
// The logo itself (~/.config/prime/prime-logo.txt) is Prime's and is refreshed
// by every update (layer/branding/terminal/, made by make-terminal-logo.py).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.config/prime/prime-logo.txt",
    // 8 lines x 38 columns; the module list below is ~19 lines, so 5 lines of
    // top padding centre the logo against it
    "width": 38,
    "height": 8,
    "padding": { "top": 5, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;134;152;251", "title": "38;2;96;165;250" }
  },
  // values are kept short: next to the 42-column logo a long line wraps
  // under it in an 80-column terminal
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "System" },
    { "type": "host", "key": "Computer" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "uptime", "key": "On for" },
    { "type": "packages", "key": "Apps" },
    { "type": "shell", "key": "Shell" },
    { "type": "display", "key": "Screen", "format": "{width}x{height} @ {refresh-rate} Hz" },
    { "type": "wm", "key": "Desktop" },
    { "type": "terminal", "key": "Terminal" },
    { "type": "cpu", "key": "Processor", "format": "{name}" },
    { "type": "gpu", "key": "Graphics", "format": "{name}" },
    { "type": "memory", "key": "Memory" },
    { "type": "disk", "key": "Disk", "folders": "/", "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "battery", "key": "Battery" },
    "break",
    "colors"
  ]
}
