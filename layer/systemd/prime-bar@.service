[Unit]
# a part that keeps crashing stops after 10 tries in 2 minutes, and says so (prime-failed)
StartLimitIntervalSec=120
StartLimitBurst=10
OnFailure=prime-failed@%p.service
Description=Prime Linux bar (%i)
PartOf=prime-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/share/prime-linux/layer/bin/prime-bar %i
Restart=on-failure
RestartSec=2

