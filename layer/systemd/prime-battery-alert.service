[Unit]
# a part that keeps crashing stops after 10 tries in 2 minutes, and says so (prime-failed)
StartLimitIntervalSec=120
StartLimitBurst=10
OnFailure=prime-failed@%p.service
Description=Low-battery warning
PartOf=prime-session.target
# desktops have no battery: nothing to start
ConditionPathExistsGlob=/sys/class/power_supply/BAT*

[Service]
ExecStart=%h/.local/share/prime-linux/layer/bin/prime-battery-alert
Restart=on-failure
RestartSec=30
