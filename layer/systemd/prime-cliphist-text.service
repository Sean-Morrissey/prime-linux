[Unit]
Description=Clipboard history (text)
PartOf=prime-session.target
# wl-paste exits 1 when the Wayland socket isn't up yet, which on a slow boot it
# isn't. With systemd's default limit (5 starts / 10s) the retries at RestartSec=2
# run out in ten seconds and the unit gives up for the whole session — clipboard
# history silently dead, with nothing on screen to say so. Keep retrying instead.
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/wl-paste --type text --watch /usr/bin/cliphist store
Restart=on-failure
RestartSec=2
