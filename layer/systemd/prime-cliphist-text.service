[Unit]
# a part that keeps crashing stops after 10 tries in 2 minutes, and says so (prime-failed)
StartLimitIntervalSec=120
StartLimitBurst=10
OnFailure=prime-failed@%p.service
Description=Clipboard history (text)
PartOf=prime-session.target

[Service]
ExecStart=/usr/bin/wl-paste --type text --watch /usr/bin/cliphist store
Restart=on-failure
RestartSec=2
