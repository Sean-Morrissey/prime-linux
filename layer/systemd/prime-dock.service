[Unit]
Description=Prime Linux dock (pinned and open apps, hidden until the pointer reaches the bottom)
PartOf=prime-session.target
After=graphical-session.target prime-bar@top.service
# Same as the bar: no Wayland display yet means exit 1, and systemd's default
# limit (5 starts / 10s) at RestartSec=2 would make that permanent for the
# session. Keep retrying until the compositor is up.
StartLimitIntervalSec=0

[Service]
ExecStart=%h/.local/share/prime-linux/layer/bin/prime-dock
Restart=on-failure
RestartSec=2
