# NOTE 1: this file deliberately does NOT contain CachyOS's airootfs-removal marker.
# Their zzzz99-remove-custom-hooks-from-airootfs.hook matches that marker anywhere in a file —
# comment text included — and deletes every hook in this directory that contains it. Our hook
# has to survive into the live session, because the live session reinstalls the installer
# package (calamares-online.sh: pacman -Sy cachyos-calamares-next) right before launching it,
# and that reinstall would restore the packaged configuration and quietly undo everything
# below. If you edit this file, keep their marker phrase out of it; the check in
# tools/apply-buildset.sh fails the buildset if it reappears.
#
# NOTE 2: Exec goes through /bin/sh, and the script is run as an argument to `sh`, not as a
# program. mkarchiso copies airootfs with `cp -af --no-preserve=ownership,mode`, so every file
# that arrives in the live image is mode 0644: nothing from airootfs is ever executable there.
# CachyOS's own hooks use the same /bin/sh -c form for this reason. `test -f` (not `test -x`),
# and the `|| true` keeps a missing script from failing a transaction inside the target.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = cachyos-calamares-next
Target = cachyos-calamares

[Action]
Description = Applying Prime OS installer configuration...
When = PostTransaction
Depends = coreutils
Exec = /bin/sh -c "test -f /usr/local/bin/prime-live-overrides && sh /usr/local/bin/prime-live-overrides || true"
