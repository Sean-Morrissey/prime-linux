[Unit]
Description=Prime speaks replies through the local TTS path (edge voice + ducking)
After=sound.target

[Service]
Type=simple
ExecStart=@HOME@/.hermes/hermes-agent/venv/bin/python @HOME@/.hermes/scripts/prime-speak.py
Restart=always
RestartSec=3
Environment=XDG_RUNTIME_DIR=/run/user/1000

[Install]
WantedBy=default.target
