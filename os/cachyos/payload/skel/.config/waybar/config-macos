{
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "height": 38,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "spacing": 0,
    "modules-left": [
        "custom/logo",
        "group/assist",
        "custom/spotifyPrev",
        "custom/spotifyPlay",
        "custom/spotifyNext",
        "custom/spotify",
        "tray"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/primeVoice",
        "custom/audio",
        "network",
        "bluetooth",
        "cpu",
        "memory",
        "custom/gpu",
        "custom/updates",
        "custom/wallpaper",
        "custom/notification",
        "custom/power"
    ],
    "custom/logo": {
        "format": "<span size='x-large'>󰣇</span>",
        "on-click": "@HOME@/.config/hypr/scripts/launcher.sh",
        "on-click-right": "@HOME@/.config/prime/prime-context.sh bar.logo",
        "tooltip-format": "CachyOS • Launch App"
    },
    "hyprland/workspaces": {
        "disable-scroll": false,
        "all-outputs": false,
        "active-only": false,
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",
        "format": "{icon}",
        "format-icons": {
            "active": "●",
            "occupied": "◉",
            "default": "○",
            "urgent": "◈"
        },
        "persistent-workspaces": {
            "*": 5
        }
    },
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 20,
        "spacing": 3,
        "on-click": "activate",
        "on-click-middle": "close",
        "on-click-right": "minimize-raise",
        "tooltip-format": "{title}",
        "all-outputs": true
    },
    "tray": {
        "icon-size": 16,
        "spacing": 6
    },
    "clock": {
        "format": "{:%a %b %d   %I:%M %p}",
        "format-alt": "{:%A, %B %d, %Y  (%R)}",
        "interval": 1,
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<span color='#f5f5f7'><b>{}</b></span>",
                "days": "<span color='#a1a1a6'>{}</span>",
                "today": "<span color='#34d399'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click": "shift_down",
            "on-click-right": "mode"
        },
        "on-click-right": "@HOME@/.config/prime/prime-context.sh bar.clock"
    },
    "mpris": {
        "format": "<span color='#34d399'>{player_icon}</span>  {dynamic}",
        "format-paused": "<span color='#6ee7b7'>{player_icon}</span>  <i>{dynamic}</i>",
        "dynamic-len": 22,
        "dynamic-order": [
            "title",
            "artist"
        ],
        "player-icons": {
            "default": "",
            "spotify": "󰓇",
            "google-chrome": "",
            "vlc": "󰕼"
        },
        "ignored-players": [
            "firefox"
        ],
        "tooltip-format": "{title} — {artist}",
        "on-click": "playerctl play-pause"
    },
    "group/assist": {
        "orientation": "horizontal",
        "modules": [
            "custom/hermes",
            "custom/whiteboard",
            "custom/ledger",
            "custom/hermesScreen",
            "custom/primeSpeak"
        ]
    },
    "custom/hermes": {
        "exec": "@HOME@/.config/waybar/scripts/prime-pill.py",
        "interval": 1,
        "return-type": "json",
        "tooltip": true,
        "on-click": "@HOME@/.config/waybar/scripts/prime-bar-input.sh",
        "on-click-right": "@HOME@/.config/prime/prime-context.sh bar.hermes",
        "on-click-middle": "@HOME@/.config/waybar/scripts/prime-bar-input.sh --popup"
    },
    "custom/whiteboard": {
        "exec": "python3 @HOME@/.config/waybar/scripts/prime-board-pill.py",
        "interval": 3,
        "return-type": "json",
        "tooltip": true,
        "on-click": "@HOME@/.config/waybar/scripts/prime-board.sh show",
        "on-click-middle": "@HOME@/.config/waybar/scripts/prime-board.sh timeline",
        "on-click-right": "@HOME@/.config/prime/prime-context.sh bar.whiteboard"
    },
    "custom/ledger": {
        "exec": "python3 @HOME@/.config/waybar/scripts/ledger-pill.py",
        "interval": 2,
        "return-type": "json",
        "escape": true,
        "tooltip": true,
        "on-click": "@HOME@/.config/waybar/scripts/ledger-bar.sh add",
        "on-click-middle": "@HOME@/.config/waybar/scripts/ledger-bar.sh view",
        "on-click-right": "bash -c 'sleep 0.35; exec @HOME@/.config/waybar/scripts/ledger-bar.sh menu'"
    },
    "custom/hermesScreen": {
        "format": "󰄄 snip",
        "tooltip": true,
        "tooltip-format": "Click: drag a region, then pick an action (Ask Prime · whiteboard · annotate · copy · folder · delete)\\nMiddle-click: drag a region and ask straight away · Right-click: whole desktop → ask\\nSuper+Alt+W: snip straight to the whiteboard",
        "on-click": "bash @HOME@/.config/hypr/scripts/prime-snip.sh area",
        "on-click-right": "@HOME@/.config/prime/prime-context.sh bar.snip",
        "on-click-middle": "@HOME@/.config/waybar/scripts/prime-bar-input.sh --screen"
    },
    "custom/primeSpeak": {
        "exec": "@HOME@/.config/waybar/scripts/prime-speak-status.sh",
        "interval": 1,
        "return-type": "json",
        "tooltip": true,
        "on-click": "@HOME@/.config/waybar/scripts/prime-speak-toggle.sh",
        "on-click-right": "systemctl --user restart prime-speak"
    },
    "custom/spotifyPrev": {
        "format": "󰒮",
        "tooltip": false,
        "on-click": "@HOME@/.config/waybar/scripts/spotify-pill.py prev",
        "on-click-right": "@HOME@/.config/prime/prime-context.sh bar.media",
        "on-click-middle": "@HOME@/.config/waybar/scripts/spotify-pill.py toggle"
    },
    "custom/spotifyPlay": {
        "exec": "@HOME@/.config/waybar/scripts/spotify-pill.py transport",
        "interval": 1,
        "return-type": "json",
        "tooltip": true,
        "on-click": "@HOME@/.config/waybar/scripts/spotify-pill.py toggle",
        "on-click-right": "@HOME@/.config/prime/prime-context.sh bar.media",
        "on-click-middle": "@HOME@/.config/waybar/scripts/spotify-pill.py prev",
        "on-scroll-up": "@HOME@/.config/waybar/scripts/spotify-pill.py volup",
        "on-scroll-down": "@HOME@/.config/waybar/scripts/spotify-pill.py voldown"
    },
    "custom/spotifyNext": {
        "format": "󰒭",
        "tooltip": false,
        "on-click": "@HOME@/.config/waybar/scripts/spotify-pill.py next",
        "on-click-right": "@HOME@/.config/prime/prime-context.sh bar.media",
        "on-click-middle": "@HOME@/.config/waybar/scripts/spotify-pill.py toggle"
    },
    "custom/spotify": {
        "exec": "@HOME@/.config/waybar/scripts/spotify-pill.py",
        "interval": 1,
        "return-type": "json",
        "tooltip": true,
        "on-click": "@HOME@/.config/waybar/scripts/spotify-pill.py toggle",
        "on-click-right": "@HOME@/.config/prime/prime-context.sh bar.media",
        "on-click-middle": "@HOME@/.config/waybar/scripts/spotify-pill.py prev",
        "on-scroll-up": "@HOME@/.config/waybar/scripts/spotify-pill.py volup",
        "on-scroll-down": "@HOME@/.config/waybar/scripts/spotify-pill.py voldown"
    },
    "custom/spotifySkip": {
        "format": "⏭",
        "tooltip": false,
        "on-click": "@HOME@/.config/waybar/scripts/spotify-pill.py next",
        "on-click-right": "@HOME@/.config/waybar/scripts/spotify-pill.py prev",
        "on-click-middle": "@HOME@/.config/waybar/scripts/spotify-pill.py toggle"
    },
    "custom/audio": {
        "exec": "~/.config/waybar/scripts/audio-pill.sh",
        "return-type": "json",
        "interval": 1,
        "signal": 8,
        "on-click": "pavucontrol",
        "on-click-right": "@HOME@/.config/prime/prime-context.sh bar.audio",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "network": {
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤮",
        "tooltip-format": "{essid} · {signalStrength}% · {ipaddr}",
        "on-click": "nm-connection-editor",
        "on-click-right": "@HOME@/.config/prime/prime-context.sh bar.network"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-connected": "󰂱  {device_alias}",
        "tooltip-format": "{status} · {device_alias}",
        "on-click": "blueman-manager",
        "on-click-right": "@HOME@/.config/prime/prime-context.sh bar.bluetooth"
    },
    "cpu": {
        "format": "󰻠  {usage}%",
        "interval": 3,
        "states": {
            "warning": 70,
            "critical": 90
        },
        "tooltip-format": "CPU: {usage}%  Load: {load}",
        "on-click": "konsole -e btop",
        "on-click-right": "@HOME@/.config/prime/prime-context.sh bar.cpu"
    },
    "memory": {
        "format": "󰍛  {percentage}%",
        "interval": 3,
        "states": {
            "warning": 75,
            "critical": 90
        },
        "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G  ({percentage}%)",
        "on-click": "konsole -e btop",
        "on-click-right": "@HOME@/.config/prime/prime-context.sh bar.memory"
    },
    "custom/gpu": {
        "exec": "~/.config/waybar/scripts/gpu-monitor.sh",
        "return-type": "json",
        "interval": 2,
        "format": "󰢮  {}",
        "on-click": "konsole -e btop",
        "on-click-right": "@HOME@/.config/prime/prime-context.sh bar.gpu"
    },
    "custom/updates": {
        "exec": "@HOME@/.config/waybar/scripts/updates-count.sh",
        "return-type": "json",
        "interval": 60,
        "escape": true,
        "tooltip": true,
        "format": "󰚰  {}",
        "tooltip-format": "{} updates available · click to update · right-click for package manager",
        "on-click": "kitty --class floating -e bash -c 'paru -Syu; read -p \"Press enter to close\"'",
        "on-click-right": "@HOME@/.config/prime/prime-context.sh bar.updates"
    },
    "custom/wallpaper": {
        "format": "<span color='#a1a1a6'>󰸉</span>",
        "on-click": "bash @HOME@/.config/hypr/scripts/wallpaper-switcher.sh",
        "tooltip-format": "Switch Wallpaper",
        "on-click-right": "@HOME@/.config/prime/prime-context.sh bar.wallpaper"
    },
    "custom/primeVoice": {
        "exec": "@HOME@/.config/waybar/scripts/prime-voice.sh",
        "interval": 1,
        "return-type": "json",
        "tooltip": true,
        "on-click-right": "@HOME@/.config/prime/prime-context.sh bar.primeVoice"
    },
    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "<span foreground='#fbbf24'>󰂚</span>",
            "none": "<span foreground='#a1a1aa'>󰂜</span>",
            "dnd-notification": "<span foreground='#fbbf24'>󰂛</span>",
            "dnd-none": "<span foreground='#a1a1aa'>󰂛</span>",
            "inhibited-notification": "<span foreground='#fbbf24'>󰂚</span>",
            "inhibited-none": "<span foreground='#a1a1aa'>󰂜</span>",
            "dnd-inhibited-notification": "<span foreground='#fbbf24'>󰂛</span>",
            "dnd-inhibited-none": "<span foreground='#a1a1aa'>󰂛</span>"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "@HOME@/.config/prime/prime-context.sh bar.notification",
        "escape": true
    },
    "custom/power": {
        "format": "⏻",
        "on-click": "bash @HOME@/.config/waybar/scripts/power-menu.sh",
        "tooltip": false,
        "on-click-right": "@HOME@/.config/prime/prime-context.sh bar.power"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "<span color='#fbbf24'>☕</span>",
            "deactivated": "<span color='#a1a1aa'>󰒲</span>"
        },
        "tooltip": true,
        "tooltip-format-activated": "Caffeinated (Screen stays on)",
        "tooltip-format-deactivated": "Decaf (Normal screen behavior)"
    }
}
