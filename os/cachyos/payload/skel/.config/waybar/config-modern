{
    "layer": "top",
    "position": "bottom",
    "height": 52,
    "margin-bottom": 10,
    "margin-left": 20,
    "margin-right": 20,
    "spacing": 8,

    "modules-left": [
        "custom/launcher",
        "wlr/taskbar"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "pulseaudio",
        "network",
        "cpu",
        "memory",
        "custom/vram",
        "custom/updates",
        "custom/software",
        "tray",
        "clock"
    ],

    "custom/launcher": {
        "format": "󰣇",
        "on-click": "@HOME@/.config/hypr/scripts/launcher.sh",
        "tooltip": false
    },

    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 26,
        "spacing": 10,
        "on-click": "activate",
        "on-click-middle": "close",
        "all-outputs": true,
        "ignore-list": ["kitty"],
        "rewrite": {
            "Code - OSS": "Visual Studio Code"
        }
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "1": "",
            "2": "󰲋",
            "3": "󰊗",
            "8": "󰋙",
            "default": ""
        }
    },

    "cpu": {
        "format": "󰻠 {usage}%",
        "on-click": "kitty --class btop -e btm"
    },

    "memory": {
        "format": "󰍛 {percentage}%",
        "on-click": "kitty --class btop -e btm"
    },

    "custom/vram": {
        "exec": "~/.config/hypr/scripts/vram_monitor.sh",
        "interval": 2,
        "format": "󰘚 {}",
        "on-click": "kitty --class btop -e btm"
    },

    "custom/updates": {
        "exec": "~/.config/ml4w/scripts/ml4w-check-system-updates",
        "interval": 3600,
        "format": "󰚰 Updates",
        "return-type": "json",
        "on-click": "kitty --class dotfiles-floating -e paru -Syu",
        "tooltip": true
    },

    "custom/software": {
        "format": " CachyOS",
        "on-click": "cachyos-pi",
        "tooltip": "Launch CachyOS Package Manager"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 10
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol"
    },

    "network": {
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤮",
        "on-click": "nm-connection-editor"
    },

    "clock": {
        "format": "󱑒 {:%I:%M %p}",
        "tooltip-format": "{:%A, %B %d, %Y}"
    }
}
