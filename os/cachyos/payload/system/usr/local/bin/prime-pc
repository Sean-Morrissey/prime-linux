#!/usr/bin/env bash
# prime-pc — the machine supervisor for this desktop.
#
# Five verbs, in this order, for anything risky:
#   check        is there something new, and what changed
#   snapshot     leave the previous state reachable
#   apply        take the update
#   health       did the machine come up sane afterwards
#   rollbacks    what points can we go back to, in plain language
#
# It refuses to change this machine unless PRIME_ALLOW_REAL_SYSTEM_CHANGES=yes,
# which the installed systemd unit sets. Run by hand, apply/cycle refuse — that
# is deliberate, so no stray agent invocation can upgrade a machine.
#
# Read-only verbs (status, check, gates, health, rollbacks, log) always work.
#
# Usage: prime-pc {status|check|gates|snapshot [label]|apply|cycle|health|
#                  rollbacks|boot-entry [N]|boot-entry-prune|log|pause|resume|
#                  reboot-needed|selftest}

set -uo pipefail

CONF="${PRIME_PC_CONF:-/etc/prime-pc/prime-pc.conf}"

# ------------------------------------------------------------------ defaults
CAPABILITY="suggest"
MIN_FREE_GB=15
MAX_LOAD_FACTOR=1.0
SNAPSHOT_BEFORE="yes"
AUR="yes"
AUR_TIMEOUT_MIN=30
NOTIFY_LEDGER="yes"
REBOOT_NUDGE_HOURS=24
SNAP_CONFIG="root"
SNAP_NUMBER_LIMIT=50
ROLLBACK_ENTRIES=1       # how many 'Prime rollback' lines the boot menu may show

# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF"

STATE_DIR="${PRIME_PC_STATE:-/var/lib/prime-pc}"
AUDIT="$STATE_DIR/audit.jsonl"
LASTRUN="$STATE_DIR/last-run.json"
PAUSED="$STATE_DIR/PAUSED"
PRIME_USER_HOME=@HOME@
LEDGER_NOTE="$PRIME_USER_HOME/.hermes/scripts/ledger-note.sh"
HIST_DIR=/var/log/prime-pc
HIST="$HIST_DIR/history.log"

if [ -t 1 ]; then
  c_ok=$'\e[32m'; c_warn=$'\e[33m'; c_bad=$'\e[31m'; c_dim=$'\e[2m'; c_reset=$'\e[0m'
else
  c_ok=; c_warn=; c_bad=; c_dim=; c_reset=
fi
say() { printf '%s\n' "$*"; }
ok()  { printf '%s✓%s %s\n' "$c_ok" "$c_reset" "$*"; }
warn(){ printf '%s!%s %s\n' "$c_warn" "$c_reset" "$*"; }
bad() { printf '%s✗%s %s\n' "$c_bad" "$c_reset" "$*"; }
dim() { printf '%s  %s%s\n' "$c_dim" "$*" "$c_reset"; }
hr()  { printf '%s\n' "────────────────────────────────────────────────────────"; }

hist()  { mkdir -p "$HIST_DIR"; printf '%s | %s\n' "$(date '+%F %T')" "$*" >>"$HIST"; }
audit() { mkdir -p "$STATE_DIR"; printf '{"ts":"%s","event":"%s","detail":"%s"}\n' \
            "$(date -u +%FT%TZ)" "$1" "$(printf '%s' "${2:-}" | tr -d '"' | tr '\n' ' ')" >>"$AUDIT"; }
need_root() { [ "$(id -u)" = "0" ] || { bad "this verb needs root"; exit 4; }; }
real_guard() {
  [ "${PRIME_ALLOW_REAL_SYSTEM_CHANGES:-no}" = "yes" ] || {
    bad "not allowed to change this machine"
    dim "PRIME_ALLOW_REAL_SYSTEM_CHANGES=yes is set by the installed unit, on purpose"
    dim "read-only verbs (status, check, gates, health, rollbacks) still work"
    exit 3
  }
}
u() { runuser -u @USER@ -- "$@"; }

# ------------------------------------------------------------------ machine facts
fs_type()      { findmnt -no FSTYPE / 2>/dev/null; }
fs_uuid()      { findmnt -no UUID / 2>/dev/null; }
root_subvol()  { findmnt -no OPTIONS / | sed -n 's/.*subvol=\([^,]*\).*/\1/p'; }
bootloader() {
  if [ -e /boot/limine.conf ]; then echo limine
  elif [ -d /boot/grub ] && [ -f /boot/grub/grub.cfg ] && [ -d /boot/loader/entries ]; then echo "systemd-boot (+grub leftovers)"
  elif [ -d /boot/loader/entries ]; then echo systemd-boot
  elif [ -d /boot/grub ]; then echo grub
  else echo unknown; fi
}
boot_is_esp()  { [ "$(findmnt -no FSTYPE /boot 2>/dev/null)" = "vfat" ] && echo yes || echo no; }
kernel_img()   { ls -1 /boot/vmlinuz-* 2>/dev/null | head -1; }
initrd_img()   { ls -1 /boot/initramfs-*.img 2>/dev/null | head -1; }
boot_epoch()   { date -d "$(uptime -s)" +%s 2>/dev/null || echo 0; }
pending_list() { checkupdates 2>/dev/null; }
pending_count(){ pending_list | wc -l | tr -d ' '; }
free_gb()      { df -BG --output=avail / | tail -1 | tr -dc '0-9'; }
load1()        { cut -d' ' -f1 /proc/loadavg; }
load_ok()      { awk -v l="$(load1)" -v n="$(nproc)" -v f="$MAX_LOAD_FACTOR" \
                   'BEGIN{exit !(l <= n*f)}' && echo yes || echo no; }

snap_last()    { snapper -c "$SNAP_CONFIG" list --columns number,date,description 2>/dev/null \
                   | awk -F'|' '$1+0>0{n=$1; d=$2; c=$3} END{if(n)print n}' ; }
snap_count()   { snapper -c "$SNAP_CONFIG" list --columns number 2>/dev/null | awk '$1+0>0' | wc -l | tr -d ' '; }
snap_path()    { echo "/.snapshots/$1/snapshot"; }

printing() {
  local j; j="$(curl -s -m 4 http://localhost:8088/api/status 2>/dev/null)"
  case "$j" in
    *'"status"'*'"printing"'*|*'"printing"'*) echo yes ;;
    *) echo no ;;
  esac
}

reboot_needed() {
  # (1) A kernel or initramfs on disk that this boot did not come from.
  local be f
  be="$(boot_epoch)"
  for f in $(kernel_img) $(initrd_img); do
    [ -e "$f" ] || continue
    if [ "$(stat -c %Y "$f")" -gt "$be" ]; then echo yes; return; fi
  done
  # (2) Core packages upgraded *since this boot* also want a fresh boot; ones
  # upgraded before it are already running and must not nag him forever.
  local boot_iso core_hit
  boot_iso="$(date -d "@$be" '+%Y-%m-%dT%H:%M:%S%z')"
  core_hit="$(awk -v boot="$boot_iso" '
    /\[PACMAN\] transaction started/   { in_tx=1; hit=0; next }
    /\[PACMAN\] transaction completed/ {
      ts=$1; gsub(/[\[\]]/,"",ts)
      if (ts > boot && hit) last=1
      in_tx=0; next
    }
    in_tx && ($3=="upgraded" || $3=="installed") &&
      $4 ~ /^(systemd|systemd-libs|glibc|lib32-glibc|linux-cachyos|linux-cachyos-lts|linux-firmware|mesa|lib32-mesa|libdrm)$/ { hit=1 }
    END { print (last ? "yes" : "no") }
  ' /var/log/pacman.log 2>/dev/null)"
  [ "$core_hit" = "yes" ] && { echo maybe; return; }
  echo no
}

# ------------------------------------------------------------------ gates
gates() {
  local blocked=0
  hr; say "Gates — what has to be true before this machine gets updated"
  hr
  if [ -e "$PAUSED" ]; then bad "paused by hand ($PAUSED exists)"; blocked=1
  else ok "not paused"; fi

  if [ -e /var/lib/pacman/db.lck ] || pgrep -x pacman >/dev/null || pgrep -x paru >/dev/null; then
    bad "another package manager is running"; blocked=1
  else ok "no other package manager running"; fi

  local fg; fg="$(free_gb)"
  if [ "${fg:-0}" -lt "$MIN_FREE_GB" ]; then bad "only ${fg}G free on / (need ${MIN_FREE_GB}G)"; blocked=1
  else ok "${fg}G free on / (need ${MIN_FREE_GB}G)"; fi

  if [ "$(load_ok)" = "yes" ]; then ok "load $(load1) is fine for $(nproc) cores"
  else bad "machine is busy (load $(load1) over $(nproc) cores)"; blocked=1; fi

  if [ "$(fs_type)" = btrfs ]; then ok "root is btrfs — snapshots available"
  else warn "root is $(fs_type) — no snapshot, no rollback"; fi

  if [ "$(printing)" = "yes" ]; then
    warn "a 3D print is running — updates are safe, the reboot nudge waits for it"
  else ok "no print running"; fi

  hr
  [ "$blocked" = 0 ] && { ok "cleared to update"; return 0; }
  bad "not updating right now"; return 1
}

# ------------------------------------------------------------------ snapshot
snapshot() {
  real_guard; need_root
  local label="${1:-pre-update}"
  local n
  n="$(snapper -c "$SNAP_CONFIG" create --description "prime-pc: $label $(date '+%F %H:%M')" --print-number 2>/dev/null)"
  [ -n "$n" ] || { bad "snapper could not create a snapshot"; audit snapshot failed "$label"; return 1; }
  audit snapshot ok "$label → $n"
  hist "rollback point $n created ($label)"
  printf '%s\n' "$n"
}

boot_entry() {   # boot_entry <snapshot-number>
  real_guard; need_root
  local n="${1:-}"; [ -n "$n" ] || { bad "boot-entry needs a snapshot number"; return 1; }
  local ents=/boot/loader/entries; local out="$ents/prime-rollback-$n.conf"
  [ -d "$ents" ] || { bad "no systemd-boot entries dir; rollback entry not written"; return 1; }
  [ -d "/.snapshots/$n/snapshot" ] || { bad "snapshot $n has no /snapshot tree"; return 1; }
  local uuid sub k i extra
  uuid="$(fs_uuid)"; sub="$(root_subvol)"
  k="$(kernel_img)"; k="/$(basename "$k")"
  i="$(initrd_img)"; i="/$(basename "$i")"
  # keep every kernel option from the working entry, replace only the subvolume
  extra="$(sed -n 's/^options //p' "$ents"/linux-cachyos.conf 2>/dev/null \
            | sed -e "s#rootflags=subvol=[^ ]*#rootflags=subvol=${sub}/.snapshots/${n}/snapshot#" \
                  -e "s#initrd=[^ ]*##g" | tr -s ' ')"
  {
    printf 'title Prime rollback — %s (snapshot %s)\n' "$(date '+%F %H:%M')" "$n"
    printf 'sort-key prime-rollback\n'
    printf 'linux %s\n' "$k"
    printf 'initrd %s\n' "$i"
    printf 'options %s\n' "$extra"
  } >"$out" || { bad "could not write $out"; return 1; }
  audit boot-entry ok "snapshot $n → $out"
  ok "bootable rollback entry written: $out"
  dim "pick it in the boot menu ('Prime rollback'), or press nothing — the default is unchanged"
  printf '%s\n' "$out"
}

boot_entry_prune() {
  real_guard; need_root
  local p n removed=0 keep stale
  keep="${ROLLBACK_ENTRIES:-1}"
  case "$keep" in ''|*[!0-9]*) keep=1 ;; esac
  # 1) an entry whose snapshot snapper already cleaned can never boot — drop it
  for p in /boot/loader/entries/prime-rollback-*.conf; do
    [ -e "$p" ] || continue
    n="$(basename "$p" | sed -e 's/prime-rollback-//' -e 's/\.conf//')"
    if [ ! -d "/.snapshots/$n/snapshot" ]; then rm -f "$p"; removed=$((removed+1)); fi
  done
  # 2) keep only the newest $keep, so the boot menu stays a couple of lines long
  #    instead of one line per nightly run. The older snapshots are still in
  #    snapper; put one back in the menu with 'prime-pc boot-entry <N>' if the
  #    newest rollback is not enough to get the machine back.
  stale="$(ls -1 /boot/loader/entries/prime-rollback-*.conf 2>/dev/null \
             | sed -e 's#.*/prime-rollback-##' -e 's/\.conf$//' | sort -n -r \
             | tail -n +$((keep+1)))"
  for n in $stale; do
    rm -f "/boot/loader/entries/prime-rollback-$n.conf" && removed=$((removed+1))
  done
  ok "pruned $removed rollback entr(y/ies); $keep newest kept in the boot menu"
  audit boot-entry-prune "$removed removed (keep=$keep)"
}

# ------------------------------------------------------------------ apply
apply_repo() {
  real_guard; need_root
  local before after out
  before="$(pending_count)"
  hist "repo update starting ($before pending)"
  audit apply-repo start "$before pending"
  out="$(pacman -Syu --noconfirm --noprogressbar 2>&1)"; local rc=$?
  printf '%s\n' "$out" | tail -25
  after="$(pending_count)"
  printf '%s\n' "$out" >"$STATE_DIR/last-pacman.log"
  if [ $rc -ne 0 ]; then
    bad "pacman exited $rc — see $STATE_DIR/last-pacman.log"
    hist "repo update FAILED (rc=$rc)"
    audit apply-repo fail "rc=$rc"
    return 1
  fi
  ok "repo update done ($before → $after pending)"
  hist "repo update ok ($before → $after pending)"
  audit apply-repo ok "$before → $after"
  return 0
}

apply_aur() {
  real_guard; need_root
  [ "$AUR" = "yes" ] || { dim "AUR updates disabled in $CONF"; return 0; }
  [ -x /usr/bin/paru ] || { warn "paru not installed — skipping AUR"; return 0; }
  hist "AUR update starting"
  local out rc
  out="$(timeout $((AUR_TIMEOUT_MIN*60)) runuser -u @USER@ -- \
          env HOME="$PRIME_USER_HOME" TERM=dumb paru -Sua --noconfirm --noprogressbar 2>&1)"; rc=$?
  printf '%s\n' "$out" | tail -15
  printf '%s\n' "$out" >"$STATE_DIR/last-paru.log"
  if [ $rc -ne 0 ]; then
    warn "AUR pass exited $rc (build prompt, failure, or timeout) — repos are still updated"
    hist "AUR update reported rc=$rc"
    audit apply-aur warn "rc=$rc"
    return 1
  fi
  ok "AUR update done"
  hist "AUR update ok"
  audit apply-aur ok "-"
  return 0
}

# ------------------------------------------------------------------ health
health() {
  local fails=0
  hr; say "Health — what a person would notice"
  hr
  local sfu; sfu="$(systemctl --failed --no-legend --plain 2>/dev/null | grep -c . || true)"
  sfu="${sfu:-0}"
  if [ "$sfu" -eq 0 ]; then ok "no failed system units"; else bad "$sfu failed system unit(s)"; systemctl --failed --no-legend --plain | head -5 | sed 's/^/    /'; fails=$((fails+1)); fi

  local ufu; ufu="$(runuser -u @USER@ -- env XDG_RUNTIME_DIR=/run/user/1000 systemctl --user --failed --no-legend --plain 2>/dev/null | grep -c . || true)"
  ufu="${ufu:-0}"
  if [ "$ufu" -eq 0 ]; then ok "no failed user units"; else warn "$ufu failed user unit(s)"; fails=$((fails+1)); fi

  if pgrep -u @USER@ -x Hyprland >/dev/null; then ok "desktop session is running"; else bad "no Hyprland session for @USER@"; fails=$((fails+1)); fi

  if ping -c1 -W3 1.1.1.1 >/dev/null 2>&1; then ok "network is up"; else bad "no network"; fails=$((fails+1)); fi
  if getent hosts archlinux.org >/dev/null 2>&1; then ok "DNS resolves"; else bad "DNS broken"; fails=$((fails+1)); fi

  local sinks; sinks="$(runuser -u @USER@ -- env XDG_RUNTIME_DIR=/run/user/1000 pactl list short sinks 2>/dev/null | grep -c . || true)"
  sinks="${sinks:-0}"
  if [ "$sinks" -gt 0 ]; then ok "audio sink present ($sinks)"; else warn "no audio sink found"; fails=$((fails+1)); fi

  local fg; fg="$(free_gb)"
  if [ "${fg:-0}" -ge 10 ]; then ok "${fg}G free on /"; else warn "only ${fg}G free on /"; fails=$((fails+1)); fi

  local pn; pn="$(find /etc -name '*.pacnew' 2>/dev/null | wc -l | tr -d ' ')"
  if [ "$pn" -eq 0 ]; then ok "no .pacnew files waiting"; else warn "$pn .pacnew file(s) to review later (not urgent)"; fi

  local hb; hb="$PRIME_USER_HOME/.hermes/cron/ticker_heartbeat"
  if [ -e "$hb" ] && [ $(( $(date +%s) - $(stat -c %Y "$hb") )) -lt 900 ]; then
    ok "Hermes heartbeat is fresh"
  else warn "Hermes heartbeat looks stale — the assistant may be down"; fi

  case "$(reboot_needed)" in
    yes)   warn "a reboot is needed (new kernel/initramfs on disk)"; SANE_REBOOT=yes ;;
    maybe) warn "an upgraded core package wants a fresh boot eventually"; SANE_REBOOT=maybe ;;
    *)     ok "no reboot required by what changed" ;;
  esac
  hr
  [ "$fails" -eq 0 ] && { ok "healthy"; return 0; }
  warn "$fails check(s) need a look"; return 1
}

# ------------------------------------------------------------------ notice
write_lastrun() {
  local ok_="$1" applied="$2" aur="$3" snap="$4" healthfails="$5" summary="$6"
  mkdir -p "$STATE_DIR"
  # Values travel as environment, never interpolated into the source: a summary
  # with a quote or a backslash in it must not be able to break the file.
  PRIME_OK="$ok_" PRIME_APPLIED="$applied" PRIME_AUR="$aur" PRIME_SNAP="$snap" \
  PRIME_HF="$healthfails" PRIME_REBOOT="$(reboot_needed)" PRIME_SUMMARY="$summary" \
  python3 - "$LASTRUN" <<'PY'
import datetime, json, os, sys
json.dump({
  "ts": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
  "cycle_ok": os.environ["PRIME_OK"].strip().lower() in ("true", "1", "yes"),
  "applied": int(os.environ.get("PRIME_APPLIED") or 0),
  "aur": os.environ.get("PRIME_AUR", ""),
  "snapshot": os.environ.get("PRIME_SNAP", ""),
  "health_fails": int(os.environ.get("PRIME_HF") or 0),
  "reboot_needed": os.environ.get("PRIME_REBOOT", ""),
  "summary": os.environ.get("PRIME_SUMMARY", ""),
}, open(sys.argv[1], "w"), indent=1)
PY
  chmod 644 "$LASTRUN"
}

notify_ledger() {   # short line to @USER@'s ledger → WhatsApp
  [ "$NOTIFY_LEDGER" = "yes" ] || return 0
  local msg="$1"
  [ -x "$LEDGER_NOTE" ] || { dim "no ledger bridge installed"; return 0; }
  # No -n: the entry is queued and @USER@'s own flush job (every 15 min) sends it.
  # Flushing from here would leave root-owned lock files in his cache and break
  # his later runs. HOME must be explicit — runuser keeps root's otherwise.
  runuser -u @USER@ -- env HOME="$PRIME_USER_HOME" "$LEDGER_NOTE" -t sys "$msg" >/dev/null 2>&1 \
    && ok "ledger updated (goes to WhatsApp)" || dim "ledger bridge failed (non-fatal)"
  audit ledger ok "$msg"
}

# ------------------------------------------------------------------ cycle
cycle() {
  real_guard; need_root
  local snap_id="" applies=0 applied="" aur="skipped" hf=0 summary
  mkdir -p "$STATE_DIR"
  hist "cycle starting (capability=$CAPABILITY)"
  audit cycle start "$CAPABILITY"

  if ! gates >/dev/null 2>&1; then
    local why; why="$(gates 2>&1 | grep '✗' | head -3 | sed 's/^✗ //' | tr '\n' '; ')"
    hist "cycle skipped: $why"
    audit cycle skip "$why"
    [ "$CAPABILITY" = "suggest" ] || notify_ledger "Update check skipped: $why"
    return 0
  fi

  applies="$(pending_count)"
  if [ "$applies" -eq 0 ]; then
    hist "cycle: nothing to install"
    audit cycle noop "nothing pending"
    return 0
  fi

  if [ "$CAPABILITY" = "suggest" ]; then
    hist "cycle: $applies update(s) pending, suggest mode — reporting only"
    audit cycle suggest "$applies pending"
    notify_ledger "$applies update(s) ready (pacman/paru). Say 'go' or set CAPABILITY=auto-user in /etc/prime-pc/prime-pc.conf and I'll take them on the next nightly window."
    return 0
  fi

  if [ "$SNAPSHOT_BEFORE" = "yes" ]; then
    snap_id="$(snapshot pre-update)" || { notify_ledger "Refused to update: could not create a rollback snapshot. Nothing changed."; return 1; }
  fi

  apply_repo; local rrc=$?
  if [ $rrc -ne 0 ]; then
    write_lastrun False "$applies" "skipped" "${snap_id:-none}" 1 "Repo update failed; snapshot ${snap_id:-none} is your rollback point."
    notify_ledger "Update FAILED mid-way (pacman rc=$rrc). Rollback point: snapshot ${snap_id:-none}. Nothing was forced; I'll retry next window."
    return 1
  fi
  apply_aur; local arc=$?
  [ $arc -eq 0 ] && aur="ok" || aur="problem (rc=$arc)"

  health >/dev/null 2>&1 || hf=1
  [ -n "${snap_id:-}" ] && boot_entry "$snap_id" >/dev/null 2>&1
  boot_entry_prune >/dev/null 2>&1

  local after; after="$(pending_count)"
  summary="Updated $applies package(s), $after still reported pending. AUR: $aur."
  case "$(reboot_needed)" in
    yes)   summary="$summary Reboot when convenient — new kernel on disk." ;;
    maybe) summary="$summary Reboot when you get a minute — core packages changed." ;;
  esac
  [ -n "${snap_id:-}" ] && summary="$summary Rollback point: snapshot $snap_id (bootable as 'Prime rollback')."
  write_lastrun True "$applies" "$aur" "${snap_id:-none}" "$hf" "$summary"
  hist "cycle done: $summary"
  audit cycle ok "$summary"
  notify_ledger "$summary"
  ok "$summary"
}

# ------------------------------------------------------------------ verbs
cmd="${1:-status}"; shift 2>/dev/null || true

case "$cmd" in
  status)
    hr; say "prime-pc — status"; hr
    say "  machine:      $(uname -sr)"
    say "  root fs:      $(fs_type) on $(findmnt -no SOURCE /) (subvol $(root_subvol))"
    say "  bootloader:   $(bootloader)  (ESP at /boot: $(boot_is_esp))"
    say "  capability:   $CAPABILITY"
    say "  snapshots:    $(snap_count) in snapper config '$SNAP_CONFIG'"
    say "  updates:      $(pending_count) pending"
    say "  last cycle:   $([ -e "$LASTRUN" ] && python3 -c "import json;d=json.load(open('$LASTRUN'));print(d['ts'], '|', d['summary'][:90])" 2>/dev/null || echo 'never')"
    say "  reboot:       $(reboot_needed)"
    say "  config:       $CONF"
    say "  history:      $HIST"
    say "  audit:        $AUDIT"
    hr
    ;;
  check)      hr; say "Pending updates ($(pending_count))"; hr; pending_list | sed 's/^/  /'; hr ;;
  gates)      gates ;;
  snapshot)   snapshot "${1:-manual}" ;;
  health)     health ;;
  apply)
    real_guard; need_root
    warn "apply = repo upgrade + AUR pass, right now, unattended-style"
    snapshot pre-update >/dev/null && ok "rollback point taken"
    apply_repo; apply_aur ;;
  cycle)      cycle ;;
  rollbacks)
    hr; say "Rollback points"; hr
    snapper -c "$SNAP_CONFIG" list --columns number,date,description,cleanup 2>/dev/null | sed 's/^/  /'
    hr; say "Bootable entries in the boot menu:"; ls -1 /boot/loader/entries/prime-rollback-*.conf 2>/dev/null | sed 's/^/  /' || dim "  (none yet)"
    dim "  keep=$ROLLBACK_ENTRIES — only the newest is shown; 'prime-pc boot-entry <N>' adds an older snapshot back"
    hr; say "To go back: reboot, pick 'Prime rollback — <date>' in the boot menu."
    dim "  Swap the root subvolume instead and you can lose data; booting the snapshot is the safe undo."
    ;;
  boot-entry) boot_entry "${1:-$(snap_last)}" ;;
  boot-entry-prune) boot_entry_prune ;;
  reboot-needed) reboot_needed ;;
  log)        hr; say "History — $HIST"; hr; tail -30 "$HIST" 2>/dev/null || dim "(empty)" ;;
  pause)      mkdir -p "$STATE_DIR"; : >"$PAUSED"; ok "paused — the timer will skip until 'prime-pc resume'"; audit pause ok "by hand" ;;
  resume)     rm -f "$PAUSED"; ok "resumed"; audit resume ok "by hand" ;;
  selftest)
    f=0
    hr; say "prime-pc selftest"; hr
    [ -r "$CONF" ] && ok "config readable: $CONF" || { warn "config missing, using defaults"; }
    for c in snapper btrfs checkupdates pacman runuser python3; do
      command -v "$c" >/dev/null && ok "$c present" || { bad "$c missing"; f=$((f+1)); }
    done
    [ "$(fs_type)" = btrfs ] && ok "btrfs root" || bad "root is not btrfs"
    [ -d /.snapshots ] && ok "/.snapshots exists" || bad "/.snapshots missing"
    snapper -c "$SNAP_CONFIG" list >/dev/null 2>&1 && ok "snapper config '$SNAP_CONFIG' works" || { bad "snapper config broken"; f=$((f+1)); }
    [ -d /boot/loader/entries ] && ok "systemd-boot entries writable dir present" || warn "no sd-boot entries dir"
    mkdir -p "$STATE_DIR" 2>/dev/null && [ -w "$STATE_DIR" ] && ok "state dir writable" || { bad "state dir not writable (need root)"; f=$((f+1)); }
    hr; [ "$f" -eq 0 ] && { ok "all good"; exit 0; } || { bad "$f problem(s)"; exit 1; }
    ;;
  ""|help|-h|--help)
    sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) bad "unknown verb: $cmd"; dim "try: status | check | gates | cycle | health | rollbacks | log"; exit 2 ;;
esac
